{
  "enabled": true,
  "name": "Code Quality Review on Save",
  "description": "Analyzes modified source code files for potential improvements when changes are detected. Reviews for code smells, design patterns, best practices, readability, maintainability, and performance optimizations while maintaining existing functionality.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "*.ts",
      "*.js",
      "*.tsx",
      "*.jsx",
      "*.java",
      "*.go",
      "*.rs",
      "*.cpp",
      "*.c",
      "*.h",
      "*.hpp"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified file for potential improvements. Focus on:\n\n1. Code smells (long methods, duplicated logic, magic numbers, deep nesting, etc.)\n2. Design pattern opportunities (where a pattern would simplify or clarify the code)\n3. Best practices violations for the language in use\n4. Readability improvements (naming, structure, comments)\n5. Maintainability concerns (tight coupling, missing abstractions, fragile logic)\n6. Performance optimizations (unnecessary allocations, inefficient loops, redundant computations)\n7. Security vulnerabilities (injection risks, unsafe deserialization, hardcoded secrets/credentials, improper input validation, path traversal, insecure use of eval/exec, missing authentication/authorization checks, sensitive data exposure)\n\nFor each finding, explain WHY it matters and suggest a concrete improvement. Do not suggest changes that alter existing functionality. Keep suggestions actionable and prioritized by impact."
  }
}