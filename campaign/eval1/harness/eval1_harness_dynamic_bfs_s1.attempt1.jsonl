     \"offline_timings\": offline_timings,\n\n  Line 167:                         \"partial_timings\": timings,\n\n  Line 168:                         \"partial_offline_timings\": offline_timings,\n\n  Line 253:     def execute_batch(\n\n  Line 257:         offline_src: str | None = None,\n\n  Line 268:             offline_src: source of the offline_compute baseline function\n\n  Line 278:             Each per-seq dict has: status, results, timings, offline_timings\n\n  Line 289:             \"offline_src\": offline_src or \"\",\n\n  Line 353:         offline_src: str | None = None,\n\n  Line 365:         batch_result = self.execute_batch(module_path, test_cases, offline_src, root)\n\n  Line 373:                     timings=seq_result.get(\"timings\"),\n\n  Line 374:                     offline_timings=seq_result.get(\"offline_timings\"),\n\n  Line 403:         timings: list[int] | None = None,\n\n  Line 404:         offline_timings: list[int] | None = None,\n\n  Line 410:         self.timings = timings\n\n  Line 411:         self.offline_timings = offline_timings\n","metadata":{"matches":40,"truncated":false},"title":"timings|time\\.|perf_counter|def execute_batch|offline","time":{"start":1792500460258,"end":1792500460331}},"id":"prt_1595a6669001dLKP1geFUlzCes","sessionID":"ses_ea6b00f17ffeff7dL3uZ3RUV3t","messageID":"msg_1595a55c9001MCUzWDGHn4rITu"}}
