{"type":"tool_use","timestamp":1792507127282,"sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b0e02488f3037c2d","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s2/candidate.py"},"output":"<path>/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s2/candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Dynamic BFS tree from a fixed root (vertex 0) under edge flips.\n2: \n3: State is a dict with two list fields, indexed by vertex:\n4:   parent[v]    - the BFS-tree parent of v (None for the root and for\n5:                  unreachable vertices)\n6:   distances[v] - the true BFS distance from the root (-1 if unreachable)\n7: \n8: Fast path: an update that cannot change the BFS tree returns immediately.\n9:   * insert (u, v): if u is unreachable, or dist[v] <= dist[u] + 1, the new\n10:     edge gives no shorter path, so nothing changes.\n11:   * delete (u, v): if (u, v) is not v's tree edge (parent[v] != u), no vertex\n12:     loses its tree path, so nothing changes.\n13: \n14: Slow path: only the affected region is recomputed, never the whole graph.\n15:   * insert that improves v: region = vertices reachable from v (their distance\n16:     can only drop through the new edge).\n17:   * delete of v's tree edge: region = the subtree of v (the only vertices\n18:     whose tree path used the deleted edge).\n19: \n20: The region is recomputed with a boundary-seeded Dijkstra: vertices outside the\n21: region keep their (unchanged) distances, and the new distance of a region\n22: vertex is the shortest path from the boundary into it. Because every out-\n23: neighbor of a reachable vertex is itself reachable, and a vertex's distance is\n24: set by its in-neighbors, this is exact for both regions.\n25: \"\"\"\n26: \n27: import heapq\n28: \n29: \n30: def init(graph):\n31:     n = len(graph)\n32:     parent, dist = _full_bfs(graph, n, 0)\n33:     return {\"parent\": parent, \"distances\": dist}\n34: \n35: \n36: def insert_edge(graph, edge, state):\n37:     u, v = edge\n38:     dist = state[\"distances\"]\n39:     parent = state[\"parent\"]\n40:     n = len(dist)\n41:     if dist[u] == -1:\n42:         return state  # u unreachable: no path root -> ... -> u -> v\n43:     if dist[v] != -1 and dist[v] <= dist[u] + 1:\n44:         return state  # new edge gives no shorter path to v\n45:     region = _reachable_from(graph, n, v)\n46:     region.discard(0)  # the root's distance is fixed at 0\n47:     _recompute(graph, n, region, dist, parent)\n48:     return state\n49: \n50: \n51: def delete_edge(graph, edge, state):\n52:     u, v = edge\n53:     parent = state[\"parent\"]\n54:     dist = state[\"distances\"]\n55:     n = len(dist)\n56:     if parent[v] != u:\n57:         return state  # (u, v) is not v's tree edge: no tree path is lost\n58:     region = _subtree_of(parent, n, v)\n59:     region.discard(0)\n60:     _recompute(graph, n, region, dist, parent)\n61:     return state\n62: \n63: \n64: def _full_bfs(graph, n, root):\n65:     parent = [None] * n\n66:     dist = [-1] * n\n67:     dist[root] = 0\n68:     q = [root]\n69:     i = 0\n70:     while i < len(q):\n71:         u = q[i]\n72:         i += 1\n73:         row = graph[u]\n74:         nd = dist[u] + 1\n75:         for v in range(n):\n76:             if row[v] == 1 and dist[v] == -1:\n77:                 dist[v] = nd\n78:                 parent[v] = u\n79:                 q.append(v)\n80:     return parent, dist\n81: \n82: \n83: def _reachable_from(graph, n, start):\n84:     \"\"\"All vertices reachable from start by following out-edges (incl. start).\"\"\"\n85:     seen = {start}\n86:     q = [start]\n87:     i = 0\n88:     while i < len(q):\n89:         u = q[i]\n90:         i += 1\n91:         row = graph[u]\n92:         for v in range(n):\n93:             if row[v] == 1 and v not in seen:\n94:                 seen.add(v)\n95:                 q.append(v)\n96:     return seen\n97: \n98: \n99: def _subtree_of(parent, n, v):\n100:     \"\"\"v and all its descendants in the tree, found by walking parent chains.\"\"\"\n101:     region = set()\n102:     for x in range(n):\n103:         cur = x\n104:         while cur is not None:\n105:             if cur == v:\n106:                 region.add(x)\n107:                 break\n108:             cur = parent[cur]\n109:     return region\n110: \n111: \n112: def _recompute(graph, n, region, dist, parent):\n113:     \"\"\"Recompute distances/parents for the vertices in region in place.\n114: \n115:     Vertices outside region keep their current (final) distances. The new\n116:     distance of a region vertex is the shortest path from the boundary (its\n117:     in-neighbors outside region) into it, so a Dijkstra seeded from the\n118:     boundary and relaxing only inside region is exact. The parent of each\n119:     region vertex is the predecessor that achieves its best distance, tracked\n120:     during the Dijkstra so no separate parent pass is needed.\n121:     \"\"\"\n122:     best = {}\n123:     par = {}\n124:     heap = []\n125:     for x in region:\n126:         b = None\n127:         for w in range(n):\n128:             if graph[w][x] == 1 and w not in region and dist[w] != -1:\n129:                 cand = dist[w] + 1\n130:                 if b is None or cand < b:\n131:                     b = cand\n132:                     pb = w\n133:         if b is not None:\n134:             best[x] = b\n135:             par[x] = pb\n136:             heapq.heappush(heap, (b, x))\n137: \n138:     final = {}\n139:     while heap:\n140:         d, w = heapq.heappop(heap)\n141:         if w in final:\n142:             continue\n143:         final[w] = d\n144:         row = graph[w]\n145:         for x in range(n):\n146:             if row[x] == 1 and x in region and x not in final:\n147:                 cand = d + 1\n148:                 if x not in best or cand < best[x]:\n149:                     best[x] = cand\n150:                     par[x] = w\n151:                     heapq.heappush(heap, (cand, x))\n152: \n153:     for x in region:\n154:         if x in final:\n155:             dist[x] = final[x]\n156:             parent[x] = par[x]\n157:         else:\n158:             dist[x] = -1\n159:             parent[x] = None\n\n(End of file - total 159 lines)\n</content>","metadata":{"preview":"\"\"\"Dynamic BFS tree from a fixed root (vertex 0) under edge flips.\n\nState is a dict with two list fields, indexed by vertex:\n  parent[v]    - the BFS-tree parent of v (None for the root and for\n                 unreachable vertices)\n  distances[v] - the true BFS distance from the root (-1 if unreachable)\n\nFast path: an update that cannot change the BFS tree returns immediately.\n  * insert (u, v): if u is unreachable, or dist[v] <= dist[u] + 1, the new\n    edge gives no shorter path, so nothing changes.\n  * delete (u, v): if (u, v) is not v's tree edge (parent[v] != u), no vertex\n    loses its tree path, so nothing changes.\n\nSlow path: only the affected region is recomputed, never the whole graph.\n  * insert that improves v: region = vertices reachable from v (their distance\n    can only drop through the new edge).\n  * delete of v's tree edge: region = the subtree of v (the only vertices\n    whose tree path used the deleted edge).\n\nThe region is recomputed with a boundary-seeded Dijkstra: vertices outside the","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s2/candidate.py","text":"\"\"\"Dynamic BFS tree from a fixed root (vertex 0) under edge flips.\n\nState is a dict with two list fields, indexed by vertex:\n  parent[v]    - the BFS-tree parent of v (None for the root and for\n                 unreachable vertices)\n  distances[v] - the true BFS distance from the root (-1 if unreachable)\n\nFast path: an update that cannot change the BFS tree returns immediately.\n  * insert (u, v): if u is unreachable, or dist[v] <= dist[u] + 1, the new\n    edge gives no shorter path, so nothing changes.\n  * delete (u, v): if (u, v) is not v's tree edge (parent[v] != u), no vertex\n    loses its tree path, so nothing changes.\n\nSlow path: only the affected region is recomputed, never the whole graph.\n  * insert that improves v: region = vertices reachable from v (their distance\n    can only drop through the new edge).\n  * delete of v's tree edge: region = the subtree of v (the only vertices\n    whose tree path used the deleted edge).\n\nThe region is recomputed with a boundary-seeded Dijkstra: vertices outside the\nregion keep their (unchanged) distances, and the new distance of a region\nvertex is the shortest path from the boundary into it. Because every out-\nneighbor of a reachable vertex is itself reachable, and a vertex's distance is\nset by its in-neighbors, this is exact for both regions.\n\"\"\"\n\nimport heapq\n\n\ndef init(graph):\n    n = len(graph)\n    parent, dist = _full_bfs(graph, n, 0)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef insert_edge(graph, edge, state):\n    u, v = edge\n    dist = state[\"distances\"]\n    parent = state[\"parent\"]\n    n = len(dist)\n    if dist[u] == -1:\n        return state  # u unreachable: no path root -> ... -> u -> v\n    if dist[v] != -1 and dist[v] <= dist[u] + 1:\n        return state  # new edge gives no shorter path to v\n    region = _reachable_from(graph, n, v)\n    region.discard(0)  # the root's distance is fixed at 0\n    _recompute(graph, n, region, dist, parent)\n    return state\n\n\ndef delete_edge(graph, edge, state):\n    u, v = edge\n    parent = state[\"parent\"]\n    dist = state[\"distances\"]\n    n = len(dist)\n    if parent[v] != u:\n        return state  # (u, v) is not v's tree edge: no tree path is lost\n    region = _subtree_of(parent, n, v)\n    region.discard(0)\n    _recompute(graph, n, region, dist, parent)\n    return state\n\n\ndef _full_bfs(graph, n, root):\n    parent = [None] * n\n    dist = [-1] * n\n    dist[root] = 0\n    q = [root]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in range(n):\n            if row[v] == 1 and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return parent, dist\n\n\ndef _reachable_from(graph, n, start):\n    \"\"\"All vertices reachable from start by following out-edges (incl. start).\"\"\"\n    seen = {start}\n    q = [start]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        row = graph[u]\n        for v in range(n):\n            if row[v] == 1 and v not in seen:\n                seen.add(v)\n                q.append(v)\n    return seen\n\n\ndef _subtree_of(parent, n, v):\n    \"\"\"v and all its descendants in the tree, found by walking parent chains.\"\"\"\n    region = set()\n    for x in range(n):\n        cur = x\n        while cur is not None:\n            if cur == v:\n                region.add(x)\n                break\n            cur = parent[cur]\n    return region\n\n\ndef _recompute(graph, n, region, dist, parent):\n    \"\"\"Recompute distances/parents for the vertices in region in place.\n\n    Vertices outside region keep their current (final) distances. The new\n    distance of a region vertex is the shortest path from the boundary (its\n    in-neighbors outside region) into it, so a Dijkstra seeded from the\n    boundary and relaxing only inside region is exact. The parent of each\n    region vertex is the predecessor that achieves its best distance, tracked\n    during the Dijkstra so no separate parent pass is needed.\n    \"\"\"\n    best = {}\n    par = {}\n    heap = []\n    for x in region:\n        b = None\n        for w in range(n):\n            if graph[w][x] == 1 and w not in region and dist[w] != -1:\n                cand = dist[w] + 1\n                if b is None or cand < b:\n                    b = cand\n                    pb = w\n        if b is not None:\n            best[x] = b\n            par[x] = pb\n            heapq.heappush(heap, (b, x))\n\n    final = {}\n    while heap:\n        d, w = heapq.heappop(heap)\n        if w in final:\n            continue\n        final[w] = d\n        row = graph[w]\n        for x in range(n):\n            if row[x] == 1 and x in region and x not in final:\n                cand = d + 1\n                if x not in best or cand < best[x]:\n                    best[x] = cand\n                    par[x] = w\n                    heapq.heappush(heap, (cand, x))\n\n    for x in region:\n        if x in final:\n            dist[x] = final[x]\n            parent[x] = par[x]\n        else:\n            dist[x] = -1\n            parent[x] = None","lineStart":1,"lineEnd":159,"totalLines":159,"truncated":false}},"title":"runs/eval1_harness_dynamic_bfs_s2/candidate.py","time":{"start":1792507127240,"end":1792507127273}},"id":"prt_159c023c30016gIoecIgDWy2xw","sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","messageID":"msg_159bfa269001B8rZMo2sYKMUzb"}}
