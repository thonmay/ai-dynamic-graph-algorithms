{"type":"tool_use","timestamp":1792506642096,"sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b8347124449c7bf0","state":{"status":"completed","input":{"content":"import importlib.util, random, time, heapq\n\nspec = importlib.util.spec_from_file_location(\n    \"candidate\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s2/candidate.py\",\n)\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\n\n\ndef random_graph(n, p=0.4, rng=None):\n    rng = rng or random\n    return [[1 if rng.random() < p else 0 for _ in range(n)] for _ in range(n)]\n\n\ndef main():\n    rng = random.Random(0)\n    # time the three phases of _recompute separately on many slow-path ops\n    t_boundary = t_dijkstra = t_assign = 0.0\n    count = 0\n    for it in range(30000):\n        n = rng.randint(2, 5)\n        graph = random_graph(n, 0.4, rng)\n        state = mod.init(graph)\n        u = rng.randrange(n)\n        v = rng.randrange(n)\n        if u == v:\n            continue\n        if graph[u][v] == 1:\n            graph[u][v] = 0\n            if state[\"parent\"][v] == u:  # slow path\n                region = mod._subtree_of(state[\"parent\"], n, v)\n                region.discard(0)\n                dist, parent = state[\"distances\"], state[\"parent\"]\n                t0 = time.perf_counter_ns()\n                best = {}\n                par = {}\n                heap = []\n                for x in region:\n                    b = None\n                    for w in range(n):\n                        if graph[w][x] == 1 and w not in region and dist[w] != -1:\n                            cand = dist[w] + 1\n                            if b is None or cand < b:\n                                b = cand\n                                pb = w\n                    if b is not None:\n                        best[x] = b\n                        par[x] = pb\n                        heapq.heappush(heap, (b, x))\n                t1 = time.perf_counter_ns()\n                final = {}\n                while heap:\n                    d, w = heapq.heappop(heap)\n                    if w in final:\n                        continue\n                    final[w] = d\n                    row = graph[w]\n                    for x in range(n):\n                        if row[x] == 1 and x in region and x not in final:\n                            cand = d + 1\n                            if x not in best or cand < best[x]:\n                                best[x] = cand\n                                par[x] = w\n                                heapq.heappush(heap, (cand, x))\n                t2 = time.perf_counter_ns()\n                for x in region:\n                    if x in final:\n                        dist[x] = final[x]\n                        parent[x] = par[x]\n                    else:\n                        dist[x] = -1\n                        parent[x] = None\n                t3 = time.perf_counter_ns()\n                t_boundary += t1 - t0\n                t_dijkstra += t2 - t1\n                t_assign += t3 - t2\n                count += 1\n    print(f\"slow ops={count}\")\n    print(f\"boundary={t_boundary/1e6:.2f}ms dijkstra={t_dijkstra/1e6:.2f}ms assign={t_assign/1e6:.2f}ms\")\n    print(f\"per-op: boundary={t_boundary/count/1000:.1f}us dijkstra={t_dijkstra/count/1000:.1f}us assign={t_assign/count/1000:.1f}us\")\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/profile2.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/profile2.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/profile2.py","time":{"start":1792506642005,"end":1792506642087}},"id":"prt_159b89dfa001iN7eCW6tZ