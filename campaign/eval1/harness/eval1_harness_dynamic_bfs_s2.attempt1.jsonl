{"type":"tool_use","timestamp":1792506827488,"sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a4bea139afa8130a","state":{"status":"completed","input":{"content":"import random, time\nfrom collections import deque\n\n\ndef random_graph(n, p=0.4, rng=None):\n    rng = rng or random\n    return [[1 if rng.random() < p else 0 for _ in range(n)] for _ in range(n)]\n\n\ndef init_deque(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = deque([0])\n    while q:\n        u = q.popleft()\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in range(n):\n            if row[v] == 1 and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_listq(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = [0]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in range(n):\n            if row[v] == 1 and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_frontier(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    frontier = [0]\n    d = 0\n    while frontier:\n        d += 1\n        nxt = []\n        for u in frontier:\n            row = graph[u]\n            for v in range(n):\n                if row[v] == 1 and dist[v] == -1:\n                    dist[v] = d\n                    parent[v] = u\n                    nxt.append(v)\n        frontier = nxt\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef bench(fn, N=30000):\n    rng = random.Random(0)\n    graphs = []\n    for it in range(N):\n        n = rng.randint(2, 5)\n        graphs.append(random_graph(n, 0.4, rng))\n    t0 = time.perf_counter_ns()\n    for g in graphs:\n        fn(g)\n    dt = (time.perf_counter_ns() - t0) / 1e6\n    return dt / N * 1000\n\n\nif __name__ == \"__main__\":\n    for name, fn in [(\"deque\", init_deque), (\"listq\", init_listq), (\"frontier\", init_frontier)]:\n        print(f\"{name}: {bench(fn):.3f}us\")\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/bench_init2.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/bench_init2.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/bench_init2.py","time":{"start":1792506827447,"end":1792506827478}},"id":"prt_159bb7c83001GLQ64QWBDu3Dmr","sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","messageID":"msg_159baafb8001l67H6vB2y7CODG"}}
