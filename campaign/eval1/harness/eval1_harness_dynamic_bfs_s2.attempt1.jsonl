{"type":"tool_use","timestamp":1792506216110,"sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-987b519d7194da1a","state":{"status":"completed","input":{"content":"import importlib.util, random, itertools\nfrom collections import deque\n\nspec = importlib.util.spec_from_file_location(\n    \"candidate\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s2/candidate.py\",\n)\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\n\n\ndef oracle(graph, root=0):\n    n = len(graph)\n    parent = {root: None}\n    dist = {root: 0}\n    q = deque([root])\n    while q:\n        u = q.popleft()\n        for v in range(n):\n            if graph[u][v] == 1 and v not in dist:\n                dist[v] = dist[u] + 1\n                parent[v] = u\n                q.append(v)\n    return parent, dist\n\n\ndef tree_reachable(parent, root, n):\n    children = {}\n    for v, p in parent.items():\n        if p is not None and p != v:\n            children.setdefault(p, []).append(v)\n    reach = {root}\n    q = deque([root])\n    while q:\n        u = q.popleft()\n        for v in children.get(u, []):\n            if v not in reach:\n                reach.add(v)\n                q.append(v)\n    return reach\n\n\ndef check(graph, state, root=0):\n    n = len(graph)\n    parent = state[\"parent\"]\n    dist = state[\"distances\"]\n    # normalize to dict\n    if isinstance(parent, dict):\n        parent = {int(k): v for k, v in parent.items()}\n    else:\n        parent = {i: v for i, v in enumerate(parent)}\n    if isinstance(dist, dict):\n        dist = {int(k): (-1 if v is None else int(v)) for k, v in dist.items()}\n    else:\n        dist = {i: (-1 if x is None else int(x)) for i, x in enumerate(dist)}\n    # (1) parent is a true in-neighbor (or None)\n    for v in range(n):\n        if v == root:\n            if parent.get(v) is not None:\n                return False, f\"root has parent {parent.get(v)}\"\n            continue\n        p = parent.get(v)\n        if p is not None and p != v and graph[p][v] != 1:\n            return False, f\"parent {p} of {v} not a neighbor\"\n    od, op = oracle(graph, root)\n    reach = tree_reachable(parent, root, n)\n    for v in range(n):\n        if od.get(v, -1) != -1 and v not in reach:\n            return False, f\"reachable {v} not in tree\"\n        if od.get(v, -1) == -1 and parent.get(v) is not None:\n            return False, f\"unreachable {v} has parent\"\n    for v in range(n):\n        if v == root or v not in reach:\n            continue\n        p = parent.get(v)\n        if p is None:\n            return False, f\"reachable {v} has no parent\"\n        if od.get(v, -1) != od.get(p, -1) + 1:\n            return False, f\"dist property fails at {v}\"\n    for v in range(n):\n        if od.get(v, -1) == -1:\n            if dist.get(v, -1) != -1:\n                return False, f\"unreachable {v} reported dist {dist.get(v)}\"\n        elif dist.get(v, -1) != od[v]:\n            return False, f\"dist[{v}]={dist.get(v)} expected {od[v]}\"\n    return True, None\n\n\ndef random_graph(n, p=0.4, rng=None):\n    rng = rng or random\n    return [[1 if rng.random() < p else 0 for _ in range(n)] for _ in range(n)]\n\n\ndef run_one(n, seed, seq_len=30):\n    rng = random.Random(seed)\n    graph = random_graph(n, 0.4, rng)\n    state = mod.init(graph)\n    ok, msg = check(graph, state)\n    if not ok:\n        return f\"n={n} seed={seed} INIT FAIL: {msg}\"\n    for _ in range(seq_len):\n        u = rng.randrange(n)\n        v = rng.randrange(n)\n        if u == v:\n            continue\n        if graph[u][v] == 1:\n            graph[u][v] = 0\n            state = mod.delete_edge(graph, (u, v), state)\n        else:\n            graph[u][v] = 1\n            state = mod.insert_edge(graph, (u, v), state)\n        ok, msg = check(graph, state)\n        if not ok:\n            return f\"n={n} seed={seed} op=({u},{v}) FAIL: {msg}\"\n    return None\n\n\ndef main():\n    failures = 0\n    for n in range(2, 6):\n        for seed in range(400):\n            r = run_one(n, seed)\n            if r:\n                print(\"FAIL\", r)\n                failures += 1\n                if failures > 10:\n                    return\n    print(\"ALL PASS\" if failures == 0 else f\"{failures} FAILURES\")\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/sanity.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/sanity.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/sanity.py","time":{"start":1792506216082,"end":1792506216103}},"id":"prt_159b20154001v5QHhQY5joGnGP","sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","messageID":"msg_159b1f8ed001zMMzG672S8l4sk"}}
