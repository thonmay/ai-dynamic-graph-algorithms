{"type":"tool_use","timestamp":1792506925777,"sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8465a836f19acab6","state":{"status":"completed","input":{"content":"import random, time\n\n\ndef random_graph(n, p=0.4, rng=None):\n    rng = rng or random\n    return [[1 if rng.random() < p else 0 for _ in range(n)] for _ in range(n)]\n\n\ndef init_listq(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = [0]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in range(n):\n            if row[v] == 1 and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_listq_rangecache(graph):\n    n = len(graph)\n    rn = range(n)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = [0]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in rn:\n            if row[v] == 1 and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_frontier(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    frontier = [0]\n    d = 0\n    while frontier:\n        d += 1\n        nxt = []\n        for u in frontier:\n            row = graph[u]\n            for v in range(n):\n                if row[v] == 1 and dist[v] == -1:\n                    dist[v] = d\n                    parent[v] = u\n                    nxt.append(v)\n        frontier = nxt\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_frontier_rangecache(graph):\n    n = len(graph)\n    rn = range(n)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    frontier = [0]\n    d = 0\n    while frontier:\n        d += 1\n        nxt = []\n        for u in frontier:\n            row = graph[u]\n            for v in rn:\n                if row[v] == 1 and dist[v] == -1:\n                    dist[v] = d\n                    parent[v] = u\n                    nxt.append(v)\n        frontier = nxt\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef init_twolevel(graph):\n    # process level by level, but with a single queue and level markers\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = [0]\n    i = 0\n    level_end = 1\n    d = 0\n    while i < level_end:\n        d += 1\n        while i < level_end:\n            u = q[i]\n            i += 1\n            row = graph[u]\n            for v in range(n):\n                if row[v] == 1 and dist[v] == -1:\n                    dist[v] = d\n                    parent[v] = u\n                    q.append(v)\n        level_end = len(q)\n    return {\"parent\": parent, \"distances\": dist}\n\n\ndef bench(fn, N=40000):\n    rng = random.Random(0)\n    graphs = []\n    for it in range(N):\n        n = rng.randint(2, 5)\n        graphs.append(random_graph(n, 0.4, rng))\n    t0 = time.perf_counter_ns()\n    for g in graphs:\n        fn(g)\n    dt = (time.perf_counter_ns() - t0) / 1e6\n    return dt / N * 1000\n\n\nif __name__ == \"__main__\":\n    for name, fn in [\n        (\"listq\", init_listq),\n        (\"listq_rc\", init_listq_rangecache),\n        (\"frontier\", init_frontier),\n        (\"frontier_rc\", init_frontier_rangecache),\n        (\"twolevel\", init_twolevel),\n    ]:\n        print(f\"{name}: {bench(fn):.3f}us\")\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/bench_init3.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_bfs_s2/bench_init3.py","exists":false,"truncated"