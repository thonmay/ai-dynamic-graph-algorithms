voalgo/config.py\n/home/ethomdt/thesis/src/evoalgo/dashboard.py\n/home/ethomdt/thesis/src/evoalgo/graph_generator.py\n/home/ethomdt/thesis/src/evoalgo/llm_provider.py\n/home/ethomdt/thesis/src/evoalgo/orchestrator.py\n/home/ethomdt/thesis/src/evoalgo/population.py\n/home/ethomdt/thesis/src/evoalgo/problem_definitions.py\n/home/ethomdt/thesis/src/evoalgo/reflector.py\n/home/ethomdt/thesis/src/evoalgo/sandbox.py\n/home/ethomdt/thesis/src/evoalgo/verifier.py\n/home/ethomdt/thesis/src/evoalgo/formalize.py\n/home/ethomdt/thesis/src/evoalgo/events.py\n/home/ethomdt/thesis/src/evoalgo/server.py\n/home/ethomdt/thesis/src/evoalgo/selftest/__init__.py\n/home/ethomdt/thesis/src/evoalgo/selftest/references.py\n/home/ethomdt/thesis/src/evoalgo/selftest/faults.py\n/home/ethomdt/thesis/src/evoalgo/packs.py\n/home/ethomdt/thesis/src/evoalgo/agents/__init__.py\n/home/ethomdt/thesis/src/evoalgo/agents/examples.py\n/home/ethomdt/thesis/src/evoalgo/agents/base.py\n/home/ethomdt/thesis/src/evoalgo/agents/tools.py\n/home/ethomdt/thesis/src/evoalgo/agents/prompts/__init__.py\n/home/ethomdt/thesis/src/evoalgo/agents/api.py\n/home/ethomdt/thesis/src/evoalgo/agents/mock.py\n/home/ethomdt/thesis/src/evoalgo/agents/harness.py\n/home/ethomdt/thesis/src/evoalgo/workspace.py\n","exit":0,"truncated":false},"title":"find /home/ethomdt/thesis/src/evoalgo -name \"*.py\" | head -40","time":{"start":1792505387724,"end":1792505387737}},"id":"prt_159a59979001siLqDh4ZS0ey6U","sessionID":"ses_ea65b95a4ffeXJOPLCkUOttkq1","messageID":"msg_159a59296001QnBHnkQh6YR74E"}}
