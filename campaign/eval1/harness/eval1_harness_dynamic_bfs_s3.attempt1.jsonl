{"type":"tool_use","timestamp":1792509931854,"sessionID":"ses_ea6165c0bffec0GbYC1A6HUELg","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-95ac942e671c6649","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/src/evoalgo/verifier.py","limit":200},"output":"<path>/home/ethomdt/thesis/src/evoalgo/verifier.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Verifier and Evaluator: test candidates against invariants.\n2: \n3: The Verifier runs each candidate through the bounded test universe:\n4:   1. For each base graph in the test set\n5:   2. Generate operation sequences (insert/delete)\n6:   3. Execute candidate in sandbox (init + replay operations)\n7:   4. After each operation, check the invariant against the oracle\n8:   5. Record pass/fail, failing case, work counts\n9: \n10: The Evaluator computes fitness (fraction of sequences passing) and\n11: work_ratio (candidate_work / offline_work).\n12: \"\"\"\n13: \n14: from __future__ import annotations\n15: \n16: import concurrent.futures\n17: import logging\n18: import os\n19: import time\n20: from dataclasses import dataclass, field\n21: from pathlib import Path\n22: from typing import Any\n23: \n24: import numpy as np\n25: \n26: from .candidate import Candidate, CandidateState\n27: from .graph_generator import (\n28:     generate_test_graphs,\n29:     generate_operation_sequences,\n30: )\n31: from .problem_definitions import ProblemDefinition\n32: from .sandbox import Sandbox, SandboxResult\n33: \n34: # Default number of base graphs per sandbox subprocess. A chunk must finish\n35: # within the per-chunk timeout for a correct candidate, while a candidate that\n36: # loops forever on one case hits the timeout and fails fast. 2000 base graphs\n37: # is ~10-15 s for the slowest correct candidates (recompute-always BFS,\n38: # validate-or-rebuild DFS) at n<=5, well under a 30-60 s per-chunk timeout.\n39: #\n40: # When chunks are evaluated in parallel (workers > 1) the default chunk size is\n41: # halved (1000) so the work is split across more, smaller chunks: this balances\n42: # load across workers and keeps each chunk's wall time (and therefore its\n43: # per-chunk timeout) small, so a candidate that loops forever still fails fast.\n44: DEFAULT_CHUNK_SIZE = 2000\n45: DEFAULT_PARALLEL_CHUNK_SIZE = 1000\n46: \n47: \n48: def _default_workers() -> int:\n49:     \"\"\"Default worker count: modest on a shared build server (80 cores).\"\"\"\n50:     cpu = os.cpu_count() or 1\n51:     return max(1, min(8, cpu))\n52: \n53: logger = logging.getLogger(__name__)\n54: \n55: \n56: def _exhaustive_flip_sequences(\n57:     n: int,\n58:     graph: np.ndarray,\n59:     directed: bool,\n60:     include_twins: bool = False,\n61: ) -> list[list[tuple[str, tuple[int, int]]]]:\n62:     \"\"\"Deterministic short update sequences covering the update space.\n63: \n64:     Always returns all legal single-edge flips (each as a length-1 sequence):\n65:     this is \"every possible edge operation\" on the base graph. When\n66:     ``include_twins`` is True it additionally returns a compact set of length-2\n67:     paths (flip one edge, then flip each other edge).\n68: \n69:     The twins are O(n^4) per graph (380 at n=5) and are kept only for the small\n70:     labeled comparison universe, where they close the coverage hole left by\n71:     random sequences. For the nauty (non-isomorphic) universe the singles alone\n72:     already give exhaustive single-edge coverage, and the twins would make the\n73:     n=5 universe prohibitively expensive, so they default to off.\n74:     \"\"\"\n75:     pairs = [(u, v) for u in range(n) for v in range(n) if u != v and (directed or u < v)]\n76:     single: list[list[tuple[str, tuple[int, int]]]] = []\n77:     for u, v in pairs:\n78:         if graph[u, v]:\n79:             single.append([(\"delete\", (u, v))])\n80:         else:\n81:             single.append([(\"insert\", (u, v))])\n82:     if not include_twins:\n83:         return single\n84:     # length-2 paths: first flip (u,v), then flip (u',v') in the resulting graph\n85:     twins: list[list[tuple[str, tuple[int, int]]]] = []\n86:     for u, v in pairs:\n87:         flipped = graph.copy()\n88:         if flipped[u, v]:\n89:             flipped[u, v] = 0\n90:             if not directed:\n91:                 flipped[v, u] = 0\n92:             first: tuple[str, tuple[int, int]] = (\"delete\", (u, v))\n93:         else:\n94:             flipped[u, v] = 1\n95:             if not directed:\n96:                 flipped[v, u] = 1\n97:             first = (\"insert\", (u, v))\n98:         for u2, v2 in pairs:\n99:             if (u2, v2) == (u, v):\n100:                 continue\n101:             if flipped[u2, v2]:\n102:                 twins.append([first, (\"delete\", (u2, v2))])\n103:             else:\n104:                 twins.append([first, (\"insert\", (u2, v2))])\n105:     return single + twins\n106: \n107: \n108: @dataclass\n109: class VerifyResult:\n110:     \"\"\"Result of verifying one candidate.\"\"\"\n111: \n112:     candidate_id: str\n113:     state: CandidateState\n114:     fitness: float = 0.0\n115:     work_ratio: float | None = None\n116:     timeout: bool = False\n117:     tests_passed: int = 0\n118:     tests_total: int = 0\n119:     error_message: str | None = None\n120:     failing_case: dict[str, Any] | None = None\n121:     per_step_states: list[dict] = field(default_factory=list)\n122: \n123: \n124: class Verifier:\n125:     \"\"\"Trusted correctness and efficiency tester.\"\"\"\n126: \n127:     def __init__(\n128:         self,\n129:         problem: ProblemDefinition,\n130:         sandbox: Sandbox,\n131:         bound_n_max: int = 5,\n132:         bound_n_random: int = 20,\n133:         bound_seq_len_max: int = 20,\n134:         bound_seq_count: int = 10,\n135:         bound_seed: int = 1337,\n136:         exhaustive_flip_n_max: int = 5,\n137:         chunk_size: int | None = None,\n138:         use_offline: bool = True,\n139:         universe: str = \"nauty\",\n140:         relabels_per_class: int = 2,\n141:         workers: int | None = None,\n142:         update_mode: str = \"mixed\",\n143:     ):\n144:         self.problem = problem\n145:         self.sandbox = sandbox\n146:         # update_mode restricts which edge operations the test sequences use:\n147:         # \"mixed\" (default, unchanged behaviour), \"insert_only\", \"delete_only\".\n148:         if update_mode not in (\"mixed\", \"insert_only\", \"delete_only\"):\n149:             raise ValueError(\n150:                 f\"update_mode must be 'mixed', 'insert_only', or 'delete_only', \"\n151:                 f\"got {update_mode!r}\"\n152:             )\n153:         self.update_mode = update_mode\n154:         self.n_max = bound_n_max\n155:         self.n_random = bound_n_random\n156:         self.seq_len_max = bound_seq_len_max\n157:         self.seq_count = bound_seq_count\n158:         self.seed = bound_seed\n159:         self.exhaustive_flip_n_max = exhaustive_flip_n_max\n160:         # Worker count for parallel chunk evaluation. workers=None -> a modest\n161:         # default (min(8, cpu)); workers=1 reproduces the original serial path\n162:         # exactly.\n163:         self.workers = _default_workers() if workers is None else max(1, workers)\n164:         # Chunk size: an explicit value is honored verbatim. None auto-tunes --\n165:         # the serial default (2000) for workers=1, or smaller chunks\n166:         # (DEFAULT_PARALLEL_CHUNK_SIZE) when parallelizing, so load balances\n167:         # across workers and the per-chunk timeout stays tight.\n168:         if chunk_size is not None:\n169:             self.chunk_size = chunk_size\n170:         elif self.workers > 1:\n171:             self.chunk_size = DEFAULT_PARALLEL_CHUNK_SIZE\n172:         else:\n173:             self.chunk_size = DEFAULT_CHUNK_SIZE\n174:         # The offline baseline is only needed for work_ratio; the self-test\n175:         # (known-good / faults / controls) skips it to keep wall time low.\n176:         self.use_offline = use_offline\n177:         self.universe = universe\n178:         self.relabels_per_class = relabels_per_class\n179:         # Exhaustive length-2 flip paths (twins) are O(n^4)/graph and are only\n180:         # affordable on the small labeled comparison universe. The nauty\n181:         # universe already covers every single-edge flip via the singles.\n182:         self.use_twins = (universe == \"labeled\")\n183: \n184:         # Cache test graphs (they don't change between candidates)\n185:         self._test_graphs: list[tuple[int, np.ndarray]] | None = None\n186:         self._test_sequences: dict[int, list[list[tuple[str, tuple[int, int]]]]] = {}\n187:         self._test_counts: dict[int, int] | None = None\n188: \n189:     @property\n190:     def test_graphs(self) -> list[tuple[int, np.ndarray]]:\n191:         if self._test_graphs is None:\n192:             self._test_graphs = generate_test_graphs(\n193:                 self.n_max, self.n_random, self.seed,\n194:                 directed=self.problem.directed,\n195:                 universe=self.universe,\n196:                 rooted=self.problem.needs_root,\n197:                 relabels_per_class=self.relabels_per_class,\n198:             )\n199:             counts: dict[int, int] = {}\n200:             for n, _g in self._test_graphs:\n\n(Showing lines 1-200 of 774. Use offset=201 to continue.)\n</content>","metadata":{"preview":"\"\"\"Verifier and Evaluator: test candidates against invariants.\n\nThe Verifier runs each candidate through the bounded test universe:\n  1. For each base graph in the test set\n  2. Generate operation sequences (insert/delete)\n  3. Execute candidate in sandbox (init + replay operations)\n  4. After each operation, check the invariant against the oracle\n  5. Record pass/fail, failing case, work counts\n\nThe Evaluator computes fitness (fraction of sequences passing) and\nwork_ratio (candidate_work / offline_work).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport concurrent.futures\nimport logging\nimport os\nimport time\nfrom dataclasses import dataclass, field","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/src/evoalgo/verifier.py","text":"\"\"\"Verifier and Evaluator: test candidates against invariants.\n\nThe Verifier runs each candidate through the bounded test universe:\n  1. For each base graph in the test set\n  2. Generate operation sequences (insert/delete)\n  3. Execute candidate in sandbox (init + replay operations)\n  4. After each operation, check the invariant against the oracle\n  5. Record pass/fail, failing case, work counts\n\nThe Evaluator computes fitness (fraction of sequences passing) and\nwork_ratio (candidate_work / offline_work).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport concurrent.futures\nimport logging\nimport os\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any\n\nimport numpy as np\n\nfrom .candidate import Candidate, CandidateState\nfrom .graph_generator import (\n    generate_test_graphs,\n    generate_operation_sequences,\n)\nfrom .problem_definitions import ProblemDefinition\nfrom .sandbox import Sandbox, SandboxResult\n\n# Default number of base graphs per sandbox subprocess. A chunk must finish\n# within the per-chunk timeout for a correct candidate, while a candidate that\n# loops forever on one case hits the timeout and fails fast. 2000 base graphs\n# is ~10-15 s for the slowest correct candidates (recompute-always BFS,\n# validate-or-rebuild DFS) at n<=5, well under a 30-60 s per-chunk timeout.\n#\n# When chunks are evaluated in parallel (workers > 1) the default chunk size is\n# halved (1000) so the work is split across more, smaller chunks: this balances\n# load across workers and keeps each chunk's wall time (and therefore its\n# per-chunk timeout) small, so a candidate that loops forever still fails fast.\nDEFAULT_CHUNK_SIZE = 2000\nDEFAULT_PARALLEL_CHUNK_SIZE = 1000\n\n\ndef _default_workers() -> int:\n    \"\"\"Default worker count: modest on a shared build server (80 cores).\"\"\"\n    cpu = os.cpu_count() or 1\n    return max(1, min(8, cpu))\n\nlogger = logging.getLogger(__name__)\n\n\ndef _exhaustive_flip_sequences(\n    n: int,\n    graph: np.ndarray,\n    directed: bool,\n    include_twins: bool = False,\n) -> list[list[tuple[str, tuple[int, int]]]]:\n    \"\"\"Deterministic short update sequences covering the update space.\n\n    Always returns all legal single-edge flips (each as a length-1 sequence):\n    this is \"every possible edge operation\" on the base graph. When\n    ``include_twins`` is True it additionally returns a compact set of length-2\n    paths (flip one edge, then flip each other edge).\n\n    The twins are O(n^4) per graph (380 at n=5) and are kept only for the small\n    labeled comparison universe, where they close the coverage hole left by\n    random sequences. For the nauty (non-isomorphic) universe the singles alone\n    already give exhaustive single-edge coverage, and the twins would make the\n    n=5 universe prohibitively expensive, so they default to off.\n    \"\"\"\n    pairs = [(u, v) for u in range(n) for v in range(n) if u != v and (directed or u < v)]\n    single: list[list[tuple[str, tuple[int, int]]]] = []\n    for u, v in pairs:\n        if graph[u, v]:\n            single.append([(\"delete\", (u, v))])\n        else:\n            single.append([(\"insert\", (u, v))])\n    if not include_twins:\n        return single\n    # length-2 paths: first flip (u,v), then flip (u',v') in the resulting graph\n    twins: list[list[tuple[str, tuple[int, int]]]] = []\n    for u, v in pairs:\n        flipped = graph.copy()\n        if flipped[u, v]:\n            flipped[u, v] = 0\n            if not directed:\n                flipped[v, u] = 0\n            first: tuple[str, tuple[int, int]] = (\"delete\", (u, v))\n        else:\n            flipped[u, v] = 1\n            if not directed:\n                flipped[v, u] = 1\n            first = (\"insert\", (u, v))\n        for u2, v2 in pairs:\n            if (u2, v2) == (u, v):\n                continue\n            if flipped[u2, v2]:\n                twins.append([first, (\"delete\", (u2, v2))])\n            else:\n                twins.append([first, (\"insert\", (u2, v2))])\n    return single + twins\n\n\n@dataclass\nclass VerifyResult:\n    \"\"\"Result of verifying one candidate.\"\"\"\n\n    candidate_id: str\n    state: CandidateState\n    fitness: float = 0.0\n    work_ratio: float | None = None\n    timeout: bool = False\n    tests_passed: int = 0\n    tests_total: int = 0\n    error_message: str | None = None\n    failing_case: dict[str, Any] | None = None\n    per_step_states: list[dict] = field(default_factory=list)\n\n\nclass Verifier:\n    \"\"\"Trusted correctness and efficiency tester.\"\"\"\n\n    def __init__(\n        self,\n        problem: ProblemDefinition,\n        sandbox: Sandbox,\n        bound_n_max: int = 5,\n        bound_n_random: int = 20,\n        bound_seq_len_max: int = 20,\n        bound_seq_count: int = 10,\n        bound_seed: int = 1337,\n        exhaustive_flip_n_max: int = 5,\n        chunk_size: int | None = None,\n        use_offline: bool = True,\n        universe: str = \"nauty\",\n        relabels_per_class: int = 2,\n        workers: int | None = None,\n        update_mode: str = \"mixed\",\n    ):\n        self.problem = problem\n        self.sandbox = sandbox\n        # update_mode restricts which edge operations the test sequences use:\n        # \"mixed\" (default, unchanged behaviour), \"insert_only\", \"delete_only\".\n        if update_mode not in (\"mixed\", \"insert_only\", \"delete_only\"):\n            raise ValueError(\n                f\"update_mode must be 'mixed', 'insert_only', or 'delete_only', \"\n                f\"got {update_mode!r}\"\n            )\n        self.update_mode = update_mode\n        self.n_max = bound_n_max\n        self.n_random = bound_n_random\n        self.seq_len_max = bound_seq_len_max\n        self.seq_count = bound_seq_count\n        self.seed = bound_seed\n        self.exhaustive_flip_n_max = exhaustive_flip_n_max\n        # Worker count for parallel chunk evaluation. workers=None -> a modest\n        # default (min(8, cpu)); workers=1 reproduces the original serial path\n        # exactly.\n        self.workers = _default_workers() if workers is None else max(1, workers)\n        # Chunk size: an explicit value is honored verbatim. None auto-tunes --\n        # the serial default (2000) for workers=1, or smaller chunks\n        # (DEFAULT_PARALLEL_CHUNK_SIZE) when parallelizing, so load balances\n        # across workers and the per-chunk timeout stays tight.\n        if chunk_size is not None:\n            self.chunk_size = chunk_size\n        elif self.workers > 1:\n            self.chunk_size = DEFAULT_PARALLEL_CHUNK_SIZE\n        else:\n            self.chunk_size = DEFAULT_CHUNK_SIZE\n        # The offline baseline is only needed for work_ratio; the self-test\n        # (known-good / faults / controls) skips it to keep wall time low.\n        self.use_offline = use_offline\n        self.universe = universe\n        self.relabels_per_class = relabels_per_class\n        # Exhaustive length-2 flip paths (twins) are O(n^4)/graph and are only\n        # affordable on the small labeled comparison universe. The nauty\n        # universe already covers every single-edge flip via the singles.\n        self.use_twins = (universe == \"labeled\")\n\n        # Cache test graphs (they don't change between candidates)\n        self._test_graphs: list[tuple[int, np.ndarray]] | None = None\n        self._test_sequences: dict[int, list[list[tuple[str, tuple[int, int]]]]] = {}\n        self._test_counts: dict[int, int] | None = None\n\n    @property\n    def test_graphs(self) -> list[tuple[int, np.ndarray]]:\n        if self._test_graphs is None:\n            self._test_graphs = generate_test_graphs(\n                self.n_max, self.n_random, self.seed,\n                directed=self.problem.directed,\n                universe=self.universe,\n                rooted=self.problem.needs_root,\n                relabels_per_class=self.relabels_per_class,\n            )\n            counts: dict[int, int] = {}\n            for n, _g in self._test_graphs:","lineStart":1,"lineEnd":200,"totalLines":774,"truncated":true}},"title":"src/evoalgo/verifier.py","time":{"start":1792509931819,"end":1792509931847}},"id":"prt_159eaed23001x0oQzPEHiP6Zgj","sessionID":"ses_ea6165c0bffec0GbYC1A6HUELg","messageID":"msg_159eae8c7001Y2mdTHBrRtCxFO"}}
