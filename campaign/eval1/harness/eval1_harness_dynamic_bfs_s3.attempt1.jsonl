ph, edge, state):\n48:     u, v = edge\n49:     dist = state[\"distances\"]\n50:     if dist[u] == -1 or (dist[v] != -1 and dist[u] + 1 >= dist[v]):\n51:         return state\n52:     parent = state[\"parent\"]\n53:     children = state[\"children\"]\n54:     old = parent[v]\n55:     if old is not None:\n56:         children[old].remove(v)\n57:     parent[v] = u\n58:     dist[v] = dist[u] + 1\n59:     children[u].append(v)\n60:     n = len(graph)\n61:     queue = [v]\n62:     for x in queue:\n63:         row = graph[x]\n64:         nd = dist[x] + 1\n65:         for y in range(n):\n66:             if not row[y]:\n67:                 continue\n68:             dy = dist[y]\n69:             if dy == -1:\n70:                 dist[y] = nd\n71:                 parent[y] = x\n72:                 children[x].append(y)\n73:                 queue.append(y)\n74:             elif dy > nd:\n75:                 children[parent[y]].remove(y)\n76:                 parent[y] = x\n77:                 dist[y] = nd\n78:                 children[x].append(y)\n79:                 queue.append(y)\n80:     return state\n81: \n82: \n83: def delete_edge(graph, edge, state):\n84:     u, v = edge\n85:     parent = state[\"parent\"]\n86:     if parent[v] != u:\n87:         return state\n88:     dist = state[\"distances\"]\n89:     n = len(graph)\n90:     # Subtree under v in BFS order (non-decreasing distance).\n91:     subtree = []\n92:     queue = [v]\n93:     for x in queue:\n94:         subtree.append(x)\n95:         queue.extend(state[\"children\"][x])\n96:     lost = set()\n97:     # Phase 1: in BFS order, a vertex keeps its distance iff it has a\n98:     # surviving in-neighbor exactly one level up.\n99:     for x in subtree:\n100:         kept = False\n101:         for z in range(n):\n102:             if graph[z][x] and dist[z] + 1 == dist[x] and z not in lost:\n103:                 parent[x] = z\n104:                 kept = True\n105:                 break\n106:         if not kept:\n107:             lost.add(x)\n108:             dist[x] = -1\n109:             parent[x] = None\n110:     # Phase 2: lost vertices may still be reachable at a larger distance.\n111:     if lost:\n112:         best = {}\n113:         par2 = {}\n114:         heap = []\n115:         for x in lost:\n116:             bd = None\n117:             bz = None\n118:             for z in range(n):\n119:                 if graph[z][x] and z not in lost and dist[z] != -1:\n120:                     d = dist[z] + 1\n121:                     if bd is None or d < bd:\n122:                         bd = d\n123:                         bz = z\n124:             if bd is not None:\n125:                 best[x] = bd\n126:                 par2[x] = bz\n127:                 heap.append((bd, x))\n128:         heapq.heapify(heap)\n129:         while heap:\n130:             d, x = heapq.heappop(heap)\n131:             if d != best.get(x):\n132:                 continue\n133:             row = graph[x]\n134:             nd = d + 1\n135:             for y in range(n):\n136:                 if row[y] and y in lost and (y not in best or nd < best[y]):\n137:                     best[y] = nd\n138:                     par2[y] = x\n139:                     heapq.heappush(heap, (nd, y))\n140:         for x in lost:\n141:             if x in best:\n142:                 dist[x] = best[x]\n143:                 parent[x] = par2[x]\n144:     state[\"children\"] = _rebuild_children(parent)\n145:     return state\n\n(End of file - total 145 lines)\n</content>","metadata":{"preview":"\"\"\"Dynamic BFS tree from a fixed root (vertex 0) in a directed graph.\n\nInsertion of (u, v) can only shorten distances, and only when\ndist[u] + 1 < dist[v] (or v was unreachable): re-attach v under u and\npropagate the decrease with a BFS that relaxes only shortening edges.\nDeletion of a non-tree edge changes nothing (the tree still certifies\nevery distance). Deletion of the tree edge (u, v) re-attaches the\nsubtree under v in BFS order -- a vertex keeps its distance iff it has\na surviving in-neighbor one level up -- and re-reaches the lost\nremainder from the surviving boundary with a Dijkstra pass.\n\"\"\"\n\nimport heapq\n\n\ndef _init_bfs(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s3/candidate.py","text":"\"\"\"Dynamic BFS tree from a fixed root (vertex 0) in a directed graph.\n\nInsertion of (u, v) can only shorten distances, and only when\ndist[u] + 1 < dist[v] (or v was unreachable): re-attach v under u and\npropagate the decrease with a BFS that relaxes only shortening edges.\nDeletion of a non-tree edge changes nothing (the tree still certifies\nevery distance). Deletion of the tree edge (u, v) re-attaches the\nsubtree under v in BFS order -- a vertex keeps its distance iff it has\na surviving in-neighbor one level up -- and re-reaches the lost\nremainder from the surviving boundary with a Dijkstra pass.\n\"\"\"\n\nimport heapq\n\n\ndef _init_bfs(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    queue = [0]\n    for u in queue:\n        row = graph[u]\n        nd = dist[u] + 1\n        for v in range(n):\n            if row[v] and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                queue.append(v)\n    return parent, dist\n\n\ndef _rebuild_children(parent):\n    children = [[] for _ in parent]\n    for v, p in enumerate(parent):\n        if p is not None:\n            children[p].append(v)\n    return children\n\n\ndef init(graph):\n    parent, dist = _init_bfs(graph)\n    return {\"parent\": parent, \"distances\": dist,\n            \"children\": _rebuild_children(parent)}\n\n\ndef insert_edge(graph, edge, state):\n    u, v = edge\n    dist = state[\"distances\"]\n    if dist[u] == -1 or (dist[v] != -1 and dist[u] + 1 >= dist[v]):\n        return state\n    parent = state[\"parent\"]\n    children = state[\"children\"]\n    old = parent[v]\n    if old is not None:\n        children[old].remove(v)\n    parent[v] = u\n    dist[v] = dist[u] + 1\n    children[u].append(v)\n    n = len(graph)\n    queue = [v]\n    for x in queue:\n        row = graph[x]\n        nd = dist[x] + 1\n        for y in range(n):\n            if not row[y]:\n                continue\n            dy = dist[y]\n            if dy == -1:\n                dist[y] = nd\n                parent[y] = x\n                children[x].append(y)\n                queue.append(y)\n            elif dy > nd:\n                children[parent[y]].remove(y)\n                parent[y] = x\n                dist[y] = nd\n                children[x].append(y)\n                queue.append(y)\n    return state\n\n\ndef delete_edge(graph, edge, state):\n    u, v = edge\n    parent = state[\"parent\"]\n    if parent[v] != u:\n        return state\n    dist = state[\"distances\"]\n    n = len(graph)\n    # Subtree under v in BFS order (non-decreasing distance).\n    subtree = []\n    queue = [v]\n    for x in queue:\n        subtree.append(x)\n        queue.extend(state[\"children\"][x])\n    lost = set()\n    # Phase 1: in BFS order, a vertex keeps its distance iff it has a\n    # surviving in-neighbor exactly one level up.\n    for x in subtree:\n        kept = False\n        for z in range(n):\n            if graph[z][x] and dist[z] + 1 == dist[x] and z not in lost:\n                parent[x] = z\n                kept = True\n                break\n        if not kept:\n            lost.add(x)\n            dist[x] = -1\n            parent[x] = None\n    # Phase 2: lost vertices may still be reachable at a larger distance.\n    if lost:\n        best = {}\n        par2 = {}\n        heap = []\n        for x in lost:\n            bd = None\n            bz = None\n            for z in range(n):\n                if graph[z][x] and z not in lost and dist[z] != -1:\n                    d = dist[z] + 1\n                    if bd is None or d < bd:\n                        bd = d\n                        bz = z\n            if bd is not None:\n                best[x] = bd\n                par2[x] = bz\n                heap.append((bd, x))\n        heapq.heapify(heap)\n        while heap:\n            d, x = heapq.heappop(heap)\n            if d != best.get(x):\n                continue\n            row = graph[x]\n            nd = d + 1\n            for y in range(n):\n                if row[y] and y in lost and (y not in best or nd < best[y]):\n                    best[y] = nd\n                    par2[y] = x\n                    heapq.heappush(heap, (nd, y))\n        for x in lost:\n            if x in best:\n                dist[x] = best[x]\n                parent[x] = par2[x]\n    state[\"children\"] = _rebuild_children(parent)\n    return state","lineStart":1,"lineEnd":145,"totalLines":145,"truncated":false}},"title":"runs/eval1_harness_dynamic_bfs_s3/candidate.py","time":{"start":1792510219486,"end":1792510219526}},"id":"prt_159ef5452001aSz4NA26X6bR77","sessionID":"ses_ea6165c0bffec0GbYC1A6HUELg","messageID":"msg_159ef4e5e001Y3KlAuCJvzmVTI"}}
