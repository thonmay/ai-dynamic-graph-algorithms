{"type":"tool_use","timestamp":1792510210307,"sessionID":"ses_ea6165c0bffec0GbYC1A6HUELg","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-95defea3e475da00","state":{"status":"completed","input":{"filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/dynbfs/validate.py","content":"import random, sys\nsys.path.insert(0, \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_bfs_s3\")\nimport importlib\ncand = importlib.import_module(\"candidate\")\n\n\ndef oracle(graph):\n    n = len(graph)\n    parent = [None] * n\n    dist = [-1] * n\n    dist[0] = 0\n    q = [0]\n    for u in q:\n        nd = dist[u] + 1\n        for v in range(n):\n            if graph[u][v] and dist[v] == -1:\n                dist[v] = nd\n                parent[v] = u\n                q.append(v)\n    return parent, dist\n\n\ndef check_state(state, graph, tag):\n    n = len(graph)\n    parent = list(state[\"parent\"])\n    dist = list(state[\"distances\"])\n    op, od = oracle(graph)\n    for v in range(n):\n        if dist[v] != od[v]:\n            print(f\"FAIL {tag}: dist[{v}]={dist[v]} expected {od[v]}\")\n            return False\n        if v != 0:\n            p = parent[v]\n            if od[v] == -1:\n                if p is not None:\n                    print(f\"FAIL {tag}: parent[{v}]={p} but v unreachable\")\n                    return False\n            else:\n                if p is None or not graph[p][v] or dist[p] + 1 != dist[v]:\n                    print(f\"FAIL {tag}: parent[{v}]={p} dist[{v}]={dist[v]} \"\n                          f\"expected parent dist {od[v]-1}\")\n                    return False\n        else:\n            if parent[v] is not None:\n                print(f\"FAIL {tag}: root has parent\")\n                return False\n    return True\n\n\ndef run_random(n, steps, seed, p=0.3):\n    rng = random.Random(seed)\n    g = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if i != j and rng.random() < p:\n                g[i][j] = 1\n    state = cand.init(g)\n    if not check_state(state, g, f\"n={n} init\"):\n        return False\n    for s in range(steps):\n        u, v = rng.randrange(n), rng.randrange(n)\n        if u == v:\n            continue\n        if g[u][v]:\n            g[u][v] = 0\n            state = cand.delete_edge(g, (u, v), state)\n        else:\n            g[u][v] = 1\n            state = cand.insert_edge(g, (u, v), state)\n        if not check_state(state, g, f\"n={n} step {s}\"):\n            return False\n    return True\n\n\nfails = 0\nfor seed in range(300):\n    n = 2 + seed % 5\n    if not run_random(n, 40, seed):\n        fails += 1\n        if fails > 3:\n            break\nprint(\"FAILURES:\", fails)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/dynbfs/validate.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/dynbfs/validate.py","time":{"start":1792510210268,"end":1792510210297}},"id":"prt_159ef23d0001vUOHadxW22BIKi","sessionID":"ses_ea6165c0bffec0GbYC1A6HUELg","messageID":"msg_159ef1f1e001LJpo6CnS2FPmeR"}}
