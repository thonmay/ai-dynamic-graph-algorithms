{"type":"tool_use","timestamp":1792501508284,"sessionID":"ses_ea696572dffe59PLAKRjMwErzJ","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a4a04a7a7e557f68","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/src/evoalgo/verifier.py"},"output":"<path>/home/ethomdt/thesis/src/evoalgo/verifier.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Verifier and Evaluator: test candidates against invariants.\n2: \n3: The Verifier runs each candidate through the bounded test universe:\n4:   1. For each base graph in the test set\n5:   2. Generate operation sequences (insert/delete)\n6:   3. Execute candidate in sandbox (init + replay operations)\n7:   4. After each operation, check the invariant against the oracle\n8:   5. Record pass/fail, failing case, work counts\n9: \n10: The Evaluator computes fitness (fraction of sequences passing) and\n11: work_ratio (candidate_work / offline_work).\n12: \"\"\"\n13: \n14: from __future__ import annotations\n15: \n16: import concurrent.futures\n17: import logging\n18: import os\n19: import time\n20: from dataclasses import dataclass, field\n21: from pathlib import Path\n22: from typing import Any\n23: \n24: import numpy as np\n25: \n26: from .candidate import Candidate, CandidateState\n27: from .graph_generator import (\n28:     generate_test_graphs,\n29:     generate_operation_sequences,\n30: )\n31: from .problem_definitions import ProblemDefinition\n32: from .sandbox import Sandbox, SandboxResult\n33: \n34: # Default number of base graphs per sandbox subprocess. A chunk must finish\n35: # within the per-chunk timeout for a correct candidate, while a candidate that\n36: # loops forever on one case hits the timeout and fails fast. 2000 base graphs\n37: # is ~10-15 s for the slowest correct candidates (recompute-always BFS,\n38: # validate-or-rebuild DFS) at n<=5, well under a 30-60 s per-chunk timeout.\n39: #\n40: # When chunks are evaluated in parallel (workers > 1) the default chunk size is\n41: # halved (1000) so the work is split across more, smaller chunks: this balances\n42: # load across workers and keeps each chunk's wall time (and therefore its\n43: # per-chunk timeout) small, so a candidate that loops forever still fails fast.\n44: DEFAULT_CHUNK_SIZE = 2000\n45: DEFAULT_PARALLEL_CHUNK_SIZE = 1000\n46: \n47: \n48: def _default_workers() -> int:\n49:     \"\"\"Default worker count: modest on a shared build server (80 cores).\"\"\"\n50:     cpu = os.cpu_count() or 1\n51:     return max(1, min(8, cpu))\n52: \n53: logger = logging.getLogger(__name__)\n54: \n55: \n56: def _exhaustive_flip_sequences(\n57:     n: int,\n58:     graph: np.ndarray,\n59:     directed: bool,\n60:     include_twins: bool = False,\n61: ) -> list[list[tuple[str, tuple[int, int]]]]:\n62:     \"\"\"Deterministic short update sequences covering the update space.\n63: \n64:     Always returns all legal single-edge flips (each as a length-1 sequence):\n65:     this is \"every possible edge operation\" on the base graph. When\n66:     ``include_twins`` is True it additionally returns a compact set of length-2\n67:     paths (flip one edge, then flip each other edge).\n68: \n69:     The twins are O(n^4) per graph (380 at n=5) and are kept only for the small\n70:     labeled comparison universe, where they close the coverage hole left by\n71:     random sequences. For the nauty (non-isomorphic) universe the singles alone\n72:     already give exhaustive single-edge coverage, and the twins would make the\n73:     n=5 universe prohibitively expensive, so they default to off.\n74:     \"\"\"\n75:     pairs = [(u, v) for u in range(n) for v in range(n) if u != v and (directed or u < v)]\n76:     single: list[list[tuple[str, tuple[int, int]]]] = []\n77:     for u, v in pairs:\n78:         if graph[u, v]:\n79:             single.append([(\"delete\", (u, v))])\n80:         else:\n81:             single.append([(\"insert\", (u, v))])\n82:     if not include_twins:\n83:         return single\n84:     # length-2 paths: first flip (u,v), then flip (u',v') in the resulting graph\n85:     twins: list[list[tuple[str, tuple[int, int]]]] = []\n86:     for u, v in pairs:\n87:         flipped = graph.copy()\n88:         if flipped[u, v]:\n89:             flipped[u, v] = 0\n90:             if not directed:\n91:                 flipped[v, u] = 0\n92:             first: tuple[str, tuple[int, int]] = (\"delete\", (u, v))\n93:         else:\n94:             flipped[u, v] = 1\n95:             if not directed:\n96:                 flipped[v, u] = 1\n97:             first = (\"insert\", (u, v))\n98:         for u2, v2 in pairs:\n99:             if (u2, v2) == (u, v):\n100:                 continue\n101:             if flipped[u2, v2]:\n102:                 twins.append([first, (\"delete\", (u2, v2))])\n103:             else:\n104:                 twins.append([first, (\"insert\", (u2, v2))])\n105:     return single + twins\n106: \n107: \n108: @dataclass\n109: class VerifyResult:\n110:     \"\"\"Result of verifying one candidate.\"\"\"\n111: \n112:     candidate_id: str\n113:     state: CandidateState\n114:     fitness: float = 0.0\n115:     work_ratio: float | None = None\n116:     timeout: bool = False\n117:     tests_passed: int = 0\n118:     tests_total: int = 0\n119:     error_message: str | None = None\n120:     failing_case: dict[str, Any] | None = None\n121:     per_step_states: list[dict] = field(default_factory=list)\n122: \n123: \n124: class Verifier:\n125:     \"\"\"Trusted correctness and efficiency tester.\"\"\"\n126: \n127:     def __init__(\n128:         self,\n129:         problem: ProblemDefinition,\n130:         sandbox: Sandbox,\n131:         bound_n_max: int = 5,\n132:         bound_n_random: int = 20,\n133:         bound_seq_len_max: int = 20,\n134:         bound_seq_count: int = 10,\n135:         bound_seed: int = 1337,\n136:         exhaustive_flip_n_max: int = 5,\n137:         chunk_size: int | None = None,\n138:         use_offline: bool = True,\n139:         universe: str = \"nauty\",\n140:         relabels_per_class: int = 2,\n141:         workers: int | None = None,\n142:         update_mode: str = \"mixed\",\n143:     ):\n144:         self.problem = problem\n145:         self.sandbox = sandbox\n146:         # update_mode restricts which edge operations the test sequences use:\n147:         # \"mixed\" (default, unchanged behaviour), \"insert_only\", \"delete_only\".\n148:         if update_mode not in (\"mixed\", \"insert_only\", \"delete_only\"):\n149:             raise ValueError(\n150:                 f\"update_mode must be 'mixed', 'insert_only', or 'delete_only', \"\n151:                 f\"got {update_mode!r}\"\n152:             )\n153:         self.update_mode = update_mode\n154:         self.n_max = bound_n_max\n155:         self.n_random = bound_n_random\n156:         self.seq_len_max = bound_seq_len_max\n157:         self.seq_count = bound_seq_count\n158:         self.seed = bound_seed\n159:         self.exhaustive_flip_n_max = exhaustive_flip_n_max\n160:         # Worker count for parallel chunk evaluation. workers=None -> a modest\n161:         # default (min(8, cpu)); workers=1 reproduces the original serial path\n162:         # exactly.\n163:         self.workers = _default_workers() if workers is None else max(1, workers)\n164:         # Chunk size: an explicit value is honored verbatim. None auto-tunes --\n165:         # the serial default (2000) for workers=1, or smaller chunks\n166:         # (DEFAULT_PARALLEL_CHUNK_SIZE) when parallelizing, so load balances\n167:         # across workers and the per-chunk timeout stays tight.\n168:         if chunk_size is not None:\n169:             self.chunk_size = chunk_size\n170:         elif self.workers > 1:\n171:             self.chunk_size = DEFAULT_PARALLEL_CHUNK_SIZE\n172:         else:\n173:             self.chunk_size = DEFAULT_CHUNK_SIZE\n174:         # The offline baseline is only needed for work_ratio; the self-test\n175:         # (known-good / faults / controls) skips it to keep wall time low.\n176:         self.use_offline = use_offline\n177:         self.universe = universe\n178:         self.relabels_per_class = relabels_per_class\n179:         # Exhaustive length-2 flip paths (twins) are O(n^4)/graph and are only\n180:         # affordable on the small labeled comparison universe. The nauty\n181:         # universe already covers every single-edge flip via the singles.\n182:         self.use_twins = (universe == \"labeled\")\n183: \n184:         # Cache test graphs (they don't change between candidates)\n185:         self._test_graphs: list[tuple[int, np.ndarray]] | None = None\n186:         self._test_sequences: dict[int, list[list[tuple[str, tuple[int, int]]]]] = {}\n187:         self._test_counts: dict[int, int] | None = None\n188: \n189:     @property\n190:     def test_graphs(self) -> list[tuple[int, np.ndarray]]:\n191:         if self._test_graphs is None:\n192:             self._test_graphs = generate_test_graphs(\n193:                 self.n_max, self.n_random, self.seed,\n194:                 directed=self.problem.directed,\n195:                 universe=self.universe,\n196:                 rooted=self.problem.needs_root,\n197:                 relabels_per_class=self.relabels_per_class,\n198:             )\n199:             counts: dict[int, int] = {}\n200:             for n, _g in self._test_graphs:\n201:                 counts[n] = counts.get(n, 0) + 1\n202:             self._test_counts = counts\n203:             logger.info(\"Generated %d test graphs (n=2..%d, %s, universe=%s): %s\",\n204:                         len(self._test_graphs), self.n_max,\n205:                         \"directed\" if self.problem.directed else \"undirected\",\n206:                         self.universe, counts)\n207:         return self._test_graphs\n208: \n209:     def test_counts(self) -> dict[int, int]:\n210:         \"\"\"Number of base test graphs per n (computed lazily with test_graphs).\"\"\"\n211:         self.test_graphs\n212:         return self._test_counts or {}\n213: \n214:     def get_sequences(self, n: int, graph: np.ndarray) -> list[list[tuple[str, tuple[int, int]]]]:\n215:         key = (n, graph.tobytes())\n216:         if key not in self._test_sequences:\n217:             seqs = generate_operation_sequences(\n218:                 n, graph, self.seq_len_max, self.seq_count, self.seed + n,\n219:                 directed=self.problem.directed,\n220:             )\n221:             # Deterministic exhaustive single-edge flips for small n (and, on\n222:             # the labeled comparison universe, a compact set of 2-flip paths).\n223:             # Random sequences alone missed reachable counterexamples (e.g. a\n224:             # single insert breaking dynamic MCS at n=3), so close that gap\n225:             # for the sizes where exhaustive coverage is cheap.\n226:             if n <= self.exhaustive_flip_n_max:\n227:                 seqs = seqs + _exhaustive_flip_sequences(\n228:                     n, graph, self.problem.directed, include_twins=self.use_twins,\n229:                 )\n230:             seqs = self._filter_sequences_for_mode(seqs, graph)\n231:             self._test_sequences[key] = seqs\n232:         return self._test_sequences[key]\n233: \n234:     def _filter_sequences_for_mode(\n235:         self,\n236:         seqs: list[list[tuple[str, tuple[int, int]]]],\n237:         graph: np.ndarray,\n238:     ) -> list[list[tuple[str, tuple[int, int]]]]:\n239:         \"\"\"Restrict sequences to the configured ``update_mode``.\n240: \n241:         \"mixed\" (the default) returns them unchanged. For \"insert_only\" /\n242:         \"delete_only\" each sequence is replayed on a copy of the base graph and\n243:         only the legal ops of the allowed type are kept, so the result is a\n244:         sequence that is still legal on the evolving graph. This is what lets a\n245:         pack declare a semi-dynamic (incremental or decremental-only) problem\n246:         without touching the sequence generators.\n247:         \"\"\"\n248:         if self.update_mode == \"mixed\":\n249:             return seqs\n250:         allowed = \"insert\" if self.update_mode == \"insert_only\" else \"delete\"\n251:         filtered: list[list[tuple[str, tuple[int, int]]]] = []\n252:         for seq in seqs:\n253:             current = graph.copy()\n254:             out: list[tuple[str, tuple[int, int]]] = []\n255:             for op_type, (u, v) in seq:\n256:                 if op_type != allowed:\n257:                     continue\n258:                 if allowed == \"insert\":\n259:                     if current[u, v]:\n260:                         continue\n261:                     current[u, v] = 1\n262:                     if not self.problem.directed:\n263:                         current[v, u] = 1\n264:                 else:  # delete\n265:                     if not current[u, v]:\n266:                         continue\n267:                     current[u, v] = 0\n268:                     if not self.problem.directed:\n269:                         current[v, u] = 0\n270:                 out.append((op_type, (u, v)))\n271:             filtered.append(out)\n272:         return filtered\n273: \n274:     def _offline_src(self) -> str:\n275:         \"\"\"Return the offline baseline source for the sandbox subprocess.\n276: \n277:         Uses the problem's offline_source property which provides a\n278:         self-contained function named offline_compute(graph, root).\n279:         \"\"\"\n280:         return self.problem.offline_source\n281: \n282:     def verify(self, candidate: Candidate) -> VerifyResult:\n283:         \"\"\"Run a candidate through the full test universe.\n284: \n285:         The test universe is split into chunks of ``chunk_size`` base graphs,\n286:         each executed in its own sandbox subprocess with its own wall-clock\n287:         timeout. This keeps a correct candidate's per-chunk run well under the\n288:         timeout (so the whole n<=5 universe passes), while a candidate that\n289:         loops forever on one case still hits the per-chunk timeout and fails\n290:         fast.\n291: \n292:         Chunks are evaluated in parallel (``workers`` process pool) when\n293:         ``workers > 1``. Each worker is trusted code: it runs the sandbox\n294:         subprocess for its chunk (the candidate stays isolated in its own\n295:         subprocess, so the trust boundary is unchanged) and checks that\n296:         chunk's invariants, returning a compact partial result. The parent\n297:         merges the partials deterministically in chunk order, stopping at the\n298:         first failing chunk: totals are the sum over all chunks before the\n299:         first failing chunk plus that chunk's partial, and ``failing_case`` is\n300:         the first failure. Chunks after a known earlier failure are ignored.\n301:         ``workers == 1`` runs the exact serial path (one chunk at a time in\n302:         the parent), so the result is identical to the original implementation.\n303:         \"\"\"\n304:         candidate.transition(CandidateState.TESTING)\n305: \n306:         result = VerifyResult(candidate_id=candidate.id, state=CandidateState.TESTING)\n307: \n308:         code_path = Path(candidate.code_path)\n309:         if not code_path.exists():\n310:             result.state = CandidateState.CRASH\n311:             result.error_message = f\"Candidate file not found: {code_path}\"\n312:             candidate.transition(CandidateState.CRASH)\n313:             candidate.error_message = result.error_message\n314:             return result\n315: \n316:         offline_src = self._offline_src() if self.use_offline else \"\"\n317:         root = 0 if self.problem.needs_root else None\n318: \n319:         # Build all test cases (graph + its sequences) in a stable order.\n320:         test_cases: list[dict[str, Any]] = []\n321:         graph_meta: list[tuple[int, int]] = []  # (n, num_sequences) per graph\n322:         total_steps = 0\n323:         for n, graph in self.test_graphs:\n324:             sequences = self.get_sequences(n, graph)\n325:             seq_list: list[list[dict]] = []\n326:             for seq in sequences:\n327:                 ops = [{\"type\": op_type, \"edge\": list(edge)} for op_type, edge in seq]\n328:                 seq_list.append(ops)\n329:                 total_steps += 1 + len(seq)  # init + operations\n330:             test_cases.append({\n331:                 \"graph\": graph.tolist(),\n332:                 \"sequences\": seq_list,\n333:             })\n334:             graph_meta.append((n, len(sequences)))\n335: \n336:         # Adaptive REPEAT: keep total timed calls under a budget so timing\n337:         # stays meaningful without dominating wall time. Target ~500K total\n338:         # calls (candidate + offline), minimum REPEAT=1.\n339:         TIMING_BUDGET = 500_000\n340:         timing_multiplier = 2 if offline_src else 1\n341:         if total_steps > 0:\n342:             adaptive_repeat = max(1, TIMING_BUDGET // (total_steps * timing_multiplier))\n343:         else:\n344:             adaptive_repeat = 20\n345:         adaptive_repeat = min(adaptive_repeat, 20)  # cap at 20\n346: \n347:         # Split the test universe into chunks (each becomes one sandbox\n348:         # subprocess). chunk_args[i] = (i, chunk_start, chunk_cases, chunk_meta).\n349:         chunk_starts = list(range(0, len(test_cases), self.chunk_size)) or [0]\n350:         chunk_args = [\n351:             (i, chunk_start,\n352:              test_cases[chunk_start:chunk_start + self.chunk_size],\n353:              graph_meta[chunk_start:chunk_start + self.chunk_size])\n354:             for i, chunk_start in enumerate(chunk_starts)\n355:         ]\n356: \n357:         # Running totals, accumulated in chunk order by _merge_partial.\n358:         acc = {\"total\": 0, \"passed\": 0, \"cand_work\": 0, \"off_work\": 0}\n359: \n360:         if self.workers == 1:\n361:             # Serial path: one chunk at a time in the parent, in order.\n362:             for i, chunk_start, chunk_cases, chunk_meta in chunk_args:\n363:                 partial = _check_chunk_impl(\n364:                     self.problem, self.sandbox, code_path, chunk_cases, chunk_meta,\n365:                     chunk_start, root, offline_src, adaptive_repeat,\n366:                 )\n367:                 if self._merge_partial(result, partial, acc):\n368:                     break\n369:         else:\n370:             # Parallel path: a sliding window of ``workers`` chunks in flight.\n371:             # Sandbox subprocesses run concurrently; partials are merged in\n372:             # chunk order so the result is identical to the serial path.\n373:             ctx = {\n374:                 \"problem_name\": self.problem.name,\n375:                 \"directed\": self.problem.directed,\n376:                 \"root\": root,\n377:                 \"offline_src\": offline_src,\n378:                 \"adaptive_repeat\": adaptive_repeat,\n379:                 \"code_path\": str(code_path),\n380:                 \"timeout_seconds\": self.sandbox.timeout,\n381:                 \"python_path\": self.sandbox.python,\n382:             }\n383:             self._merge_parallel(result, chunk_args, ctx, acc)\n384: \n385:         result.tests_total = acc[\"total\"]\n386:         result.tests_passed = acc[\"passed\"]\n387: \n388:         if result.error_message:\n389:             result.state = CandidateState.CRASH\n390:             candidate.transition(CandidateState.CRASH)\n391:             candidate.error_message = result.error_message\n392:         elif result.timeout:\n393:             result.state = CandidateState.FAIL\n394:             candidate.transition(CandidateState.FAIL)\n395:             candidate.timeout = True\n396:         elif result.failing_case:\n397:             result.state = CandidateState.FAIL\n398:             candidate.transition(CandidateState.FAIL)\n399:         else:\n400:             result.state = CandidateState.PASS\n401:             candidate.transition(CandidateState.PASS)\n402: \n403:         result.fitness = acc[\"passed\"] / acc[\"total\"] if acc[\"total\"] > 0 else 0.0\n404:         if acc[\"off_work\"] > 0:\n405:             result.work_ratio = acc[\"cand_work\"] / acc[\"off_work\"]\n406:         # else: leave work_ratio as None (no offline baseline to ratio against)\n407: \n408:         _update_candidate(candidate, result)\n409:         return result\n410: \n411:     def _merge_partial(self, result: VerifyResult, partial: dict[str, Any],\n412:                        acc: dict[str, int]) -> bool:\n413:         \"\"\"Merge one chunk's partial result into the running totals.\n414: \n415:         Returns True if verification should stop (this chunk timed out,\n416:         crashed, or found the first invariant failure). The merge is\n417:         deterministic in chunk order, so once it returns True, later chunks\n418:         cannot change the result and are ignored.\n419:         \"\"\"\n420:         if partial[\"timeout\"]:\n421:             result.timeout = True\n422:             result.failing_case = {\n423:                 \"operation\": \"timeout\",\n424:                 \"chunk_start\": partial[\"chunk_start\"],\n425:                 **({\"hang\": partial[\"hang\"]} if partial.get(\"hang\") else {}),\n426:             }\n427:             return True\n428:         if partial[\"chunk_crash\"]:\n429:             result.error_message = partial[\"chunk_crash_error\"]\n430:             result.failing_case = {\"operation\": \"crash\", \"error\": partial[\"chunk_crash_error\"]}\n431:             return True\n432:         acc[\"total\"] += partial[\"tests_total\"]\n433:         acc[\"passed\"] += partial[\"tests_passed\"]\n434:         acc[\"cand_work\"] += partial[\"candidate_work\"]\n435:         acc[\"off_work\"] += partial[\"offline_work\"]\n436:         if partial[\"crash\"]:\n437:             result.error_message = partial[\"crash_error\"]\n438:             result.failing_case = partial[\"failing_case\"]\n439:             return True\n440:         if partial[\"failing_case\"] is not None:\n441:             result.failing_case = partial[\"failing_case\"]\n442:             return True\n443:         return False\n444: \n445:     def _merge_parallel(self, result: VerifyResult, chunk_args: list, ctx: dict,\n446:                         acc: dict[str, int]) -> None:\n447:         \"\"\"Evaluate chunks in a sliding window and merge in chunk order.\n448: \n449:         At most ``self.workers`` chunks are in flight at once. As chunks\n450:         complete (in wall-clock order) their partials are held until it is\n451:         their turn in chunk order, so the merge -- and therefore the result --\n452:         is identical to the serial path. Once a chunk fails, no further chunks\n453:         are submitted and the in-flight ones are drained and ignored.\n454:         \"\"\"\n455:         n_chunks = len(chunk_args)\n456:         futures: dict[int, concurrent.futures.Future] = {}\n457:         pending: dict[int, dict[str, Any]] = {}\n458:         next_submit = 0\n459:         next_merge = 0\n460:         stopped = False\n461: \n462:         def fill() -> None:\n463:             nonlocal next_submit\n464:             while next_submit < n_chunks and len(futures) < self.workers and not stopped:\n465:                 i, chunk_start, chunk_cases, chunk_meta = chunk_args[next_submit]\n466:                 futures[i] = pool.submit(\n467:                     _worker_check_chunk, ctx, i, chunk_start, chunk_cases, chunk_meta,\n468:                 )\n469:                 next_submit += 1\n470: \n471:         with concurrent.futures.ProcessPoolExecutor(max_workers=self.workers) as pool:\n472:             fill()\n473:             while futures:\n474:                 done, _ = concurrent.futures.wait(\n475:                     list(futures.values()),\n476:                     return_when=concurrent.futures.FIRST_COMPLETED,\n477:                 )\n478:                 for fut in done:\n479:                     idx = next(k for k, v in futures.items() if v is fut)\n480:                     del futures[idx]\n481:                     pending[idx] = fut.result()\n482:                 # Merge in chunk order up to the first failure.\n483:                 while next_merge in pending and not stopped:\n484:                     partial = pending.pop(next_merge)\n485:                     stopped = self._merge_partial(result, partial, acc)\n486:                     next_merge += 1\n487:                 fill()\n488: \n489: \n490: class Evaluator:\n491:     \"\"\"Computes fitness and work_ratio from verification results.\"\"\"\n492: \n493:     @staticmethod\n494:     def score(result: VerifyResult) -> tuple[float, float | None, bool]:\n495:         \"\"\"Return (fitness, work_ratio, is_efficiency_improvement).\"\"\"\n496:         is_improvement = (\n497:             result.fitness == 1.0\n498:             and result.work_ratio is not None\n499:             and result.work_ratio < 1.0\n500:         )\n501:         return result.fitness, result.work_ratio, is_improvement\n502: \n503: \n504: # ---------------------------------------------------------------------------\n505: # Per-chunk evaluation. Shared by the serial path (run in the parent) and the\n506: # parallel path (run in a worker process). The logic is the original serial\n507: # per-chunk loop, refactored so both paths produce byte-identical partial\n508: # results and therefore an identical merged VerifyResult.\n509: # ---------------------------------------------------------------------------\n510: \n511: def _worker_sandbox(ctx: dict[str, Any]) -> Sandbox:\n512:     \"\"\"Rebuild a Sandbox in a worker process (the parent's is not picklable).\"\"\"\n513:     return Sandbox(\n514:         timeout_seconds=ctx[\"timeout_seconds\"],\n515:         python_path=ctx[\"python_path\"],\n516:         directed=ctx[\"directed\"],\n517:     )\n518: \n519: \n520: def _worker_check_chunk(ctx: dict[str, Any], i: int, chunk_start: int,\n521:                         chunk_cases: list, chunk_meta: list) -> dict[str, Any]:\n522:     \"\"\"Worker entry point: rebuild trusted objects and check one chunk.\n523: \n524:     Runs in a pool worker process. It rebuilds the problem (via\n525:     ``get_problem``) and the sandbox from plain picklable context, then runs\n526:     the same per-chunk logic as the serial path. The candidate stays isolated\n527:     in its own sandbox subprocess, so the trust boundary is unchanged.\n528:     \"\"\"\n529:     from .problem_definitions import get_problem\n530: \n531:     problem = get_problem(ctx[\"problem_name\"])\n532:     sandbox = _worker_sandbox(ctx)\n533:     return _check_chunk_impl(\n534:         problem, sandbox, ctx[\"code_path\"], chunk_cases, chunk_meta,\n535:         chunk_start, ctx[\"root\"], ctx[\"offline_src\"], ctx[\"adaptive_repeat\"],\n536:     )\n537: \n538: \n539: HANG_PROBE_SECONDS = 3\n540: HANG_PROBE_MAX_GRAPHS = 400\n541: HANG_PROBE_BUDGET_SECONDS = 60  # total, per timed-out chunk\n542: \n543: \n544: def _locate_hang(sandbox: Sandbox, code_path, chunk_cases: list[dict[str, Any]],\n545:                  chunk_meta: list[tuple[int, int]], root: int | None) -> dict[str, Any] | None:\n546:     \"\"\"After a chunk timeout, find the first graph and sequence that hang.\n547: \n548:     Re-runs the chunk one base graph at a time (then one sequence at a time)\n549:     with a short timeout, so the reflector gets a concrete failing case\n550:     instead of just \"timeout\". Bounded: gives up after\n551:     ``HANG_PROBE_MAX_GRAPHS`` graphs or ``HANG_PROBE_BUDGET_SECONDS`` in total.\n552:     \"\"\"\n553:     deadline = time.monotonic() + HANG_PROBE_BUDGET_SECONDS\n554:     for case, (n, _num) in list(zip(chunk_cases, chunk_meta))[:HANG_PROBE_MAX_GRAPHS]:\n555:         if time.monotonic() > deadline:\n556:             return None\n557:         r = sandbox.execute_batch(code_path, [case], offline_src=\"\", root=root, repeat=1,\n558:                                   timeout=HANG_PROBE_SECONDS)\n559:         if not r.is_timeout:\n560:             continue\n561:         for seq_idx, seq in enumerate(case[\"sequences\"]):\n562:             if time.monotonic() > deadline:\n563:                 break\n564:             one = {\"graph\": case[\"graph\"], \"sequences\": [seq]}\n565:             r = sandbox.execute_batch(code_path, [one], offline_src=\"\", root=root, repeat=1,\n566:                                       timeout=HANG_PROBE_SECONDS)\n567:             if r.is_timeout:\n568:                 ops = [f\"{op['type']} ({op['edge'][0]}, {op['edge'][1]})\" for op in seq]\n569:                 return {\"graph_n\": n, \"graph\": case[\"graph\"], \"sequence_idx\": seq_idx,\n570:                         \"operations\": ops, \"note\": f\"no result within {HANG_PROBE_SECONDS}s: \"\n571:                         \"likely an infinite loop in init or one of these updates\"}\n572:         return {\"graph_n\": n, \"graph\": case[\"graph\"],\n573:                 \"note\": \"this graph's sequences together exceed the time limit\"}\n574:     return None\n575: \n576: \n577: def _check_chunk_impl(problem: ProblemDefinition, sandbox: Sandbox,\n578:                       code_path, chunk_cases: list[dict[str, Any]],\n579:                       chunk_meta: list[tuple[int, int]], chunk_start: int,\n580:                       root: int | None, offline_src: str,\n581:                       adaptive_repeat: int) -> dict[str, Any]:\n582:     \"\"\"Run one chunk's sandbox subprocess and check its invariants.\n583: \n584:     Returns a compact, picklable partial result:\n585:       - timeout: the whole chunk subprocess exceeded its wall-clock timeout\n586:       - chunk_crash: the subprocess crashed before producing any results\n587:       - tests_total / tests_passed: sequences accounted for / passed in this\n588:         chunk (counted up to the first failure, matching the serial loop)\n589:       - candidate_work / offline_work: summed timings for the counted sequences\n590:       - crash: a per-sequence crash was hit in this chunk\n591:       - failing_case: the first invariant failure (with its in-chunk position)\n592:         or the first crash; None if the chunk is fully clean\n593:     \"\"\"\n594:     batch_result = sandbox.execute_batch(\n595:         code_path, chunk_cases, offline_src=offline_src, root=root,\n596:         repeat=adaptive_repeat,\n597:     )\n598: \n599:     if batch_result.is_timeout:\n600:         return {\n601:             \"chunk_start\": chunk_start, \"timeout\": True,\n602:             \"tests_total\": 0, \"tests_passed\": 0,\n603:             \"candidate_work\": 0, \"offline_work\": 0,\n604:             \"crash\": False, \"chunk_crash\": False,\n605:             \"chunk_crash_error\": None, \"failing_case\": None,\n606:             \"hang\": _locate_hang(sandbox, code_path, chunk_cases, chunk_meta, root),\n607:         }\n608: \n609:     if batch_result.is_crash and not batch_result.all_results:\n610:         return {\n611:             \"chunk_start\": chunk_start, \"timeout\": False,\n612:             \"tests_total\": 0, \"tests_passed\": 0,\n613:             \"candidate_work\": 0, \"offline_work\": 0,\n614:             \"crash\": False, \"chunk_crash\": True,\n615:             \"chunk_crash_error\": batch_result.error, \"failing_case\": None,\n616:         }\n617: \n618:     all_results = batch_result.all_results or []\n619:     tests_total = 0\n620:     passed_tests = 0\n621:     candidate_work = 0\n622:     offline_work = 0\n623:     failing_case = None\n624:     crash = False\n625:     crash_error = None\n626: \n627:     for local_g_idx, (n, num_seqs) in enumerate(chunk_meta):\n628:         graph_results = all_results[local_g_idx] if local_g_idx < len(all_results) else []\n629:         original_graph = np.array(chunk_cases[local_g_idx][\"graph\"], dtype=int)\n630: \n631:         for seq_idx in range(num_seqs):\n632:             tests_total += 1\n633: \n634:             seq_result = graph_results[seq_idx] if seq_idx < len(graph_results) else None\n635:             if seq_result is None:\n636:                 failing_case = {\n637:                     \"graph_n\": n, \"sequence_idx\": seq_idx,\n638:                     \"operation\": \"missing result\",\n639:                 }\n640:                 break\n641: \n642:             if seq_result.get(\"status\") == \"crash\":\n643:                 crash = True\n644:                 crash_error = seq_result.get(\"error\")\n645:                 failing_case = {\n646:                     \"graph_n\": n, \"sequence_idx\": seq_idx,\n647:                     \"operation\": \"crash\",\n648:                     \"error\": seq_result.get(\"error\"),\n649:                 }\n650:                 break\n651: \n652:             # Use partial results if available (crash mid-sequence)\n653:             results = seq_result.get(\"results\") or seq_result.get(\"partial_results\") or []\n654:             candidate_times = seq_result.get(\"timings\") or seq_result.get(\"partial_timings\") or []\n655:             offline_times = seq_result.get(\"offline_timings\") or seq_result.get(\"partial_offline_timings\") or []\n656: \n657:             if not results:\n658:                 failing_case = {\n659:                     \"graph_n\": n, \"sequence_idx\": seq_idx,\n660:                     \"operation\": \"no results from sandbox\",\n661:                 }\n662:                 break\n663: \n664:             # Replay operations on a copy of the graph to check invariants.\n665:             # The sequence is recovered from the chunk's own test case (the\n666:             # ops list), so the worker needs no access to the parent's cache.\n667:             seq_ops = chunk_cases[local_g_idx][\"sequences\"][seq_idx]\n668:             current_graph = original_graph.copy()\n669: \n670:             # Check init state.\n671:             state = _deserialize_state(results[0][\"state\"])\n672:             if not _invariant_holds(problem, state, current_graph, root):\n673:                 failing_case = _failing_context(problem, state, current_graph, root)\n674:                 failing_case[\"graph_n\"] = n\n675:                 failing_case[\"sequence_idx\"] = seq_idx\n676:                 failing_case[\"operation\"] = \"init\"\n677:                 break\n678: \n679:             if candidate_times:\n680:                 candidate_work += candidate_times[0]\n681:             if offline_times:\n682:                 offline_work += offline_times[0]\n683: \n684:             # Check after each operation.\n685:             found = False\n686:             for step_idx, op in enumerate(seq_ops):\n687:                 op_type = op[\"type\"]\n688:                 u, v = op[\"edge\"]\n689:                 if op_type == \"insert\":\n690:                     current_graph[u, v] = 1\n691:                     if not problem.directed:\n692:                         current_graph[v, u] = 1\n693:                 elif op_type == \"delete\":\n694:                     current_graph[u, v] = 0\n695:                     if not problem.directed:\n696:                         current_graph[v, u] = 0\n697: \n698:                 step_result_idx = step_idx + 1\n699:                 if step_result_idx < len(results):\n700:                     state = _deserialize_state(results[step_result_idx][\"state\"])\n701:                     if not _invariant_holds(problem, state, current_graph, root):\n702:                         failing_case = _failing_context(problem, state, current_graph, root)\n703:                         failing_case[\"graph_n\"] = n\n704:                         failing_case[\"sequence_idx\"] = seq_idx\n705:                         failing_case[\"operation\"] = f\"{op_type} ({u}, {v})\"\n706:                         found = True\n707:                         break\n708: \n709:                 if step_result_idx < len(candidate_times):\n710:                     candidate_work += candidate_times[step_result_idx]\n711:                 if step_result_idx < len(offline_times):\n712:                     offline_work += offline_times[step_result_idx]\n713: \n714:             if found:\n715:                 break\n716: \n717:             passed_tests += 1\n718: \n719:         if failing_case is not None or crash:\n720:             break\n721: \n722:     return {\n723:         \"chunk_start\": chunk_start, \"timeout\": False,\n724:         \"tests_total\": tests_total, \"tests_passed\": passed_tests,\n725:         \"candidate_work\": candidate_work, \"offline_work\": offline_work,\n726:         \"crash\": crash, \"crash_error\": crash_error,\n727:         \"chunk_crash\": False, \"chunk_crash_error\": None,\n728:         \"failing_case\": failing_case,\n729:     }\n730: \n731: \n732: def _invariant_holds(problem: ProblemDefinition, state: Any, graph: np.ndarray,\n733:                      root: int | None) -> bool:\n734:     \"\"\"check_invariant that treats a malformed candidate state as a failure.\n735: \n736:     A candidate controls its state's shape; a checker exception on odd values\n737:     (wrong types, None where an int is expected) must fail that candidate, not\n738:     abort the whole run.\n739:     \"\"\"\n740:     try:\n741:         return bool(problem.check_invariant(state, graph, root))\n742:     except Exception:\n743:         return False\n744: \n745: \n746: def _failing_context(problem: ProblemDefinition, state: Any, graph: np.ndarray,\n747:                      root: int | None) -> dict[str, Any]:\n748:     \"\"\"failing_context that survives the malformed states _invariant_holds rejects.\"\"\"\n749:     try:\n750:         return problem.failing_context(state, graph, root)\n751:     except Exception as e:\n752:         return {\"problem\": problem.name, \"result\": repr(state)[:500],\n753:                 \"graph\": graph.tolist(), \"checker_error\": f\"{type(e).__name__}: {e}\"}\n754: \n755: \n756: def _deserialize_state(raw: Any) -> Any:\n757:     \"\"\"Convert JSON-deserialized state back to Python objects for invariant checking.\"\"\"\n758:     if isinstance(raw, dict):\n759:         return {k: _deserialize_state(v) for k, v in raw.items()}\n760:     if isinstance(raw, list):\n761:         # Could be a list of integers (set) or a list of lists (components)\n762:         return [_deserialize_state(x) for x in raw]\n763:     return raw\n764: \n765: \n766: def _update_candidate(candidate: Candidate, result: VerifyResult) -> None:\n767:     \"\"\"Update candidate fields from verification result.\"\"\"\n768:     candidate.fitness = result.fitness\n769:     candidate.work_ratio = result.work_ratio\n770:     candidate.timeout = result.timeout\n771:     candidate.tests_passed = result.tests_passed\n772:     candidate.tests_total = result.tests_total\n773:     candidate.error_message = result.error_message\n774:     candidate.failing_case = result.failing_case\n\n(End of file - total 774 lines)\n</content>","metadata":{"preview":"\"\"\"Verifier and Evaluator: test candidates against invariants.\n\nThe Verifier runs each candidate through the bounded test universe:\n  1. For each base graph in the test set\n  2. Generate operation sequences (insert/delete)\n  3. Execute candidate in sandbox (init + replay operations)\n  4. After each operation, check the invariant against the oracle\n  5. Record pass/fail, failing case, work counts\n\nThe Evaluator computes fitness (fraction of sequences passing) and\nwork_ratio (candidate_work / offline_work).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport concurrent.futures\nimport logging\nimport os\nimport time\nfrom dataclasses import dataclass, field","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/src/evoalgo/verifier.py","text":"\"\"\"Verifier and Evaluator: test candidates against invariants.\n\nThe Verifier runs each candidate through the bounded test universe:\n  1. For each base graph in the test set\n  2. Generate operation sequences (insert/delete)\n  3. Execute candidate in sandbox (init + replay operations)\n  4. After each operation, check the invariant against the oracle\n  5. Record pass/fail, failing case, work counts\n\nThe Evaluator computes fitness (fraction of sequences passing) and\nwork_ratio (candidate_work / offline_work).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport concurrent.futures\nimport logging\nimport os\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any\n\nimport numpy as np\n\nfrom .candidate import Candidate, CandidateState\nfrom .graph_generator import (\n    generate_test_graphs,\n    generate_operation_sequences,\n)\nfrom .problem_definitions import ProblemDefinition\nfrom .sandbox import Sandbox, SandboxResult\n\n# Default number of base graphs per sandbox subprocess. A chunk must finish\n# within the per-chunk timeout for a correct candidate, while a candidate that\n# loops forever on one case hits the timeout and fails fast. 2000 base graphs\n# is ~10-15 s for the slowest correct candidates (recompute-always BFS,\n# validate-or-rebuild DFS) at n<=5, well under a 30-60 s per-chunk timeout.\n#\n# When chunks are evaluated in parallel (workers > 1) the default chunk size is\n# halved (1000) so the work is split across more, smaller chunks: this balances\n# load across workers and keeps each chunk's wall time (and therefore its\n# per-chunk timeout) small, so a candidate that loops forever still fails fast.\nDEFAULT_CHUNK_SIZE = 2000\nDEFAULT_PARALLEL_CHUNK_SIZE = 1000\n\n\ndef _default_workers() -> int:\n    \"\"\"Default worker count: modest on a shared build server (80 cores).\"\"\"\n    cpu = os.cpu_count() or 1\n    return max(1, min(8, cpu))\n\nlogger = logging.getLogger(__name__)\n\n\ndef _exhaustive_flip_sequences(\n    n: int,\n    graph: np.ndarray,\n    directed: bool,\n    include_twins: bool = False,\n) -> list[list[tuple[str, tuple[int, int]]]]:\n    \"\"\"Deterministic short update sequences covering the update space.\n\n    Always returns all legal single-edge flips (each as a length-1 sequence):\n    this is \"every possible edge operation\" on the base graph. When\n    ``include_twins`` is True it additionally returns a compact set of length-2\n    paths (flip one edge, then flip each other edge).\n\n    The twins are O(n^4) per graph (380 at n=5) and are kept only for the small\n    labeled comparison universe, where they close the coverage hole left by\n    random sequences. For the nauty (non-isomorphic) universe the singles alone\n    already give exhaustive single-edge coverage, and the twins would make the\n    n=5 universe prohibitively expensive, so they default to off.\n    \"\"\"\n    pairs = [(u, v) for u in range(n) for v in range(n) if u != v and (directed or u < v)]\n    single: list[list[tuple[str, tuple[int, int]]]] = []\n    for u, v in pairs:\n        if graph[u, v]:\n            single.append([(\"delete\", (u, v))])\n        else:\n            single.append([(\"insert\", (u, v))])\n    if not include_twins:\n        return single\n    # length-2 paths: first flip (u,v), then flip (u',v') in the resulting graph\n    twins: list[list[tuple[str, tuple[int, int]]]] = []\n    for u, v in pairs:\n        flipped = graph.copy()\n        if flipped[u, v]:\n            flipped[u, v] = 0\n            if not directed:\n                flipped[v, u] = 0\n            first: tuple[str, tuple[int, int]] = (\"delete\", (u, v))\n        else:\n            flipped[u, v] = 1\n            if not directed:\n                flipped[v, u] = 1\n            first = (\"insert\", (u, v))\n        for u2, v2 in pairs:\n            if (u2, v2) == (u, v):\n                continue\n            if flipped[u2, v2]:\n                twins.append([first, (\"delete\", (u2, v2))])\n            else:\n                twins.append([first, (\"insert\", (u2, v2))])\n    return single + twins\n\n\n@dataclass\nclass VerifyResult:\n    \"\"\"Result of verifying one candidate.\"\"\"\n\n    candidate_id: str\n    state: CandidateState\n    fitness: float = 0.0\n    work_ratio: float | None = None\n    timeout: bool = False\n    tests_passed: int = 0\n    tests_total: int = 0\n    error_message: str | None = None\n    failing_case: dict[str, Any] | None = None\n    per_step_states: list[dict] = field(default_factory=list)\n\n\nclass Verifier:\n    \"\"\"Trusted correctness and efficiency tester.\"\"\"\n\n    def __init__(\n        self,\n        problem: ProblemDefinition,\n        sandbox: Sandbox,\n        bound_n_max: int = 5,\n        bound_n_random: int = 20,\n        bound_seq_len_max: int = 20,\n        bound_seq_count: int = 10,\n        bound_seed: int = 1337,\n        exhaustive_flip_n_max: int = 5,\n        chunk_size: int | None = None,\n        use_offline: bool = True,\n        universe: str = \"nauty\",\n        relabels_per_class: int = 2,\n        workers: int | None = None,\n        update_mode: str = \"mixed\",\n    ):\n        self.problem = problem\n        self.sandbox = sandbox\n        # update_mode restricts which edge operations the test sequences use:\n        # \"mixed\" (default, unchanged behaviour), \"insert_only\", \"delete_only\".\n        if update_mode not in (\"mixed\", \"insert_only\", \"delete_only\"):\n            raise ValueError(\n                f\"update_mode must be 'mixed', 'insert_only', or 'delete_only', \"\n                f\"got {update_mode!r}\"\n            )\n        self.update_mode = update_mode\n        self.n_max = bound_n_max\n        self.n_random = bound_n_random\n        self.seq_len_max = bound_seq_len_max\n        self.seq_count = bound_seq_count\n        self.seed = bound_seed\n        self.exhaustive_flip_n_max = exhaustive_flip_n_max\n        # Worker count for parallel chunk evaluation. workers=None -> a modest\n        # default (min(8, cpu)); workers=1 reproduces the original serial path\n        # exactly.\n        self.workers = _default_workers() if workers is None else max(1, workers)\n        # Chunk size: an explicit value is honored verbatim. None auto-tunes --\n        # the serial default (2000) for workers=1, or smaller chunks\n        # (DEFAULT_PARALLEL_CHUNK_SIZE) when parallelizing, so load balances\n        # across workers and the per-chunk timeout stays tight.\n        if chunk_size is not None:\n            self.chunk_size = chunk_size\n        elif self.workers > 1:\n            self.chunk_size = DEFAULT_PARALLEL_CHUNK_SIZE\n        else:\n            self.chunk_size = DEFAULT_CHUNK_SIZE\n        # The offline baseline is only needed for work_ratio; the self-test\n        # (known-good / faults / controls) skips it to keep wall time low.\n        self.use_offline = use_offline\n        self.universe = universe\n        self.relabels_per_class = relabels_per_class\n        # Exhaustive length-2 flip paths (twins) are O(n^4)/graph and are only\n        # affordable on the small labeled comparison universe. The nauty\n        # universe already covers every single-edge flip via the singles.\n        self.use_twins = (universe == \"labeled\")\n\n        # Cache test graphs (they don't change between candidates)\n        self._test_graphs: list[tuple[int, np.ndarray]] | None = None\n        self._test_sequences: dict[int, list[list[tuple[str, tuple[int, int]]]]] = {}\n        self._test_counts: dict[int, int] | None = None\n\n    @property\n    def test_graphs(self) -> list[tuple[int, np.ndarray]]:\n        if self._test_graphs is None:\n            self._test_graphs = generate_test_graphs(\n                self.n_max, self.n_random, self.seed,\n                directed=self.problem.directed,\n                universe=self.universe,\n                rooted=self.problem.needs_root,\n                relabels_per_class=self.relabels_per_class,\n            )\n            counts: dict[int, int] = {}\n            for n, _g in self._test_graphs:\n                counts[n] = counts.get(n, 0) + 1\n            self._test_counts = counts\n            logger.info(\"Generated %d test graphs (n=2..%d, %s, universe=%s): %s\",\n                        len(self._test_graphs), self.n_max,\n                        \"directed\" if self.problem.directed else \"undirected\",\n                        self.universe, counts)\n        return self._test_graphs\n\n    def test_counts(self) -> dict[int, int]:\n        \"\"\"Number of base test graphs per n (computed lazily with test_graphs).\"\"\"\n        self.test_graphs\n        return self._test_counts or {}\n\n    def get_sequences(self, n: int, graph: np.ndarray) -> list[list[tuple[str, tuple[int, int]]]]:\n        key = (n, graph.tobytes())\n        if key not in self._test_sequences:\n            seqs = generate_operation_sequences(\n                n, graph, self.seq_len_max, self.seq_count, self.seed + n,\n                directed=self.problem.directed,\n            )\n            # Deterministic exhaustive single-edge flips for small n (and, on\n            # the labeled comparison universe, a compact set of 2-flip paths).\n            # Random sequences alone missed reachable counterexamples (e.g. a\n            # single insert breaking dynamic MCS at n=3), so close that gap\n            # for the sizes where exhaustive coverage is cheap.\n            if n <= self.exhaustive_flip_n_max:\n                seqs = seqs + _exhaustive_flip_sequences(\n                    n, graph, self.problem.directed, include_twins=self.use_twins,\n                )\n            seqs = self._filter_sequences_for_mode(seqs, graph)\n            self._test_sequences[key] = seqs\n        return self._test_sequences[key]\n\n    def _filter_sequences_for_mode(\n        self,\n        seqs: list[list[tuple[str, tuple[int, int]]]],\n        graph: np.ndarray,\n    ) -> list[list[tuple[str, tuple[int, int]]]]:\n        \"\"\"Restrict sequences to the configured ``update_mode``.\n\n        \"mixed\" (the default) returns them unchanged. For \"insert_only\" /\n        \"delete_only\" each sequence is replayed on a copy of the base graph and\n        only the legal ops of the allowed type are kept, so the result is a\n        sequence that is still legal on the evolving graph. This is what lets a\n        pack declare a semi-dynamic (incremental or decremental-only) problem\n        without touching the sequence generators.\n        \"\"\"\n        if self.update_mode == \"mixed\":\n            return seqs\n        allowed = \"insert\" if self.update_mode == \"insert_only\" else \"delete\"\n        filtered: list[list[tuple[str, tuple[int, int]]]] = []\n        for seq in seqs:\n            current = graph.copy()\n            out: list[tuple[str, tuple[int, int]]] = []\n            for op_type, (u, v) in seq:\n                if op_type != allowed:\n                    continue\n                if allowed == \"insert\":\n                    if current[u, v]:\n                        continue\n                    current[u, v] = 1\n                    if not self.problem.directed:\n                        current[v, u] = 1\n                else:  # delete\n                    if not current[u, v]:\n                        continue\n                    current[u, v] = 0\n                    if not self.problem.directed:\n                        current[v, u] = 0\n                out.append((op_type, (u, v)))\n            filtered.append(out)\n        return filtered\n\n    def _offline_src(self) -> str:\n        \"\"\"Return the offline baseline source for the sandbox subprocess.\n\n        Uses the problem's offline_source property which provides a\n        self-contained function named offline_compute(graph, root).\n        \"\"\"\n        return self.problem.offline_source\n\n    def verify(self, candidate: Candidate) -> VerifyResult:\n        \"\"\"Run a candidate through the full test universe.\n\n        The test universe is split into chunks of ``chunk_size`` base graphs,\n        each executed in its own sandbox subprocess with its own wall-clock\n        timeout. This keeps a correct candidate's per-chunk run well under the\n        timeout (so the whole n<=5 universe passes), while a candidate that\n        loops forever on one case still hits the per-chunk timeout and fails\n        fast.\n\n        Chunks are evaluated in parallel (``workers`` process pool) when\n        ``workers > 1``. Each worker is trusted code: it runs the sandbox\n        subprocess for its chunk (the candidate stays isolated in its own\n        subprocess, so the trust boundary is unchanged) and checks that\n        chunk's invariants, returning a compact partial result. The parent\n        merges the partials deterministically in chunk order, stopping at the\n        first failing chunk: totals are the sum over all chunks before the\n        first failing chunk plus that chunk's partial, and ``failing_case`` is\n        the first failure. Chunks after a known earlier failure are ignored.\n        ``workers == 1`` runs the exact serial path (one chunk at a time in\n        the parent), so the result is identical to the original implementation.\n        \"\"\"\n        candidate.transition(CandidateState.TESTING)\n\n        result = VerifyResult(candidate_id=candidate.id, state=CandidateState.TESTING)\n\n        code_path = Path(candidate.code_path)\n        if not code_path.exists():\n            result.state = CandidateState.CRASH\n            result.error_message = f\"Candidate file not found: {code_path}\"\n            candidate.transition(CandidateState.CRASH)\n            candidate.error_message = result.error_message\n            return result\n\n        offline_src = self._offline_src() if self.use_offline else \"\"\n        root = 0 if self.problem.needs_root else None\n\n        # Build all test cases (graph + its sequences) in a stable order.\n        test_cases: list[dict[str, Any]] = []\n        graph_meta: list[tuple[int, int]] = []  # (n, num_sequences) per graph\n        total_steps = 0\n        for n, graph in self.test_graphs:\n            sequences = self.get_sequences(n, graph)\n            seq_list: list[list[dict]] = []\n            for seq in sequences:\n                ops = [{\"type\": op_type, \"edge\": list(edge)} for op_type, edge in seq]\n                seq_list.append(ops)\n                total_steps += 1 + len(seq)  # init + operations\n            test_cases.append({\n                \"graph\": graph.tolist(),\n                \"sequences\": seq_list,\n            })\n            graph_meta.append((n, len(sequences)))\n\n        # Adaptive REPEAT: keep total timed calls under a budget so timing\n        # stays meaningful without dominating wall time. Target ~500K total\n        # calls (candidate + offline), minimum REPEAT=1.\n        TIMING_BUDGET = 500_000\n        timing_multiplier = 2 if offline_src else 1\n        if total_steps > 0:\n            adaptive_repeat = max(1, TIMING_BUDGET // (total_steps * timing_multiplier))\n        else:\n            adaptive_repeat = 20\n        adaptive_repeat = min(adaptive_repeat, 20)  # cap at 20\n\n        # Split the test universe into chunks (each becomes one sandbox\n        # subprocess). chunk_args[i] = (i, chunk_start, chunk_cases, chunk_meta).\n        chunk_starts = list(range(0, len(test_cases), self.chunk_size)) or [0]\n        chunk_args = [\n            (i, chunk_start,\n             test_cases[chunk_start:chunk_start + self.chunk_size],\n             graph_meta[chunk_start:chunk_start + self.chunk_size])\n            for i, chunk_start in enumerate(chunk_starts)\n        ]\n\n        # Running totals, accumulated in chunk order by _merge_partial.\n        acc = {\"total\": 0, \"passed\": 0, \"cand_work\": 0, \"off_work\": 0}\n\n        if self.workers == 1:\n            # Serial path: one chunk at a time in the parent, in order.\n            for i, chunk_start, chunk_cases, chunk_meta in chunk_args:\n                partial = _check_chunk_impl(\n                    self.problem, self.sandbox, code_path, chunk_cases, chunk_meta,\n                    chunk_start, root, offline_src, adaptive_repeat,\n                )\n                if self._merge_partial(result, partial, acc):\n                    break\n        else:\n            # Parallel path: a sliding window of ``workers`` chunks in flight.\n            # Sandbox subprocesses run concurrently; partials are merged in\n            # chunk order so the result is identical to the serial path.\n            ctx = {\n                \"problem_name\": self.problem.name,\n                \"directed\": self.problem.directed,\n                \"root\": root,\n                \"offline_src\": offline_src,\n                \"adaptive_repeat\": adaptive_repeat,\n                \"code_path\": str(code_path),\n                \"timeout_seconds\": self.sandbox.timeout,\n                \"python_path\": self.sandbox.python,\n            }\n            self._merge_parallel(result, chunk_args, ctx, acc)\n\n        result.tests_total = acc[\"total\"]\n        result.tests_passed = acc[\"passed\"]\n\n        if result.error_message:\n            result.state = CandidateState.CRASH\n            candidate.transition(CandidateState.CRASH)\n            candidate.error_message = result.error_message\n        elif result.timeout:\n            result.state = CandidateState.FAIL\n            candidate.transition(CandidateState.FAIL)\n            candidate.timeout = True\n        elif result.failing_case:\n            result.state = CandidateState.FAIL\n            candidate.transition(CandidateState.FAIL)\n        else:\n            result.state = CandidateState.PASS\n            candidate.transition(CandidateState.PASS)\n\n        result.fitness = acc[\"passed\"] / acc[\"total\"] if acc[\"total\"] > 0 else 0.0\n        if acc[\"off_work\"] > 0:\n            result.work_ratio = acc[\"cand_work\"] / acc[\"off_work\"]\n        # else: leave work_ratio as None (no offline baseline to ratio against)\n\n        _update_candidate(candidate, result)\n        return result\n\n    def _merge_partial(self, result: VerifyResult, partial: dict[str, Any],\n                       acc: dict[str, int]) -> bool:\n        \"\"\"Merge one chunk's partial result into the running totals.\n\n        Returns True if verification should stop (this chunk timed out,\n        crashed, or found the first invariant failure). The merge is\n        deterministic in chunk order, so once it returns True, later chunks\n        cannot change the result and are ignored.\n        \"\"\"\n        if partial[\"timeout\"]:\n            result.timeout = True\n            result.failing_case = {\n                \"operation\": \"timeout\",\n                \"chunk_start\": partial[\"chunk_start\"],\n                **({\"hang\": partial[\"hang\"]} if partial.get(\"hang\") else {}),\n            }\n            return True\n        if partial[\"chunk_crash\"]:\n            result.error_message = partial[\"chunk_crash_error\"]\n            result.failing_case = {\"operation\": \"crash\", \"error\": partial[\"chunk_crash_error\"]}\n            return True\n        acc[\"total\"] += partial[\"tests_total\"]\n        acc[\"passed\"] += partial[\"tests_passed\"]\n        acc[\"cand_work\"] += partial[\"candidate_work\"]\n        acc[\"off_work\"] += partial[\"offline_work\"]\n        if partial[\"crash\"]:\n            result.error_message = partial[\"crash_error\"]\n            result.failing_case = partial[\"failing_case\"]\n            return True\n        if partial[\"failing_case\"] is not None:\n            result.failing_case = partial[\"failing_case\"]\n            return True\n        return False\n\n    def _merge_parallel(self, result: VerifyResult, chunk_args: list, ctx: dict,\n                        acc: dict[str, int]) -> None:\n        \"\"\"Evaluate chunks in a sliding window and merge in chunk order.\n\n        At most ``self.workers`` chunks are in flight at once. As chunks\n        complete (in wall-clock order) their partials are held until it is\n        their turn in chunk order, so the merge -- and therefore the result --\n        is identical to the serial path. Once a chunk fails, no further chunks\n        are submitted and the in-flight ones are drained and ignored.\n        \"\"\"\n        n_chunks = len(chunk_args)\n        futures: dict[int, concurrent.futures.Future] = {}\n        pending: dict[int, dict[str, Any]] = {}\n        next_submit = 0\n        next_merge = 0\n        stopped = False\n\n        def fill() -> None:\n            nonlocal next_submit\n            while next_submit < n_chunks and len(futures) < self.workers and not stopped:\n                i, chunk_start, chunk_cases, chunk_meta = chunk_args[next_submit]\n                futures[i] = pool.submit(\n                    _worker_check_chunk, ctx, i, chunk_start, chunk_cases, chunk_meta,\n                )\n                next_submit += 1\n\n        with concurrent.futures.ProcessPoolExecutor(max_workers=self.workers) as pool:\n            fill()\n            while futures:\n                done, _ = concurrent.futures.wait(\n                    list(futures.values()),\n                    return_when=concurrent.futures.FIRST_COMPLETED,\n                )\n                for fut in done:\n                    idx = next(k for k, v in futures.items() if v is fut)\n                    del futures[idx]\n                    pending[idx] = fut.result()\n                # Merge in chunk order up to the first failure.\n                while next_merge in pending and not stopped:\n                    partial = pending.pop(next_merge)\n                    stopped = self._merge_partial(result, partial, acc)\n                    next_merge += 1\n                fill()\n\n\nclass Evaluator:\n    \"\"\"Computes fitness and work_ratio from verification results.\"\"\"\n\n    @staticmethod\n    def score(result: VerifyResult) -> tuple[float, float | None, bool]:\n        \"\"\"Return (fitness, work_ratio, is_efficiency_improvement).\"\"\"\n        is_improvement = (\n            result.fitness == 1.0\n            and result.work_ratio is not None\n            and result.work_ratio < 1.0\n        )\n        return result.fitness, result.work_ratio, is_improvement\n\n\n# ---------------------------------------------------------------------------\n# Per-chunk evaluation. Shared by the serial path (run in the parent) and the\n# parallel path (run in a worker process). The logic is the original serial\n# per-chunk loop, refactored so both paths produce byte-identical partial\n# results and therefore an identical merged VerifyResult.\n# ---------------------------------------------------------------------------\n\ndef _worker_sandbox(ctx: dict[str, Any]) -> Sandbox:\n    \"\"\"Rebuild a Sandbox in a worker process (the parent's is not picklable).\"\"\"\n    return Sandbox(\n        timeout_seconds=ctx[\"timeout_seconds\"],\n        python_path=ctx[\"python_path\"],\n        directed=ctx[\"directed\"],\n    )\n\n\ndef _worker_check_chunk(ctx: dict[str, Any], i: int, chunk_start: int,\n                        chunk_cases: list, chunk_meta: list) -> dict[str, Any]:\n    \"\"\"Worker entry point: rebuild trusted objects and check one chunk.\n\n    Runs in a pool worker process. It rebuilds the problem (via\n    ``get_problem``) and the sandbox from plain picklable context, then runs\n    the same per-chunk logic as the serial path. The candidate stays isolated\n    in its own sandbox subprocess, so the trust boundary is unchanged.\n    \"\"\"\n    from .problem_definitions import get_problem\n\n    problem = get_problem(ctx[\"problem_name\"])\n    sandbox = _worker_sandbox(ctx)\n    return _check_chunk_impl(\n        problem, sandbox, ctx[\"code_path\"], chunk_cases, chunk_meta,\n        chunk_start, ctx[\"root\"], ctx[\"offline_src\"], ctx[\"adaptive_repeat\"],\n    )\n\n\nHANG_PROBE_SECONDS = 3\nHANG_PROBE_MAX_GRAPHS = 400\nHANG_PROBE_BUDGET_SECONDS = 60  # total, per timed-out chunk\n\n\ndef _locate_hang(sandbox: Sandbox, code_path, chunk_cases: list[dict[str, Any]],\n                 chunk_meta: list[tuple[int, int]], root: int | None) -> dict[str, Any] | None:\n    \"\"\"After a chunk timeout, find the first graph and sequence that hang.\n\n    Re-runs the chunk one base graph at a time (then one sequence at a time)\n    with a short timeout, so the reflector gets a concrete failing case\n    instead of just \"timeout\". Bounded: gives up after\n    ``HANG_PROBE_MAX_GRAPHS`` graphs or ``HANG_PROBE_BUDGET_SECONDS`` in total.\n    \"\"\"\n    deadline = time.monotonic() + HANG_PROBE_BUDGET_SECONDS\n    for case, (n, _num) in list(zip(chunk_cases, chunk_meta))[:HANG_PROBE_MAX_GRAPHS]:\n        if time.monotonic() > deadline:\n            return None\n        r = sandbox.execute_batch(code_path, [case], offline_src=\"\", root=root, repeat=1,\n                                  timeout=HANG_PROBE_SECONDS)\n        if not r.is_timeout:\n            continue\n        for seq_idx, seq in enumerate(case[\"sequences\"]):\n            if time.monotonic() > deadline:\n                break\n            one = {\"graph\": case[\"graph\"], \"sequences\": [seq]}\n            r = sandbox.execute_batch(code_path, [one], offline_src=\"\", root=root, repeat=1,\n                                      timeout=HANG_PROBE_SECONDS)\n            if r.is_timeout:\n                ops = [f\"{op['type']} ({op['edge'][0]}, {op['edge'][1]})\" for op in seq]\n                return {\"graph_n\": n, \"graph\": case[\"graph\"], \"sequence_idx\": seq_idx,\n                        \"operations\": ops, \"note\": f\"no result within {HANG_PROBE_SECONDS}s: \"\n                        \"likely an infinite loop in init or one of these updates\"}\n        return {\"graph_n\": n, \"graph\": case[\"graph\"],\n                \"note\": \"this graph's sequences together exceed the time limit\"}\n    return None\n\n\ndef _check_chunk_impl(problem: ProblemDefinition, sandbox: Sandbox,\n                      code_path, chunk_cases: list[dict[str, Any]],\n                      chunk_meta: list[tuple[int, int]], chunk_start: int,\n                      root: int | None, offline_src: str,\n                      adaptive_repeat: int) -> dict[str, Any]:\n    \"\"\"Run one chunk's sandbox subprocess and check its invariants.\n\n    Returns a compact, picklable partial result:\n      - timeout: the whole chunk subprocess exceeded its wall-clock timeout\n      - chunk_crash: the subprocess crashed before producing any results\n      - tests_total / tests_passed: sequences accounted for / passed in this\n        chunk (counted up to the first failure, matching the serial loop)\n      - candidate_work / offline_work: summed timings for the counted sequences\n      - crash: a per-sequence crash was hit in this chunk\n      - failing_case: the first invariant failure (with its in-chunk position)\n        or the first crash; None if the chunk is fully clean\n    \"\"\"\n    batch_result = sandbox.execute_batch(\n        code_path, chunk_cases, offline_src=offline_src, root=root,\n        repeat=adaptive_repeat,\n    )\n\n    if batch_result.is_timeout:\n        return {\n            \"chunk_start\": chunk_start, \"timeout\": True,\n            \"tests_total\": 0, \"tests_passed\": 0,\n            \"candidate_work\": 0, \"offline_work\": 0,\n            \"crash\": False, \"chunk_crash\": False,\n            \"chunk_crash_error\": None, \"failing_case\": None,\n            \"hang\": _locate_hang(sandbox, code_path, chunk_cases, chunk_meta, root),\n        }\n\n    if batch_result.is_crash and not batch_result.all_results:\n        return {\n            \"chunk_start\": chunk_start, \"timeout\": False,\n            \"tests_total\": 0, \"tests_passed\": 0,\n            \"candidate_work\": 0, \"offline_work\": 0,\n            \"crash\": False, \"chunk_crash\": True,\n            \"chunk_crash_error\": batch_result.error, \"failing_case\": None,\n        }\n\n    all_results = batch_result.all_results or []\n    tests_total = 0\n    passed_tests = 0\n    candidate_work = 0\n    offline_work = 0\n    failing_case = None\n    crash = False\n    crash_error = None\n\n    for local_g_idx, (n, num_seqs) in enumerate(chunk_meta):\n        graph_results = all_results[local_g_idx] if local_g_idx < len(all_results) else []\n        original_graph = np.array(chunk_cases[local_g_idx][\"graph\"], dtype=int)\n\n        for seq_idx in range(num_seqs):\n            tests_total += 1\n\n            seq_result = graph_results[seq_idx] if seq_idx < len(graph_results) else None\n            if seq_result is None:\n                failing_case = {\n                    \"graph_n\": n, \"sequence_idx\": seq_idx,\n                    \"operation\": \"missing result\",\n                }\n                break\n\n            if seq_result.get(\"status\") == \"crash\":\n                crash = True\n                crash_error = seq_result.get(\"error\")\n                failing_case = {\n                    \"graph_n\": n, \"sequence_idx\": seq_idx,\n                    \"operation\": \"crash\",\n                    \"error\": seq_result.get(\"error\"),\n                }\n                break\n\n            # Use partial results if available (crash mid-sequence)\n            results = seq_result.get(\"results\") or seq_result.get(\"partial_results\") or []\n            candidate_times = seq_result.get(\"timings\") or seq_result.get(\"partial_timings\") or []\n            offline_times = seq_result.get(\"offline_timings\") or seq_result.get(\"partial_offline_timings\") or []\n\n            if not results:\n                failing_case = {\n                    \"graph_n\": n, \"sequence_idx\": seq_idx,\n                    \"operation\": \"no results from sandbox\",\n                }\n                break\n\n            # Replay operations on a copy of the graph to check invariants.\n            # The sequence is recovered from the chunk's own test case (the\n            # ops list), so the worker needs no access to the parent's cache.\n            seq_ops = chunk_cases[local_g_idx][\"sequences\"][seq_idx]\n            current_graph = original_graph.copy()\n\n            # Check init state.\n            state = _deserialize_state(results[0][\"state\"])\n            if not _invariant_holds(problem, state, current_graph, root):\n                failing_case = _failing_context(problem, state, current_graph, root)\n                failing_case[\"graph_n\"] = n\n                failing_case[\"sequence_idx\"] = seq_idx\n                failing_case[\"operation\"] = \"init\"\n                break\n\n            if candidate_times:\n                candidate_work += candidate_times[0]\n            if offline_times:\n                offline_work += offline_times[0]\n\n            # Check after each operation.\n            found = False\n            for step_idx, op in enumerate(seq_ops):\n                op_type = op[\"type\"]\n                u, v = op[\"edge\"]\n                if op_type == \"insert\":\n                    current_graph[u, v] = 1\n                    if not problem.directed:\n                        current_graph[v, u] = 1\n                elif op_type == \"delete\":\n                    current_graph[u, v] = 0\n                    if not problem.directed:\n                        current_graph[v, u] = 0\n\n                step_result_idx = step_idx + 1\n                if step_result_idx < len(results):\n                    state = _deserialize_state(results[step_result_idx][\"state\"])\n                    if not _invariant_holds(problem, state, current_graph, root):\n                        failing_case = _failing_context(problem, state, current_graph, root)\n                        failing_case[\"graph_n\"] = n\n                        failing_case[\"sequence_idx\"] = seq_idx\n                        failing_case[\"operation\"] = f\"{op_type} ({u}, {v})\"\n                        found = True\n                        break\n\n                if step_result_idx < len(candidate_times):\n                    candidate_work += candidate_times[step_result_idx]\n                if step_result_idx < len(offline_times):\n                    offline_work += offline_times[step_result_idx]\n\n            if found:\n                break\n\n            passed_tests += 1\n\n        if failing_case is not None or crash:\n            break\n\n    return {\n        \"chunk_start\": chunk_start, \"timeout\": False,\n        \"tests_total\": tests_total, \"tests_passed\": passed_tests,\n        \"candidate_work\": candidate_work, \"offline_work\": offline_work,\n        \"crash\": crash, \"crash_error\": crash_error,\n        \"chunk_crash\": False, \"chunk_crash_error\": None,\n        \"failing_case\": failing_case,\n    }\n\n\ndef _invariant_holds(problem: ProblemDefinition, state: Any, graph: np.ndarray,\n                     root: int | None) -> bool:\n    \"\"\"check_invariant that treats a malformed candidate state as a failure.\n\n    A candidate controls its state's shape; a checker exception on odd values\n    (wrong types, None where an int is expected) must fail that candidate, not\n    abort the whole run.\n    \"\"\"\n    try:\n        return bool(problem.check_invariant(state, graph, root))\n    except Exception:\n        return False\n\n\ndef _failing_context(problem: ProblemDefinition, state: Any, graph: np.ndarray,\n                     root: int | None) -> dict[str, Any]:\n    \"\"\"failing_context that survives the malformed states _invariant_holds rejects.\"\"\"\n    try:\n        return problem.failing_context(state, graph, root)\n    except Exception as e:\n        return {\"problem\": problem.name, \"result\": repr(state)[:500],\n                \"graph\": graph.tolist(), \"checker_error\": f\"{type(e).__name__}: {e}\"}\n\n\ndef _deserialize_state(raw: Any) -> Any:\n    \"\"\"Convert JSON-deserialized state back to Python objects for invariant checking.\"\"\"\n    if isinstance(raw, dict):\n        return {k: _deserialize_state(v) for k, v in raw.items()}\n    if isinstance(raw, list):\n        # Could be a list of integers (set) or a list of lists (components)\n        return [_deserialize_state(x) for x in raw]\n    return raw\n\n\ndef _update_candidate(candidate: Candidate, result: VerifyResult) -> None:\n    \"\"\"Update candidate fields from verification result.\"\"\"\n    candidate.fitness = result.fitness\n    candidate.work_ratio = result.work_ratio\n    candidate.timeout = result.timeout\n    candidate.tests_passed = result.tests_passed\n    candidate.tests_total = result.tests_total\n    candidate.error_message = result.error_message\n    candidate.failing_case = result.failing_case","lineStart":1,"lineEnd":774,"totalLines":774,"truncated":false}},"title":"src/evoalgo/verifier.py","time":{"start":1792501508227,"end":1792501508273}},"id":"prt_1596a67f4001myQzGnZWvnpPiQ","sessionID":"ses_ea696572dffe59PLAKRjMwErzJ","messageID":"msg_1596a63a8001QBSw4ZKzKAoNIW"}}
