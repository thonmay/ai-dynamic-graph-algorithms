{"type":"tool_use","timestamp":1792502054268,"sessionID":"ses_ea696572dffe59PLAKRjMwErzJ","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-98ff1b830f4e6883","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/src/evoalgo/graph_generator.py"},"output":"<path>/home/ethomdt/thesis/src/evoalgo/graph_generator.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Graph generation for the bounded test universe.\n2: \n3: Directed problems (BFS, DFS, SCC, reachability) default to an\n4: exhaustive-up-to-isomorphism universe built from the nauty data files in\n5: ``data/nauty/`` (``directed_n<n>.d6`` = all non-isomorphic loop-free digraphs\n6: on n vertices, OEIS A000273; ``rooted_n<n>.d6`` = one representative per\n7: (digraph, root-orbit) class with the root relabeled to vertex 0, OEIS A353996).\n8: For each class we also apply k deterministic random relabelings (vertex\n9: permutations) to catch label-dependent bugs such as id tie-breaks. For\n10: rooted problems the base classes are the rooted files (one case per root\n11: orbit); for unrooted problems they are the unrooted files.\n12: \n13: Undirected problems (MCS) keep the previous behaviour: all labeled graphs for\n14: n <= exhaustive_cap (5), then non-isomorphic ``geng`` representatives from\n15: ``undirected_n<n>.g6`` for larger n, then seeded random samples when no data\n16: file exists.\n17: \n18: ``universe=\"labeled\"`` reproduces the old directed behaviour (all labeled\n19: digraphs for n <= 4, random samples beyond) and is kept only for comparison.\n20: \n21: nauty data provenance, counts, and generation commands: see\n22: ``data/nauty/README.md``.\n23: \"\"\"\n24: \n25: from __future__ import annotations\n26: \n27: import random\n28: from pathlib import Path\n29: from typing import Iterator\n30: \n31: import numpy as np\n32: \n33: NAUTY_DATA_DIR = Path(__file__).parent / \"data\" / \"nauty\"\n34: \n35: \n36: # ---------------------------------------------------------------------------\n37: # Labeled enumeration (old mode, kept for comparison)\n38: # ---------------------------------------------------------------------------\n39: \n40: def enumerate_digraphs(n: int) -> Iterator[np.ndarray]:\n41:     \"\"\"Yield all labeled loop-free digraphs on n vertices as adjacency matrices.\n42: \n43:     For directed graphs: each off-diagonal entry is 0 or 1 independently.\n44:     Count: 2^(n*(n-1)).\n45:     \"\"\"\n46:     pairs = n * (n - 1)  # directed: n*(n-1) possible edges\n47:     for bits in range(2**pairs):\n48:         mat = np.zeros((n, n), dtype=int)\n49:         idx = 0\n50:         for i in range(n):\n51:             for j in range(n):\n52:                 if i != j:\n53:                     mat[i, j] = (bits >> idx) & 1\n54:                     idx += 1\n55:         yield mat\n56: \n57: \n58: def enumerate_undirected_graphs(n: int) -> Iterator[np.ndarray]:\n59:     \"\"\"Yield all labeled loop-free undirected graphs on n vertices.\n60: \n61:     For undirected: only upper triangle entries are free.\n62:     Count: 2^(n*(n-1)/2).\n63:     \"\"\"\n64:     pairs = n * (n - 1) // 2\n65:     for bits in range(2**pairs):\n66:         mat = np.zeros((n, n), dtype=int)\n67:         idx = 0\n68:         for i in range(n):\n69:             for j in range(i + 1, n):\n70:                 val = (bits >> idx) & 1\n71:                 mat[i, j] = val\n72:                 mat[j, i] = val\n73:                 idx += 1\n74:         yield mat\n75: \n76: \n77: def sample_digraphs(n: int, count: int, seed: int, p: float = 0.3) -> list[np.ndarray]:\n78:     \"\"\"Sample random loop-free digraphs with edge probability p.\"\"\"\n79:     rng = random.Random(seed)\n80:     graphs = []\n81:     for _ in range(count):\n82:         mat = np.zeros((n, n), dtype=int)\n83:         for i in range(n):\n84:             for j in range(n):\n85:                 if i != j and rng.random() < p:\n86:                     mat[i, j] = 1\n87:         graphs.append(mat)\n88:     return graphs\n89: \n90: \n91: def sample_undirected_graphs(n: int, count: int, seed: int, p: float = 0.3) -> list[np.ndarray]:\n92:     \"\"\"Sample random loop-free undirected graphs with edge probability p.\"\"\"\n93:     rng = random.Random(seed)\n94:     graphs = []\n95:     for _ in range(count):\n96:         mat = np.zeros((n, n), dtype=int)\n97:         for i in range(n):\n98:             for j in range(i + 1, n):\n99:                 if rng.random() < p:\n100:                     mat[i, j] = 1\n101:                     mat[j, i] = 1\n102:         graphs.append(mat)\n103:     return graphs\n104: \n105: \n106: # ---------------------------------------------------------------------------\n107: # nauty encodings\n108: # ---------------------------------------------------------------------------\n109: \n110: def decode_graph6(line: str) -> tuple[int, np.ndarray]:\n111:     \"\"\"Decode one graph6 string (nauty format) into (n, adjacency matrix).\n112: \n113:     graph6 packs the upper triangle of the adjacency matrix into 6-bit\n114:     characters (offset 63). The first 1-3 chars encode n.\n115:     \"\"\"\n116:     vals = [ord(c) - 63 for c in line.strip()]\n117:     if not vals or any(v < 0 or v > 63 for v in vals):\n118:         raise ValueError(f\"invalid graph6 line: {line!r}\")\n119:     if vals[0] <= 62:\n120:         n, k = vals[0], 1\n121:     elif vals[0] == 63:\n122:         if len(vals) < 4:\n123:             raise ValueError(f\"truncated graph6 long header: {line!r}\")\n124:         n = (vals[1] << 12) | (vals[2] << 6) | vals[3]\n125:         k = 4\n126:     else:\n127:         raise ValueError(f\"invalid graph6 header: {line!r}\")\n128:     bits = []\n129:     for v in vals[k:]:\n130:         bits.extend((v >> b) & 1 for b in range(5, -1, -1))\n131:     if len(bits) < n * (n - 1) // 2:\n132:         raise ValueError(f\"truncated graph6 line: {line!r}\")\n133:     mat = np.zeros((n, n), dtype=int)\n134:     idx = 0\n135:     for i in range(n):\n136:         for j in range(i + 1, n):\n137:             if bits[idx]:\n138:                 mat[i, j] = mat[j, i] = 1\n139:             idx += 1\n140:     return n, mat\n141: \n142: \n143: def decode_digraph6(line: str) -> tuple[int, list[int]]:\n144:     \"\"\"Decode one digraph6 line (nauty format) into (n, rows).\n145: \n146:     digraph6 packs the full n x n adjacency matrix (row by row, arc i->j is\n147:     bit j of row i) into 6-bit characters (offset 63). The first character is\n148:     ``&`` (38); the next encodes n (n<=62: single byte n+63). ``rows[i]`` is\n149:     the out-arc bitmask of vertex i (bit j set iff arc i->j exists).\n150: \n151:     Long headers (``~``) for n>62 are not needed for the committed data\n152:     (n<=5) and raise if encountered.\n153:     \"\"\"\n154:     s = line.strip()\n155:     if not s or s[0] != \"&\":\n156:         raise ValueError(f\"not digraph6: {line!r}\")\n157:     rest = s[1:]\n158:     if not rest or rest[0] == \"~\":\n159:         raise ValueError(f\"digraph6 long header (n>62) not supported: {line!r}\")\n160:     n = ord(rest[0]) - 63\n161:     if n < 1:\n162:         raise ValueError(f\"invalid digraph6 header: {line!r}\")\n163:     bits = []\n164:     for c in rest[1:]:\n165:         v = ord(c) - 63\n166:         if v < 0 or v > 63:\n167:             raise ValueError(f\"invalid digraph6 body: {line!r}\")\n168:         for b in range(5, -1, -1):  # big-endian: first bit of group is MSB\n169:             bits.append((v >> b) & 1)\n170:     if len(bits) < n * n:\n171:         raise ValueError(f\"truncated digraph6 line: {line!r}\")\n172:     rows = []\n173:     for i in range(n):\n174:         row = 0\n175:         for j in range(n):\n176:             if bits[i * n + j]:\n177:                 row |= (1 << j)\n178:         rows.append(row)\n179:     return n, rows\n180: \n181: \n182: def encode_digraph6(n: int, rows: list[int]) -> str:\n183:     \"\"\"Inverse of :func:`decode_digraph6`: (n, rows) -> digraph6 string.\n184: \n185:     Used only for round-trip self-tests.\n186:     \"\"\"\n187:     bits = []\n188:     for i in range(n):\n189:         for j in range(n):\n190:             bits.append((rows[i] >> j) & 1)\n191:     while len(bits) % 6:\n192:         bits.append(0)\n193:     out = [\"&\", chr(n + 63)]\n194:     for g in range(0, len(bits), 6):\n195:         v = 0\n196:         for b in range(5, -1, -1):\n197:             v = (v << 1) | bits[g + (5 - b)]\n198:         out.append(chr(v + 63))\n199:     return \"\".join(out)\n200: \n201: \n202: def digraph_rows_to_matrix(n: int, rows: list[int]) -> np.ndarray:\n203:     \"\"\"Convert digraph6 out-arc bitmasks to an n x n 0/1 adjacency matrix.\"\"\"\n204:     return np.array([[(rows[i] >> j) & 1 for j in range(n)] for i in range(n)], dtype=int)\n205: \n206: \n207: def relabel_digraph(graph: np.ndarray, perm: tuple[int, ...]) -> np.ndarray:\n208:     \"\"\"Apply a vertex permutation to a digraph adjacency matrix.\n209: \n210:     ``perm[i]`` is the new label of old vertex i. Arc i->j becomes\n211:     perm[i]->perm[j]. The result is isomorphic to ``graph``; when ``perm`` is\n212:     the identity it is unchanged. Used to produce deterministic label\n213:     variants of a nauty representative so the verifier also exercises\n214:     label-dependent behaviour (e.g. id tie-breaks).\n215:     \"\"\"\n216:     n = graph.shape[0]\n217:     out = np.zeros((n, n), dtype=int)\n218:     for i in range(n):\n219:         for j in range(n):\n220:             if graph[i, j]:\n221:                 out[perm[i], perm[j]] = 1\n222:     return out\n223: \n224: \n225: def _relabel_permutations(n: int, seed: int, k: int) -> list[tuple[int, ...]]:\n226:     \"\"\"Return up to k distinct non-identity vertex permutations of range(n).\n227: \n228:     Deterministic in (seed, n, k): the same call always yields the same\n229:     permutations, so the test universe is reproducible across runs.\n230:     \"\"\"\n231:     if k <= 0:\n232:         return []\n233:     rng = random.Random(seed * 1_000_003 + n)\n234:     identity = tuple(range(n))\n235:     perms: list[tuple[int, ...]] = []\n236:     seen: set[tuple[int, ...]] = set()\n237:     attempts = 0\n238:     while len(perms) < k and attempts < 1000:\n239:         attempts += 1\n240:         p = list(range(n))\n241:         rng.shuffle(p)\n242:         p = tuple(p)\n243:         if p == identity or p in seen:\n244:             continue\n245:         seen.add(p)\n246:         perms.append(p)\n247:     return perms\n248: \n249: \n250: # ---------------------------------------------------------------------------\n251: # nauty loaders\n252: # ---------------------------------------------------------------------------\n253: \n254: def load_nauty_graphs(n: int) -> list[np.ndarray] | None:\n255:     \"\"\"Load non-isomorphic undirected graphs of size n from the nauty data file.\n256: \n257:     Returns None if no data file exists for that size (caller falls back to\n258:     random sampling). Files are graph6, one graph per line, produced by\n259:     `geng n` (see data/nauty/README.md).\n260:     \"\"\"\n261:     path = NAUTY_DATA_DIR / f\"undirected_n{n}.g6\"\n262:     if not path.exists():\n263:         return None\n264:     graphs = []\n265:     for line in path.read_text().splitlines():\n266:         if line.strip():\n267:             gn, mat = decode_graph6(line)\n268:             if gn != n:\n269:                 raise ValueError(f\"{path.name}: expected n={n}, got n={gn}\")\n270:             graphs.append(mat)\n271:     if not graphs:\n272:         raise ValueError(f\"{path} exists but contains no graphs\")\n273:     return graphs\n274: \n275: \n276: def _load_nauty_digraphs(n: int, prefix: str) -> list[np.ndarray] | None:\n277:     \"\"\"Load digraph6 representatives of size n from ``<prefix>_n<n>.d6``.\n278: \n279:     ``prefix`` is ``directed`` (unrooted, OEIS A000273) or ``rooted`` (one\n280:     representative per (digraph, root-orbit) class with the root at vertex 0,\n281:     OEIS A353996). Returns None if no data file exists for that size.\n282:     \"\"\"\n283:     path = NAUTY_DATA_DIR / f\"{prefix}_n{n}.d6\"\n284:     if not path.exists():\n285:         return None\n286:     graphs = []\n287:     for line in path.read_text().splitlines():\n288:         if line.strip():\n289:             dn, rows = decode_digraph6(line)\n290:             if dn != n:\n291:                 raise ValueError(f\"{path.name}: expected n={n}, got n={dn}\")\n292:             graphs.append(digraph_rows_to_matrix(n, rows))\n293:     if not graphs:\n294:         raise ValueError(f\"{path} exists but contains no digraphs\")\n295:     return graphs\n296: \n297: \n298: def load_nauty_digraphs(n: int) -> list[np.ndarray] | None:\n299:     \"\"\"All non-isomorphic loop-free digraphs of size n (unrooted reps).\"\"\"\n300:     return _load_nauty_digraphs(n, \"directed\")\n301: \n302: \n303: def load_nauty_rooted_digraphs(n: int) -> list[np.ndarray] | None:\n304:     \"\"\"One representative per (digraph, root-orbit) class of size n.\n305: \n306:     The distinguished vertex (root) is relabeled to vertex 0 in each\n307:     representative, so a rooted problem can fix its source at 0 and still\n308:     cover every root orbit exactly once.\n309:     \"\"\"\n310:     return _load_nauty_digraphs(n, \"rooted\")\n311: \n312: \n313: # ---------------------------------------------------------------------------\n314: # Universe assembly\n315: # ---------------------------------------------------------------------------\n316: \n317: def generate_test_graphs(\n318:     n_max: int,\n319:     n_random: int,\n320:     seed: int,\n321:     directed: bool,\n322:     exhaustive_cap: int | None = None,\n323:     universe: str = \"nauty\",\n324:     rooted: bool = False,\n325:     relabels_per_class: int = 2,\n326: ) -> list[tuple[int, np.ndarray]]:\n327:     \"\"\"Generate the bounded test universe of base graphs.\n328: \n329:     Returns a list of (n, adjacency_matrix) pairs.\n330: \n331:     Directed, ``universe=\"nauty\"`` (default): for each n with a data file,\n332:     every non-isomorphic representative (rooted files for rooted problems,\n333:     unrooted otherwise) plus ``relabels_per_class`` deterministic random\n334:     relabelings of each representative. For n with no data file, seeded\n335:     random samples. This is the exhaustive-up-to-isomorphism universe.\n336: \n337:     Directed, ``universe=\"labeled\"`` (comparison only): all labeled digraphs\n338:     for n <= exhaustive_cap (4), random samples beyond.\n339: \n340:     Undirected (any universe): all labeled graphs for n <= exhaustive_cap\n341:     (5), then non-isomorphic ``geng`` representatives from the data files for\n342:     larger n, then seeded random samples when no data file exists. This path\n343:     is unchanged from the original so MCS behaviour is preserved.\n344:     \"\"\"\n345:     if exhaustive_cap is None:\n346:         exhaustive_cap = 4 if directed else 5\n347:     result: list[tuple[int, np.ndarray]] = []\n348:     rng_seed = seed\n349: \n350:     for n in range(2, n_max + 1):\n351:         if directed:\n352:             if universe == \"labeled\":\n353:                 if n <= exhaustive_cap:\n354:                     for g in enumerate_digraphs(n):\n355:                         result.append((n, g))\n356:                 else:\n357:                     for g in sample_digraphs(n, min(n_random, 200), rng_seed):\n358:                         result.append((n, g))\n359:                     rng_seed += 1\n360:             else:  # \"nauty\"\n361:                 loader = load_nauty_rooted_digraphs if rooted else load_nauty_digraphs\n362:                 reps = loader(n)\n363:                 if reps is None:\n364:                     for g in sample_digraphs(n, min(n_random, 200), rng_seed):\n365:                         result.append((n, g))\n366:                     rng_seed += 1\n367:                     continue\n368:                 for g in reps:\n369:                     result.append((n, g))\n370:                     for perm in _relabel_permutations(n, seed, relabels_per_class):\n371:                         result.append((n, relabel_digraph(g, perm)))\n372:         else:\n373:             # Undirected: preserve the original labelled/nauty/sampled mix.\n374:             if n <= exhaustive_cap:\n375:                 for g in enumerate_undirected_graphs(n):\n376:                     result.append((n, g))\n377:             else:\n378:                 nauty = load_nauty_graphs(n)\n379:                 if nauty is not None:\n380:                     for g in nauty:\n381:                         result.append((n, g))\n382:                 else:\n383:                     for g in sample_undirected_graphs(n, min(n_random, 200), rng_seed):\n384:                         result.append((n, g))\n385:                     rng_seed += 1\n386: \n387:     return result\n388: \n389: \n390: def generate_operation_sequences(\n391:     n: int,\n392:     graph: np.ndarray,\n393:     seq_len_max: int,\n394:     seq_count: int,\n395:     seed: int,\n396:     directed: bool = True,\n397: ) -> list[list[tuple[str, tuple[int, int]]]]:\n398:     \"\"\"Generate bounded sequences of edge insertions and deletions.\n399: \n400:     Each operation is ('insert', (u, v)) or ('delete', (u, v)).\n401:     Operations are legal: insert only if edge absent, delete only if present.\n402:     \"\"\"\n403:     rng = random.Random(seed)\n404:     sequences = []\n405: \n406:     for s in range(seq_count):\n407:         seq = []\n408:         current = graph.copy()\n409:         for _ in range(seq_len_max):\n410:             # Pick a random non-diagonal cell\n411:             u = rng.randint(0, n - 1)\n412:             v = rng.randint(0, n - 1)\n413:             while v == u:\n414:                 v = rng.randint(0, n - 1)\n415: \n416:             if current[u, v] == 0:\n417:                 current[u, v] = 1\n418:                 if not directed:\n419:                     current[v, u] = 1\n420:                 seq.append((\"insert\", (u, v)))\n421:             else:\n422:                 current[u, v] = 0\n423:                 if not directed:\n424:                     current[v, u] = 0\n425:                 seq.append((\"delete\", (u, v)))\n426:         sequences.append(seq)\n427: \n428:     return sequences\n\n(End of file - total 428 lines)\n</content>","metadata":{"preview":"\"\"\"Graph generation for the bounded test universe.\n\nDirected problems (BFS, DFS, SCC, reachability) default to an\nexhaustive-up-to-isomorphism universe built from the nauty data files in\n``data/nauty/`` (``directed_n<n>.d6`` = all non-isomorphic loop-free digraphs\non n vertices, OEIS A000273; ``rooted_n<n>.d6`` = one representative per\n(digraph, root-orbit) class with the root relabeled to vertex 0, OEIS A353996).\nFor each class we also apply k deterministic random relabelings (vertex\npermutations) to catch label-dependent bugs such as id tie-breaks. For\nrooted problems the base classes are the rooted files (one case per root\norbit); for unrooted problems they are the unrooted files.\n\nUndirected problems (MCS) keep the previous behaviour: all labeled graphs for\nn <= exhaustive_cap (5), then non-isomorphic ``geng`` representatives from\n``undirected_n<n>.g6`` for larger n, then seeded random samples when no data\nfile exists.\n\n``universe=\"labeled\"`` reproduces the old directed behaviour (all labeled\ndigraphs for n <= 4, random samples beyond) and is kept only for comparison.\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/src/evoalgo/graph_generator.py","text":"\"\"\"Graph generation for the bounded test universe.\n\nDirected problems (BFS, DFS, SCC, reachability) default to an\nexhaustive-up-to-isomorphism universe built from the nauty data files in\n``data/nauty/`` (``directed_n<n>.d6`` = all non-isomorphic loop-free digraphs\non n vertices, OEIS A000273; ``rooted_n<n>.d6`` = one representative per\n(digraph, root-orbit) class with the root relabeled to vertex 0, OEIS A353996).\nFor each class we also apply k deterministic random relabelings (vertex\npermutations) to catch label-dependent bugs such as id tie-breaks. For\nrooted problems the base classes are the rooted files (one case per root\norbit); for unrooted problems they are the unrooted files.\n\nUndirected problems (MCS) keep the previous behaviour: all labeled graphs for\nn <= exhaustive_cap (5), then non-isomorphic ``geng`` representatives from\n``undirected_n<n>.g6`` for larger n, then seeded random samples when no data\nfile exists.\n\n``universe=\"labeled\"`` reproduces the old directed behaviour (all labeled\ndigraphs for n <= 4, random samples beyond) and is kept only for comparison.\n\nnauty data provenance, counts, and generation commands: see\n``data/nauty/README.md``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport random\nfrom pathlib import Path\nfrom typing import Iterator\n\nimport numpy as np\n\nNAUTY_DATA_DIR = Path(__file__).parent / \"data\" / \"nauty\"\n\n\n# ---------------------------------------------------------------------------\n# Labeled enumeration (old mode, kept for comparison)\n# ---------------------------------------------------------------------------\n\ndef enumerate_digraphs(n: int) -> Iterator[np.ndarray]:\n    \"\"\"Yield all labeled loop-free digraphs on n vertices as adjacency matrices.\n\n    For directed graphs: each off-diagonal entry is 0 or 1 independently.\n    Count: 2^(n*(n-1)).\n    \"\"\"\n    pairs = n * (n - 1)  # directed: n*(n-1) possible edges\n    for bits in range(2**pairs):\n        mat = np.zeros((n, n), dtype=int)\n        idx = 0\n        for i in range(n):\n            for j in range(n):\n                if i != j:\n                    mat[i, j] = (bits >> idx) & 1\n                    idx += 1\n        yield mat\n\n\ndef enumerate_undirected_graphs(n: int) -> Iterator[np.ndarray]:\n    \"\"\"Yield all labeled loop-free undirected graphs on n vertices.\n\n    For undirected: only upper triangle entries are free.\n    Count: 2^(n*(n-1)/2).\n    \"\"\"\n    pairs = n * (n - 1) // 2\n    for bits in range(2**pairs):\n        mat = np.zeros((n, n), dtype=int)\n        idx = 0\n        for i in range(n):\n            for j in range(i + 1, n):\n                val = (bits >> idx) & 1\n                mat[i, j] = val\n                mat[j, i] = val\n                idx += 1\n        yield mat\n\n\ndef sample_digraphs(n: int, count: int, seed: int, p: float = 0.3) -> list[np.ndarray]:\n    \"\"\"Sample random loop-free digraphs with edge probability p.\"\"\"\n    rng = random.Random(seed)\n    graphs = []\n    for _ in range(count):\n        mat = np.zeros((n, n), dtype=int)\n        for i in range(n):\n            for j in range(n):\n                if i != j and rng.random() < p:\n                    mat[i, j] = 1\n        graphs.append(mat)\n    return graphs\n\n\ndef sample_undirected_graphs(n: int, count: int, seed: int, p: float = 0.3) -> list[np.ndarray]:\n    \"\"\"Sample random loop-free undirected graphs with edge probability p.\"\"\"\n    rng = random.Random(seed)\n    graphs = []\n    for _ in range(count):\n        mat = np.zeros((n, n), dtype=int)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if rng.random() < p:\n                    mat[i, j] = 1\n                    mat[j, i] = 1\n        graphs.append(mat)\n    return graphs\n\n\n# ---------------------------------------------------------------------------\n# nauty encodings\n# ---------------------------------------------------------------------------\n\ndef decode_graph6(line: str) -> tuple[int, np.ndarray]:\n    \"\"\"Decode one graph6 string (nauty format) into (n, adjacency matrix).\n\n    graph6 packs the upper triangle of the adjacency matrix into 6-bit\n    characters (offset 63). The first 1-3 chars encode n.\n    \"\"\"\n    vals = [ord(c) - 63 for c in line.strip()]\n    if not vals or any(v < 0 or v > 63 for v in vals):\n        raise ValueError(f\"invalid graph6 line: {line!r}\")\n    if vals[0] <= 62:\n        n, k = vals[0], 1\n    elif vals[0] == 63:\n        if len(vals) < 4:\n            raise ValueError(f\"truncated graph6 long header: {line!r}\")\n        n = (vals[1] << 12) | (vals[2] << 6) | vals[3]\n        k = 4\n    else:\n        raise ValueError(f\"invalid graph6 header: {line!r}\")\n    bits = []\n    for v in vals[k:]:\n        bits.extend((v >> b) & 1 for b in range(5, -1, -1))\n    if len(bits) < n * (n - 1) // 2:\n        raise ValueError(f\"truncated graph6 line: {line!r}\")\n    mat = np.zeros((n, n), dtype=int)\n    idx = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if bits[idx]:\n                mat[i, j] = mat[j, i] = 1\n            idx += 1\n    return n, mat\n\n\ndef decode_digraph6(line: str) -> tuple[int, list[int]]:\n    \"\"\"Decode one digraph6 line (nauty format) into (n, rows).\n\n    digraph6 packs the full n x n adjacency matrix (row by row, arc i->j is\n    bit j of row i) into 6-bit characters (offset 63). The first character is\n    ``&`` (38); the next encodes n (n<=62: single byte n+63). ``rows[i]`` is\n    the out-arc bitmask of vertex i (bit j set iff arc i->j exists).\n\n    Long headers (``~``) for n>62 are not needed for the committed data\n    (n<=5) and raise if encountered.\n    \"\"\"\n    s = line.strip()\n    if not s or s[0] != \"&\":\n        raise ValueError(f\"not digraph6: {line!r}\")\n    rest = s[1:]\n    if not rest or rest[0] == \"~\":\n        raise ValueError(f\"digraph6 long header (n>62) not supported: {line!r}\")\n    n = ord(rest[0]) - 63\n    if n < 1:\n        raise ValueError(f\"invalid digraph6 header: {line!r}\")\n    bits = []\n    for c in rest[1:]:\n        v = ord(c) - 63\n        if v < 0 or v > 63:\n            raise ValueError(f\"invalid digraph6 body: {line!r}\")\n        for b in range(5, -1, -1):  # big-endian: first bit of group is MSB\n            bits.append((v >> b) & 1)\n    if len(bits) < n * n:\n        raise ValueError(f\"truncated digraph6 line: {line!r}\")\n    rows = []\n    for i in range(n):\n        row = 0\n        for j in range(n):\n            if bits[i * n + j]:\n                row |= (1 << j)\n        rows.append(row)\n    return n, rows\n\n\ndef encode_digraph6(n: int, rows: list[int]) -> str:\n    \"\"\"Inverse of :func:`decode_digraph6`: (n, rows) -> digraph6 string.\n\n    Used only for round-trip self-tests.\n    \"\"\"\n    bits = []\n    for i in range(n):\n        for j in range(n):\n            bits.append((rows[i] >> j) & 1)\n    while len(bits) % 6:\n        bits.append(0)\n    out = [\"&\", chr(n + 63)]\n    for g in range(0, len(bits), 6):\n        v = 0\n        for b in range(5, -1, -1):\n            v = (v << 1) | bits[g + (5 - b)]\n        out.append(chr(v + 63))\n    return \"\".join(out)\n\n\ndef digraph_rows_to_matrix(n: int, rows: list[int]) -> np.ndarray:\n    \"\"\"Convert digraph6 out-arc bitmasks to an n x n 0/1 adjacency matrix.\"\"\"\n    return np.array([[(rows[i] >> j) & 1 for j in range(n)] for i in range(n)], dtype=int)\n\n\ndef relabel_digraph(graph: np.ndarray, perm: tuple[int, ...]) -> np.ndarray:\n    \"\"\"Apply a vertex permutation to a digraph adjacency matrix.\n\n    ``perm[i]`` is the new label of old vertex i. Arc i->j becomes\n    perm[i]->perm[j]. The result is isomorphic to ``graph``; when ``perm`` is\n    the identity it is unchanged. Used to produce deterministic label\n    variants of a nauty representative so the verifier also exercises\n    label-dependent behaviour (e.g. id tie-breaks).\n    \"\"\"\n    n = graph.shape[0]\n    out = np.zeros((n, n), dtype=int)\n    for i in range(n):\n        for j in range(n):\n            if graph[i, j]:\n                out[perm[i], perm[j]] = 1\n    return out\n\n\ndef _relabel_permutations(n: int, seed: int, k: int) -> list[tuple[int, ...]]:\n    \"\"\"Return up to k distinct non-identity vertex permutations of range(n).\n\n    Deterministic in (seed, n, k): the same call always yields the same\n    permutations, so the test universe is reproducible across runs.\n    \"\"\"\n    if k <= 0:\n        return []\n    rng = random.Random(seed * 1_000_003 + n)\n    identity = tuple(range(n))\n    perms: list[tuple[int, ...]] = []\n    seen: set[tuple[int, ...]] = set()\n    attempts = 0\n    while len(perms) < k and attempts < 1000:\n        attempts += 1\n        p = list(range(n))\n        rng.shuffle(p)\n        p = tuple(p)\n        if p == identity or p in seen:\n            continue\n        seen.add(p)\n        perms.append(p)\n    return perms\n\n\n# ---------------------------------------------------------------------------\n# nauty loaders\n# ---------------------------------------------------------------------------\n\ndef load_nauty_graphs(n: int) -> list[np.ndarray] | None:\n    \"\"\"Load non-isomorphic undirected graphs of size n from the nauty data file.\n\n    Returns None if no data file exists for that size (caller falls back to\n    random sampling). Files are graph6, one graph per line, produced by\n    `geng n` (see data/nauty/README.md).\n    \"\"\"\n    path = NAUTY_DATA_DIR / f\"undirected_n{n}.g6\"\n    if not path.exists():\n        return None\n    graphs = []\n    for line in path.read_text().splitlines():\n        if line.strip():\n            gn, mat = decode_graph6(line)\n            if gn != n:\n                raise ValueError(f\"{path.name}: expected n={n}, got n={gn}\")\n            graphs.append(mat)\n    if not graphs:\n        raise ValueError(f\"{path} exists but contains no graphs\")\n    return graphs\n\n\ndef _load_nauty_digraphs(n: int, prefix: str) -> list[np.ndarray] | None:\n    \"\"\"Load digraph6 representatives of size n from ``<prefix>_n<n>.d6``.\n\n    ``prefix`` is ``directed`` (unrooted, OEIS A000273) or ``rooted`` (one\n    representative per (digraph, root-orbit) class with the root at vertex 0,\n    OEIS A353996). Returns None if no data file exists for that size.\n    \"\"\"\n    path = NAUTY_DATA_DIR / f\"{prefix}_n{n}.d6\"\n    if not path.exists():\n        return None\n    graphs = []\n    for line in path.read_text().splitlines():\n        if line.strip():\n            dn, rows = decode_digraph6(line)\n            if dn != n:\n                raise ValueError(f\"{path.name}: expected n={n}, got n={dn}\")\n            graphs.append(digraph_rows_to_matrix(n, rows))\n    if not graphs:\n        raise ValueError(f\"{path} exists but contains no digraphs\")\n    return graphs\n\n\ndef load_nauty_digraphs(n: int) -> list[np.ndarray] | None:\n    \"\"\"All non-isomorphic loop-free digraphs of size n (unrooted reps).\"\"\"\n    return _load_nauty_digraphs(n, \"directed\")\n\n\ndef load_nauty_rooted_digraphs(n: int) -> list[np.ndarray] | None:\n    \"\"\"One representative per (digraph, root-orbit) class of size n.\n\n    The distinguished vertex (root) is relabeled to vertex 0 in each\n    representative, so a rooted problem can fix its source at 0 and still\n    cover every root orbit exactly once.\n    \"\"\"\n    return _load_nauty_digraphs(n, \"rooted\")\n\n\n# ---------------------------------------------------------------------------\n# Universe assembly\n# ---------------------------------------------------------------------------\n\ndef generate_test_graphs(\n    n_max: int,\n    n_random: int,\n    seed: int,\n    directed: bool,\n    exhaustive_cap: int | None = None,\n    universe: str = \"nauty\",\n    rooted: bool = False,\n    relabels_per_class: int = 2,\n) -> list[tuple[int, np.ndarray]]:\n    \"\"\"Generate the bounded test universe of base graphs.\n\n    Returns a list of (n, adjacency_matrix) pairs.\n\n    Directed, ``universe=\"nauty\"`` (default): for each n with a data file,\n    every non-isomorphic representative (rooted files for rooted problems,\n    unrooted otherwise) plus ``relabels_per_class`` deterministic random\n    relabelings of each representative. For n with no data file, seeded\n    random samples. This is the exhaustive-up-to-isomorphism universe.\n\n    Directed, ``universe=\"labeled\"`` (comparison only): all labeled digraphs\n    for n <= exhaustive_cap (4), random samples beyond.\n\n    Undirected (any universe): all labeled graphs for n <= exhaustive_cap\n    (5), then non-isomorphic ``geng`` representatives from the data files for\n    larger n, then seeded random samples when no data file exists. This path\n    is unchanged from the original so MCS behaviour is preserved.\n    \"\"\"\n    if exhaustive_cap is None:\n        exhaustive_cap = 4 if directed else 5\n    result: list[tuple[int, np.ndarray]] = []\n    rng_seed = seed\n\n    for n in range(2, n_max + 1):\n        if directed:\n            if universe == \"labeled\":\n                if n <= exhaustive_cap:\n                    for g in enumerate_digraphs(n):\n                        result.append((n, g))\n                else:\n                    for g in sample_digraphs(n, min(n_random, 200), rng_seed):\n                        result.append((n, g))\n                    rng_seed += 1\n            else:  # \"nauty\"\n                loader = load_nauty_rooted_digraphs if rooted else load_nauty_digraphs\n                reps = loader(n)\n                if reps is None:\n                    for g in sample_digraphs(n, min(n_random, 200), rng_seed):\n                        result.append((n, g))\n                    rng_seed += 1\n                    continue\n                for g in reps:\n                    result.append((n, g))\n                    for perm in _relabel_permutations(n, seed, relabels_per_class):\n                        result.append((n, relabel_digraph(g, perm)))\n        else:\n            # Undirected: preserve the original labelled/nauty/sampled mix.\n            if n <= exhaustive_cap:\n                for g in enumerate_undirected_graphs(n):\n                    result.append((n, g))\n            else:\n                nauty = load_nauty_graphs(n)\n                if nauty is not None:\n                    for g in nauty:\n                        result.append((n, g))\n                else:\n                    for g in sample_undirected_graphs(n, min(n_random, 200), rng_seed):\n                        result.append((n, g))\n                    rng_seed += 1\n\n    return result\n\n\ndef generate_operation_sequences(\n    n: int,\n    graph: np.ndarray,\n    seq_len_max: int,\n    seq_count: int,\n    seed: int,\n    directed: bool = True,\n) -> list[list[tuple[str, tuple[int, int]]]]:\n    \"\"\"Generate bounded sequences of edge insertions and deletions.\n\n    Each operation is ('insert', (u, v)) or ('delete', (u, v)).\n    Operations are legal: insert only if edge absent, delete only if present.\n    \"\"\"\n    rng = random.Random(seed)\n    sequences = []\n\n    for s in range(seq_count):\n        seq = []\n        current = graph.copy()\n        for _ in range(seq_len_max):\n            # Pick a random non-diagonal cell\n            u = rng.randint(0, n - 1)\n            v = rng.randint(0, n - 1)\n            while v == u:\n                v = rng.randint(0, n - 1)\n\n            if current[u, v] == 0:\n                current[u, v] = 1\n                if not directed:\n                    current[v, u] = 1\n                seq.append((\"insert\", (u, v)))\n            else:\n                current[u, v] = 0\n                if not directed:\n                    current[v, u] = 0\n                seq.append((\"delete\", (u, v)))\n        sequences.append(seq)\n\n    return sequences","lineStart":1,"lineEnd":428,"totalLines":428,"truncated":false}},"title":"src/evoalgo/graph_generator.py","time":{"start":1792502054223,"end":1792502054259}},"id":"prt_15972bc47001oxELgMNTCMI5ZF","sessionID":"ses_ea696572dffe59PLAKRjMwErzJ","messageID":"msg_1597262d4001aKgehZjOXluOlW"}}
