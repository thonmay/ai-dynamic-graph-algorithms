{"type":"tool_use","timestamp":1792508422051,"sessionID":"ses_ea62f61e9ffeZ6mYDjplW4oSwi","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-babbf1e2a2591e79","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/src/evoalgo/sandbox.py"},"output":"<path>/home/ethomdt/thesis/src/evoalgo/sandbox.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Sandbox: isolated execution of candidate code.\n2: \n3: Executes candidate algorithms in a subprocess with:\n4:   - wall-clock timeout\n5:   - restricted environment (no PATH pollution)\n6:   - stdout/stderr capture\n7:   - structured result output\n8: \n9: The candidate module is imported and its init/insert_edge/delete_edge are\n10: called in the subprocess. The result (state or exception) is returned\n11: as a structured record via JSON over stdout.\n12: \n13: Trust boundary: candidate code never sees the verifier, test graphs, or\n14: oracle. It only receives adjacency matrices and edge tuples.\n15: \n16: Batched execution: all test cases for a candidate are sent to a single\n17: subprocess. This avoids paying ~160ms Python startup cost per test case,\n18: which makes the system unworkable at n>=4 where exhaustive digraph\n19: enumeration produces thousands of graphs.\n20: \"\"\"\n21: \n22: from __future__ import annotations\n23: \n24: import json\n25: import os\n26: import signal\n27: import subprocess\n28: import sys\n29: import tempfile\n30: import textwrap\n31: import traceback\n32: from pathlib import Path\n33: from typing import Any\n34: \n35: import numpy as np\n36: \n37: # Runner script that executes inside the subprocess\n38: def _runner_file() -> str:\n39:     \"\"\"The runner script, written once per process and content (not per call).\n40: \n41:     A per-call temp file was left behind whenever the parent was killed\n42:     (timeouts, Ctrl-C), hundreds per run. One file per process and template\n43:     version, overwritten atomically, leaves at most one.\n44:     \"\"\"\n45:     import hashlib\n46:     digest = hashlib.sha256(_RUNNER_TEMPLATE.encode()).hexdigest()[:12]\n47:     path = Path(tempfile.gettempdir()) / f\"evoalgo_runner_{os.getuid()}_{digest}.py\"\n48:     if not path.is_file() or path.read_text() != _RUNNER_TEMPLATE:\n49:         tmp = path.with_name(f\"{path.name}.{os.getpid()}.tmp\")\n50:         tmp.write_text(_RUNNER_TEMPLATE)\n51:         os.replace(tmp, path)\n52:     return str(path)\n53: \n54: \n55: _RUNNER_TEMPLATE = textwrap.dedent('''\n56: import json, sys, time, traceback, copy\n57: \n58: def run():\n59:     data = json.load(sys.stdin)\n60:     module_path = data[\"module_path\"]\n61:     directed = data.get(\"directed\", True)\n62:     offline_src = data.get(\"offline_src\", \"\")\n63:     root = data.get(\"root\", None)\n64:     test_cases = data[\"test_cases\"]\n65:     repeat = max(1, data.get(\"repeat\", 20))\n66: \n67:     import importlib.util\n68:     spec = importlib.util.spec_from_file_location(\"candidate\", module_path)\n69:     mod = importlib.util.module_from_spec(spec)\n70:     spec.loader.exec_module(mod)\n71: \n72:     for fn in (\"init\", \"insert_edge\", \"delete_edge\"):\n73:         if not hasattr(mod, fn):\n74:             return {\"status\": \"crash\", \"error\": f\"Missing function: {fn}\"}\n75: \n76:     offline_fn = None\n77:     if offline_src:\n78:         ns = {\"np\": __import__(\"numpy\")}\n79:         exec(compile(offline_src, \"<offline>\", \"exec\"), ns)\n80:         offline_fn = ns.get(\"offline_compute\")\n81: \n82:     np = __import__(\"numpy\")\n83:     all_results = []\n84: \n85:     try:\n86:         for tc_idx, tc in enumerate(test_cases):\n87:             graph = tc[\"graph\"]\n88:             sequences = tc[\"sequences\"]\n89:             graph_results = []\n90: \n91:             for seq_idx, seq in enumerate(sequences):\n92:                 ops = seq  # list of {type, edge}\n93:                 current_graph = [row[:] for row in graph]\n94:                 results = []\n95:                 timings = []\n96:                 offline_timings = []\n97: \n98:                 try:\n99:                     # Init\n100:                     t0 = time.perf_counter_ns()\n101:                     for _ in range(repeat):\n102:                         _ = mod.init(current_graph)\n103:                     t1 = time.perf_counter_ns()\n104:                     timings.append((t1 - t0) // repeat // 1000)\n105:                     state = mod.init(current_graph)\n106:                     results.append({\"after\": \"init\", \"state\": _serialize(state)})\n107: \n108:                     if offline_fn:\n109:                         g_np = np.array(current_graph)\n110:                         t0 = time.perf_counter_ns()\n111:                         for _ in range(repeat):\n112:                             offline_fn(g_np, root)\n113:                         t1 = time.perf_counter_ns()\n114:                         offline_timings.append((t1 - t0) // repeat // 1000)\n115: \n116:                     for op in ops:\n117:                         op_type = op[\"type\"]\n118:                         edge = tuple(op[\"edge\"])\n119:                         u, v = edge\n120:                         if op_type == \"insert\":\n121:                             current_graph[u][v] = 1\n122:                             if not directed:\n123:                                 current_graph[v][u] = 1\n124:                             fn = mod.insert_edge\n125:                         elif op_type == \"delete\":\n126:                             current_graph[u][v] = 0\n127:                             if not directed:\n128:                                 current_graph[v][u] = 0\n129:                             fn = mod.delete_edge\n130:                         else:\n131:                             raise ValueError(f\"Unknown op: {op_type}\")\n132: \n133:                         pre_state = copy.deepcopy(state)\n134:                         # Pre-allocate copies so deepcopy overhead is\n135:                         # outside the timed region\n136:                         state_copies = [copy.deepcopy(pre_state) for _ in range(repeat)]\n137:                         t0 = time.perf_counter_ns()\n138:                         for i in range(repeat):\n139:                             _ = fn(current_graph, edge, state_copies[i])\n140:                         t1 = time.perf_counter_ns()\n141:                         timings.append((t1 - t0) // repeat // 1000)\n142:                         state = fn(current_graph, edge, state)\n143: \n144:                         if offline_fn:\n145:                             g_np = np.array(current_graph)\n146:                             t0 = time.perf_counter_ns()\n147:                             for _ in range(repeat):\n148:                                 offline_fn(g_np, root)\n149:                             t1 = time.perf_counter_ns()\n150:                             offline_timings.append((t1 - t0) // repeat // 1000)\n151: \n152:                         results.append({\"after\": op_type + \" \" + str(edge),\n153:                                         \"state\": _serialize(state)})\n154: \n155:                     graph_results.append({\n156:                         \"status\": \"ok\",\n157:                         \"results\": results,\n158:                         \"timings\": timings,\n159:                         \"offline_timings\": offline_timings,\n160:                     })\n161:                 except Exception as e:\n162:                     graph_results.append({\n163:                         \"status\": \"crash\",\n164:                         \"error\": _describe(e, module_path),\n165:                         \"traceback\": traceback.format_exc(),\n166:                         \"partial_results\": results,\n167:                         \"partial_timings\": timings,\n168:                         \"partial_offline_timings\": offline_timings,\n169:                     })\n170: \n171:             all_results.append(graph_results)\n172: \n173:         return {\"status\": \"ok\", \"all_results\": all_results}\n174:     except Exception as e:\n175:         return {\"status\": \"crash\", \"error\": _describe(e, module_path),\n176:                 \"traceback\": traceback.format_exc(),\n177:                 \"partial_all_results\": all_results}\n178: \n179: def _describe(e, module_path=None):\n180:     \"\"\"Type, message and the candidate's failing line: str(KeyError(0)) is just '0'.\"\"\"\n181:     try:\n182:         where = \"\"\n183:         for fs in reversed(traceback.extract_tb(e.__traceback__)):\n184:             if module_path and fs.filename == module_path:\n185:                 where = \" at line %d: %s\" % (fs.lineno, (fs.line or \"\").strip())\n186:                 break\n187:         return \"%s: %s%s\" % (type(e).__name__, e, where)\n188:     except Exception:\n189:         return type(e).__name__\n190: \n191: def _serialize(obj):\n192:     import numpy as np\n193:     if isinstance(obj, np.ndarray):\n194:         return obj.tolist()\n195:     if isinstance(obj, (set, frozenset)):\n196:         return sorted(obj)\n197:     if isinstance(obj, dict):\n198:         return {str(k): _serialize(v) for k, v in obj.items()}\n199:     if isinstance(obj, (list, tuple)):\n200:         return [_serialize(x) for x in obj]\n201:     if isinstance(obj, (np.integer,)):\n202:         return int(obj)\n203:     if isinstance(obj, (np.floating,)):\n204:         return float(obj)\n205:     if isinstance(obj, np.bool_):\n206:         return bool(obj)\n207:     return obj\n208: \n209: if __name__ == \"__main__\":\n210:     result = run()\n211:     json.dump(result, sys.stdout)\n212:     sys.stdout.write(\"\\\\n\")\n213: ''').strip()\n214: \n215: \n216: class SandboxResult:\n217:     \"\"\"Result of executing a candidate in the sandbox.\"\"\"\n218: \n219:     def __init__(\n220:         self,\n221:         status: str,  # \"ok\", \"crash\", \"timeout\"\n222:         all_results: list[list[dict]] | None = None,\n223:         error: str | None = None,\n224:         traceback_str: str | None = None,\n225:     ):\n226:         self.status = status\n227:         self.all_results = all_results\n228:         self.error = error\n229:         self.traceback_str = traceback_str\n230: \n231:     @property\n232:     def is_ok(self) -> bool:\n233:         return self.status == \"ok\"\n234: \n235:     @property\n236:     def is_crash(self) -> bool:\n237:         return self.status == \"crash\"\n238: \n239:     @property\n240:     def is_timeout(self) -> bool:\n241:         return self.status == \"timeout\"\n242: \n243: \n244: class Sandbox:\n245:     \"\"\"Executes candidate code in an isolated subprocess.\"\"\"\n246: \n247:     def __init__(self, timeout_seconds: int = 30, python_path: str | None = None,\n248:                  directed: bool = True):\n249:         self.timeout = timeout_seconds\n250:         self.python = python_path or sys.executable\n251:         self.directed = directed\n252: \n253:     def execute_batch(\n254:         self,\n255:         module_path: Path | str,\n256:         test_cases: list[dict[str, Any]],\n257:         offline_src: str | None = None,\n258:         root: int | None = None,\n259:         repeat: int = 20,\n260:         timeout: int | None = None,\n261:     ) -> SandboxResult:\n262:         \"\"\"Run a candidate against all test cases in a single subprocess.\n263: \n264:         Args:\n265:             module_path: path to the candidate .py file\n266:             test_cases: list of {graph: list[list[int]], sequences: list[list[dict]]}\n267:                         where each sequence is a list of {type: insert|delete, edge: [u, v]}\n268:             offline_src: source of the offline_compute baseline function\n269:             root: root/source vertex for problems that need one\n270:             repeat: REPEAT amplification for timing (fewer for large test sets)\n271:             timeout: per-call wall-clock seconds. Defaults to ``self.timeout``.\n272:                 The verifier passes a per-chunk timeout so a candidate that\n273:                 loops forever on one chunk still fails fast, while the whole\n274:                 batch is split across several subprocesses.\n275: \n276:         Returns:\n277:             SandboxResult with all_results: list[per_graph: list[per_seq: dict]]\n278:             Each per-seq dict has: status, results, timings, offline_timings\n279:             (or status=crash with error/traceback + partial results)\n280:         \"\"\"\n281:         module_path = Path(module_path)\n282:         call_timeout = self.timeout if timeout is None else timeout\n283: \n284:         runner_path = _runner_file()\n285: \n286:         input_data = {\n287:             \"module_path\": str(module_path),\n288:             \"directed\": self.directed,\n289:             \"offline_src\": offline_src or \"\",\n290:             \"root\": root,\n291:             \"test_cases\": test_cases,\n292:             \"repeat\": repeat,\n293:         }\n294: \n295:         try:\n296:             proc = subprocess.run(\n297:                 [self.python, runner_path],\n298:                 input=json.dumps(input_data),\n299:                 capture_output=True,\n300:                 text=True,\n301:                 timeout=call_timeout,\n302:                 env={\n303:                     \"HOME\": os.environ.get(\"HOME\", \"/tmp\"),\n304:                     \"PATH\": \"/usr/bin:/bin\",\n305:                     \"PYTHONPATH\": \"\",\n306:                 },\n307:             )\n308: \n309:             if proc.returncode == -signal.SIGKILL or proc.returncode == 137:\n310:                 return SandboxResult(status=\"timeout\", error=\"Process killed (likely OOM)\")\n311: \n312:             if proc.returncode != 0 and not proc.stdout:\n313:                 return SandboxResult(\n314:                     status=\"crash\",\n315:                     error=proc.stderr or f\"Exit code {proc.returncode}\",\n316:                 )\n317: \n318:             try:\n319:                 result = json.loads(proc.stdout)\n320:             except json.JSONDecodeError:\n321:                 return SandboxResult(\n322:                     status=\"crash\",\n323:                     error=f\"Invalid output from runner: {proc.stdout[:500]}\",\n324:                     traceback_str=proc.stderr,\n325:                 )\n326: \n327:             if result.get(\"status\") == \"ok\":\n328:                 return SandboxResult(\n329:                     status=\"ok\",\n330:                     all_results=result.get(\"all_results\", []),\n331:                 )\n332:             elif result.get(\"status\") == \"crash\":\n333:                 return SandboxResult(\n334:                     status=\"crash\",\n335:                     error=result.get(\"error\"),\n336:                     traceback_str=result.get(\"traceback\"),\n337:                     all_results=result.get(\"partial_all_results\"),\n338:                 )\n339:             else:\n340:                 return SandboxResult(\n341:                     status=\"crash\",\n342:                     error=f\"Unknown status: {result.get('status')}\",\n343:                 )\n344: \n345:         except subprocess.TimeoutExpired:\n346:             return SandboxResult(status=\"timeout\", error=f\"Exceeded {call_timeout}s\")\n347: \n348:     def execute(\n349:         self,\n350:         module_path: Path | str,\n351:         graph: np.ndarray,\n352:         operations: list[dict[str, Any]],\n353:         offline_src: str | None = None,\n354:         root: int | None = None,\n355:     ) -> SandboxResult:\n356:         \"\"\"Run a candidate module on a single graph with a sequence of operations.\n357: \n358:         Legacy single-test interface. Returns a SandboxResult with\n359:         all_results containing a single graph with a single sequence.\n360:         \"\"\"\n361:         test_cases = [{\n362:             \"graph\": graph.tolist() if isinstance(graph, np.ndarray) else graph,\n363:             \"sequences\": [operations],\n364:         }]\n365:         batch_result = self.execute_batch(module_path, test_cases, offline_src, root)\n366:         # Flatten: all_results[0][0] is the single sequence result\n367:         if batch_result.is_ok and batch_result.all_results:\n368:             seq_result = batch_result.all_results[0][0] if batch_result.all_results[0] else None\n369:             if seq_result:\n370:                 return _LegacySandboxResult(\n371:                     status=seq_result.get(\"status\", \"crash\"),\n372:                     results=seq_result.get(\"results\"),\n373:                     timings=seq_result.get(\"timings\"),\n374:                     offline_timings=seq_result.get(\"offline_timings\"),\n375:                     error=seq_result.get(\"error\"),\n376:                     traceback_str=seq_result.get(\"traceback\"),\n377:                 )\n378:         return _LegacySandboxResult(\n379:             status=batch_result.status,\n380:             error=batch_result.error,\n381:             traceback_str=batch_result.traceback_str,\n382:         )\n383: \n384:     def execute_single(\n385:         self,\n386:         module_path: Path | str,\n387:         graph: np.ndarray,\n388:     ) -> SandboxResult:\n389:         \"\"\"Execute just init() on a graph and return the initial state.\"\"\"\n390:         return self.execute(module_path, graph, [])\n391: \n392: \n393: class _LegacySandboxResult(SandboxResult):\n394:     \"\"\"Backward-compatible result for the single-test execute() method.\n395: \n396:     Inherits is_ok/is_crash/is_timeout from SandboxResult.\n397:     \"\"\"\n398: \n399:     def __init__(\n400:         self,\n401:         status: str,\n402:         results: list[dict] | None = None,\n403:         timings: list[int] | None = None,\n404:         offline_timings: list[int] | None = None,\n405:         error: str | None = None,\n406:         traceback_str: str | None = None,\n407:     ):\n408:         super().__init__(status=status, error=error, traceback_str=traceback_str)\n409:         self.results = results\n410:         self.timings = timings\n411:         self.offline_timings = offline_timings\n\n(End of file - total 411 lines)\n</content>","metadata":{"preview":"\"\"\"Sandbox: isolated execution of candidate code.\n\nExecutes candidate algorithms in a subprocess with:\n  - wall-clock timeout\n  - restricted environment (no PATH pollution)\n  - stdout/stderr capture\n  - structured result output\n\nThe candidate module is imported and its init/insert_edge/delete_edge are\ncalled in the subprocess. The result (state or exception) is returned\nas a structured record via JSON over stdout.\n\nTrust boundary: candidate code never sees the verifier, test graphs, or\noracle. It only receives adjacency matrices and edge tuples.\n\nBatched execution: all test cases for a candidate are sent to a single\nsubprocess. This avoids paying ~160ms Python startup cost per test case,\nwhich makes the system unworkable at n>=4 where exhaustive digraph\nenumeration produces thousands of graphs.\n\"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/src/evoalgo/sandbox.py","text":"\"\"\"Sandbox: isolated execution of candidate code.\n\nExecutes candidate algorithms in a subprocess with:\n  - wall-clock timeout\n  - restricted environment (no PATH pollution)\n  - stdout/stderr capture\n  - structured result output\n\nThe candidate module is imported and its init/insert_edge/delete_edge are\ncalled in the subprocess. The result (state or exception) is returned\nas a structured record via JSON over stdout.\n\nTrust boundary: candidate code never sees the verifier, test graphs, or\noracle. It only receives adjacency matrices and edge tuples.\n\nBatched execution: all test cases for a candidate are sent to a single\nsubprocess. This avoids paying ~160ms Python startup cost per test case,\nwhich makes the system unworkable at n>=4 where exhaustive digraph\nenumeration produces thousands of graphs.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport textwrap\nimport traceback\nfrom pathlib import Path\nfrom typing import Any\n\nimport numpy as np\n\n# Runner script that executes inside the subprocess\ndef _runner_file() -> str:\n    \"\"\"The runner script, written once per process and content (not per call).\n\n    A per-call temp file was left behind whenever the parent was killed\n    (timeouts, Ctrl-C), hundreds per run. One file per process and template\n    version, overwritten atomically, leaves at most one.\n    \"\"\"\n    import hashlib\n    digest = hashlib.sha256(_RUNNER_TEMPLATE.encode()).hexdigest()[:12]\n    path = Path(tempfile.gettempdir()) / f\"evoalgo_runner_{os.getuid()}_{digest}.py\"\n    if not path.is_file() or path.read_text() != _RUNNER_TEMPLATE:\n        tmp = path.with_name(f\"{path.name}.{os.getpid()}.tmp\")\n        tmp.write_text(_RUNNER_TEMPLATE)\n        os.replace(tmp, path)\n    return str(path)\n\n\n_RUNNER_TEMPLATE = textwrap.dedent('''\nimport json, sys, time, traceback, copy\n\ndef run():\n    data = json.load(sys.stdin)\n    module_path = data[\"module_path\"]\n    directed = data.get(\"directed\", True)\n    offline_src = data.get(\"offline_src\", \"\")\n    root = data.get(\"root\", None)\n    test_cases = data[\"test_cases\"]\n    repeat = max(1, data.get(\"repeat\", 20))\n\n    import importlib.util\n    spec = importlib.util.spec_from_file_location(\"candidate\", module_path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n\n    for fn in (\"init\", \"insert_edge\", \"delete_edge\"):\n        if not hasattr(mod, fn):\n            return {\"status\": \"crash\", \"error\": f\"Missing function: {fn}\"}\n\n    offline_fn = None\n    if offline_src:\n        ns = {\"np\": __import__(\"numpy\")}\n        exec(compile(offline_src, \"<offline>\", \"exec\"), ns)\n        offline_fn = ns.get(\"offline_compute\")\n\n    np = __import__(\"numpy\")\n    all_results = []\n\n    try:\n        for tc_idx, tc in enumerate(test_cases):\n            graph = tc[\"graph\"]\n            sequences = tc[\"sequences\"]\n            graph_results = []\n\n            for seq_idx, seq in enumerate(sequences):\n                ops = seq  # list of {type, edge}\n                current_graph = [row[:] for row in graph]\n                results = []\n                timings = []\n                offline_timings = []\n\n                try:\n                    # Init\n                    t0 = time.perf_counter_ns()\n                    for _ in range(repeat):\n                        _ = mod.init(current_graph)\n                    t1 = time.perf_counter_ns()\n                    timings.append((t1 - t0) // repeat // 1000)\n                    state = mod.init(current_graph)\n                    results.append({\"after\": \"init\", \"state\": _serialize(state)})\n\n                    if offline_fn:\n                        g_np = np.array(current_graph)\n                        t0 = time.perf_counter_ns()\n                        for _ in range(repeat):\n                            offline_fn(g_np, root)\n                        t1 = time.perf_counter_ns()\n                        offline_timings.append((t1 - t0) // repeat // 1000)\n\n                    for op in ops:\n                        op_type = op[\"type\"]\n                        edge = tuple(op[\"edge\"])\n                        u, v = edge\n                        if op_type == \"insert\":\n                            current_graph[u][v] = 1\n                            if not directed:\n                                current_graph[v][u] = 1\n                            fn = mod.insert_edge\n                        elif op_type == \"delete\":\n                            current_graph[u][v] = 0\n                            if not directed:\n                                current_graph[v][u] = 0\n                            fn = mod.delete_edge\n                        else:\n                            raise ValueError(f\"Unknown op: {op_type}\")\n\n                        pre_state = copy.deepcopy(state)\n                        # Pre-allocate copies so deepcopy overhead is\n                        # outside the timed region\n                        state_copies = [copy.deepcopy(pre_state) for _ in range(repeat)]\n                        t0 = time.perf_counter_ns()\n                        for i in range(repeat):\n                            _ = fn(current_graph, edge, state_copies[i])\n                        t1 = time.perf_counter_ns()\n                        timings.append((t1 - t0) // repeat // 1000)\n                        state = fn(current_graph, edge, state)\n\n                        if offline_fn:\n                            g_np = np.array(current_graph)\n                            t0 = time.perf_counter_ns()\n                            for _ in range(repeat):\n                                offline_fn(g_np, root)\n                            t1 = time.perf_counter_ns()\n                            offline_timings.append((t1 - t0) // repeat // 1000)\n\n                        results.append({\"after\": op_type + \" \" + str(edge),\n                                        \"state\": _serialize(state)})\n\n                    graph_results.append({\n                        \"status\": \"ok\",\n                        \"results\": results,\n                        \"timings\": timings,\n                        \"offline_timings\": offline_timings,\n                    })\n                except Exception as e:\n                    graph_results.append({\n                        \"status\": \"crash\",\n                        \"error\": _describe(e, module_path),\n                        \"traceback\": traceback.format_exc(),\n                        \"partial_results\": results,\n                        \"partial_timings\": timings,\n                        \"partial_offline_timings\": offline_timings,\n                    })\n\n            all_results.append(graph_results)\n\n        return {\"status\": \"ok\", \"all_results\": all_results}\n    except Exception as e:\n        return {\"status\": \"crash\", \"error\": _describe(e, module_path),\n                \"traceback\": traceback.format_exc(),\n                \"partial_all_results\": all_results}\n\ndef _describe(e, module_path=None):\n    \"\"\"Type, message and the candidate's failing line: str(KeyError(0)) is just '0'.\"\"\"\n    try:\n        where = \"\"\n        for fs in reversed(traceback.extract_tb(e.__traceback__)):\n            if module_path and fs.filename == module_path:\n                where = \" at line %d: %s\" % (fs.lineno, (fs.line or \"\").strip())\n                break\n        return \"%s: %s%s\" % (type(e).__name__, e, where)\n    except Exception:\n        return type(e).__name__\n\ndef _serialize(obj):\n    import numpy as np\n    if isinstance(obj, np.ndarray):\n        return obj.tolist()\n    if isinstance(obj, (set, frozenset)):\n        return sorted(obj)\n    if isinstance(obj, dict):\n        return {str(k): _serialize(v) for k, v in obj.items()}\n    if isinstance(obj, (list, tuple)):\n        return [_serialize(x) for x in obj]\n    if isinstance(obj, (np.integer,)):\n        return int(obj)\n    if isinstance(obj, (np.floating,)):\n        return float(obj)\n    if isinstance(obj, np.bool_):\n        return bool(obj)\n    return obj\n\nif __name__ == \"__main__\":\n    result = run()\n    json.dump(result, sys.stdout)\n    sys.stdout.write(\"\\\\n\")\n''').strip()\n\n\nclass SandboxResult:\n    \"\"\"Result of executing a candidate in the sandbox.\"\"\"\n\n    def __init__(\n        self,\n        status: str,  # \"ok\", \"crash\", \"timeout\"\n        all_results: list[list[dict]] | None = None,\n        error: str | None = None,\n        traceback_str: str | None = None,\n    ):\n        self.status = status\n        self.all_results = all_results\n        self.error = error\n        self.traceback_str = traceback_str\n\n    @property\n    def is_ok(self) -> bool:\n        return self.status == \"ok\"\n\n    @property\n    def is_crash(self) -> bool:\n        return self.status == \"crash\"\n\n    @property\n    def is_timeout(self) -> bool:\n        return self.status == \"timeout\"\n\n\nclass Sandbox:\n    \"\"\"Executes candidate code in an isolated subprocess.\"\"\"\n\n    def __init__(self, timeout_seconds: int = 30, python_path: str | None = None,\n                 directed: bool = True):\n        self.timeout = timeout_seconds\n        self.python = python_path or sys.executable\n        self.directed = directed\n\n    def execute_batch(\n        self,\n        module_path: Path | str,\n        test_cases: list[dict[str, Any]],\n        offline_src: str | None = None,\n        root: int | None = None,\n        repeat: int = 20,\n        timeout: int | None = None,\n    ) -> SandboxResult:\n        \"\"\"Run a candidate against all test cases in a single subprocess.\n\n        Args:\n            module_path: path to the candidate .py file\n            test_cases: list of {graph: list[list[int]], sequences: list[list[dict]]}\n                        where each sequence is a list of {type: insert|delete, edge: [u, v]}\n            offline_src: source of the offline_compute baseline function\n            root: root/source vertex for problems that need one\n            repeat: REPEAT amplification for timing (fewer for large test sets)\n            timeout: per-call wall-clock seconds. Defaults to ``self.timeout``.\n                The verifier passes a per-chunk timeout so a candidate that\n                loops forever on one chunk still fails fast, while the whole\n                batch is split across several subprocesses.\n\n        Returns:\n            SandboxResult with all_results: list[per_graph: list[per_seq: dict]]\n            Each per-seq dict has: status, results, timings, offline_timings\n            (or status=crash with error/traceback + partial results)\n        \"\"\"\n        module_path = Path(module_path)\n        call_timeout = self.timeout if timeout is None else timeout\n\n        runner_path = _runner_file()\n\n        input_data = {\n            \"module_path\": str(module_path),\n            \"directed\": self.directed,\n            \"offline_src\": offline_src or \"\",\n            \"root\": root,\n            \"test_cases\": test_cases,\n            \"repeat\": repeat,\n        }\n\n        try:\n            proc = subprocess.run(\n                [self.python, runner_path],\n                input=json.dumps(input_data),\n                capture_output=True,\n                text=True,\n                timeout=call_timeout,\n                env={\n                    \"HOME\": os.environ.get(\"HOME\", \"/tmp\"),\n                    \"PATH\": \"/usr/bin:/bin\",\n                    \"PYTHONPATH\": \"\",\n                },\n            )\n\n            if proc.returncode == -signal.SIGKILL or proc.returncode == 137:\n                return SandboxResult(status=\"timeout\", error=\"Process killed (likely OOM)\")\n\n            if proc.returncode != 0 and not proc.stdout:\n                return SandboxResult(\n                    status=\"crash\",\n                    error=proc.stderr or f\"Exit code {proc.returncode}\",\n                )\n\n            try:\n                result = json.loads(proc.stdout)\n            except json.JSONDecodeError:\n                return SandboxResult(\n                    status=\"crash\",\n                    error=f\"Invalid output from runner: {proc.stdout[:500]}\",\n                    traceback_str=proc.stderr,\n                )\n\n            if result.get(\"status\") == \"ok\":\n                return SandboxResult(\n                    status=\"ok\",\n                    all_results=result.get(\"all_results\", []),\n                )\n            elif result.get(\"status\") == \"crash\":\n                return SandboxResult(\n                    status=\"crash\",\n                    error=result.get(\"error\"),\n                    traceback_str=result.get(\"traceback\"),\n                    all_results=result.get(\"partial_all_results\"),\n                )\n            else:\n                return SandboxResult(\n                    status=\"crash\",\n                    error=f\"Unknown status: {result.get('status')}\",\n                )\n\n        except subprocess.TimeoutExpired:\n            return SandboxResult(status=\"timeout\", error=f\"Exceeded {call_timeout}s\")\n\n    def execute(\n        self,\n        module_path: Path | str,\n        graph: np.ndarray,\n        operations: list[dict[str, Any]],\n        offline_src: str | None = None,\n        root: int | None = None,\n    ) -> SandboxResult:\n        \"\"\"Run a candidate module on a single graph with a sequence of operations.\n\n        Legacy single-test interface. Returns a SandboxResult with\n        all_results containing a single graph with a single sequence.\n        \"\"\"\n        test_cases = [{\n            \"graph\": graph.tolist() if isinstance(graph, np.ndarray) else graph,\n            \"sequences\": [operations],\n        }]\n        batch_result = self.execute_batch(module_path, test_cases, offline_src, root)\n        # Flatten: all_results[0][0] is the single sequence result\n        if batch_result.is_ok and batch_result.all_results:\n            seq_result = batch_result.all_results[0][0] if batch_result.all_results[0] else None\n            if seq_result:\n                return _LegacySandboxResult(\n                    status=seq_result.get(\"status\", \"crash\"),\n                    results=seq_result.get(\"results\"),\n                    timings=seq_result.get(\"timings\"),\n                    offline_timings=seq_result.get(\"offline_timings\"),\n                    error=seq_result.get(\"error\"),\n                    traceback_str=seq_result.get(\"traceback\"),\n                )\n        return _LegacySandboxResult(\n            status=batch_result.status,\n            error=batch_result.error,\n            traceback_str=batch_result.traceback_str,\n        )\n\n    def execute_single(\n        self,\n        module_path: Path | str,\n        graph: np.ndarray,\n    ) -> SandboxResult:\n        \"\"\"Execute just init() on a graph and return the initial state.\"\"\"\n        return self.execute(module_path, graph, [])\n\n\nclass _LegacySandboxResult(SandboxResult):\n    \"\"\"Backward-compatible result for the single-test execute() method.\n\n    Inherits is_ok/is_crash/is_timeout from SandboxResult.\n    \"\"\"\n\n    def __init__(\n        self,\n        status: str,\n        results: list[dict] | None = None,\n        timings: list[int] | None = None,\n        offline_timings: list[int] | None = None,\n        error: str | None = None,\n        traceback_str: str | None = None,\n    ):\n        super().__init__(status=status, error=error, traceback_str=traceback_str)\n        self.results = results\n        self.timings = timings\n        self.offline_timings = offline_timings","lineStart":1,"lineEnd":411,"totalLines":411,"truncated":false}},"title":"src/evoalgo/sandbox.py","time":{"start":1792508421990,"end":1792508422042}},"id":"prt_159d3e6e9001IvJ6MeMi1wd794","sessionID":"ses_ea62f61e9ffeZ6mYDjplW4oSwi","messageID":"msg_159d17a05001r0QEk3LbTV93nV"}}
