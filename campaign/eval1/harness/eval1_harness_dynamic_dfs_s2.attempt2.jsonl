f}\")\nprint(f\"case3(tree-edge delete)      ={case3} {case3/tot:.3f}\")\nprint(f\"nop                          ={nop} {nop/tot:.3f}\")\nPY\npython3 /proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_dfs_s2/breakdown.py"},"output":"case1(newly-reachable insert)=5296 0.139\ncase2(forward-cross insert)  =1344 0.035\ncase3(tree-edge delete)      =7087 0.186\nnop                          =24317 0.639\n","metadata":{"output":"case1(newly-reachable insert)=5296 0.139\ncase2(forward-cross insert)  =1344 0.035\ncase3(tree-edge delete)      =7087 0.186\nnop                          =24317 0.639\n","exit":0,"truncated":false},"title":"cat > /proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_dfs_s2/breakdown.py <<'PY'\nimport random\ndef _recompute(graph):\n    n=len(graph); parent=[None]*n; discover=[None]*n; finish=[None]*n\n    timer=0; stack=[(0,0)]; discover[0]=0; timer=1\n    while stack:\n        u,i=stack[-1]; row=graph[u]; adv=False\n        while i<n:\n            if row[i]==1 and discover[i] is None:\n                parent[i]=u; discover[i]=timer; timer+=1; stack[-1]=(u,i+1); stack.append((i,0)); adv=True; break\n            i+=1\n        if not adv: stack.pop(); finish[u]=timer; timer+=1\n    return parent,discover,finish\ndef init(g):\n    p,d,f=_recompute(g); return {\"parent\":p,\"discover\":d,\"finish\":f}\nrandom.seed(1)\ncase1=case2=case3=nop=0\nfor n in (2,3,4,4,4,5):\n    for _ in range(300):\n        g=[[random.random()<0.4 for _ in range(n)] for _ in range(n)]\n        for i in range(n): g[i][i]=False\n        st=init(g)\n        for _ in range(30):\n            u=random.randrange(n); v=random.randrange(n)\n            if u==v: continue\n            if g[u][v]==1:\n                g[u][v]=0\n                if st[\"parent\"][v]==u: case3+=1\n                else: nop+=1\n            else:\n                g[u][v]=1; d=st[\"discover\"]; f=st[\"finish\"]; du=d[u]; dv=d[v]\n                if du is None: nop+=1\n                elif dv is None: case1+=1\n                elif du<dv and not (dv<f[v]<f[u]): case2+=1\n                else: nop+=1\n            # recompute to keep state valid for next step (approx: full)\n            p,d,f=_recompute(g); st={\"parent\":p,\"discover\":d,\"finish\":f}\ntot=case1+case2+case3+nop\nprint(f\"case1(newly-reachable insert)={case1} {case1/tot:.3f}\")\nprint(f\"case2(forward-cross insert)  ={case2} {case2/tot:.3f}\")\nprint(f\"case3(tree-edge delete)      ={case3} {case3/tot:.3f}\")\nprint(f\"nop                          ={nop} {nop/tot:.3f}\")\nPY\npython3 /proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_dfs_s2/breakdown.py","time":{"start":1792582849933,"end":1792582849945}},"id":"prt_15e437bb7001LDa1sCYsLOPc6r","sessionID":"ses_ea1c34da1ffeE7mN8rSviQJH53","messageID":"msg_15e42a76100138hGKdgQfSiHQ2"}}
