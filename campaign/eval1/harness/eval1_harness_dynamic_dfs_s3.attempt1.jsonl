nce_idx\"] = seq_idx\n705:                         failing_case[\"operation\"] = f\"{op_type} ({u}, {v})\"\n706:                         found = True\n707:                         break\n708: \n709:                 if step_result_idx < len(candidate_times):\n710:                     candidate_work += candidate_times[step_result_idx]\n711:                 if step_result_idx < len(offline_times):\n712:                     offline_work += offline_times[step_result_idx]\n713: \n714:             if found:\n715:                 break\n716: \n717:             passed_tests += 1\n718: \n719:         if failing_case is not None or crash:\n720:             break\n721: \n722:     return {\n723:         \"chunk_start\": chunk_start, \"timeout\": False,\n724:         \"tests_total\": tests_total, \"tests_passed\": passed_tests,\n725:         \"candidate_work\": candidate_work, \"offline_work\": offline_work,\n726:         \"crash\": crash, \"crash_error\": crash_error,\n727:         \"chunk_crash\": False, \"chunk_crash_error\": None,\n728:         \"failing_case\": failing_case,\n729:     }\n\n(Showing lines 560-729 of 774. Use offset=730 to continue.)\n</content>","metadata":{"preview":"            continue\n        for seq_idx, seq in enumerate(case[\"sequences\"]):\n            if time.monotonic() > deadline:\n                break\n            one = {\"graph\": case[\"graph\"], \"sequences\": [seq]}\n            r = sandbox.execute_batch(code_path, [one], offline_src=\"\", root=root, repeat=1,\n                                      timeout=HANG_PROBE_SECONDS)\n            if r.is_timeout:\n                ops = [f\"{op['type']} ({op['edge'][0]}, {op['edge'][1]})\" for op in seq]\n                return {\"graph_n\": n, \"graph\": case[\"graph\"], \"sequence_idx\": seq_idx,\n                        \"operations\": ops, \"note\": f\"no result within {HANG_PROBE_SECONDS}s: \"\n                        \"likely an infinite loop in init or one of these updates\"}\n        return {