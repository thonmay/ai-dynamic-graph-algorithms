{"type":"step_finish","timestamp":1792503558516,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"id":"prt_15989b166001feGx15QC7v7ZOz","reason":"tool-calls","snapshot":"429a287b565359b82e1e8c8b6e3c32564943bd0e","messageID":"msg_159898b6b001VDZNTN7xY6h54o","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","type":"step-finish","tokens":{"total":22816,"input":22354,"output":111,"reasoning":351,"cache":{"write":0,"read":0}},"cost":0}}
