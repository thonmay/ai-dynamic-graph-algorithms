fs\",\n  \"tier\": \"open\",\n  \"title\": \"Dynamic lexicographic BFS ordering\",\n  \"directed\": false,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can a lexicographic BFS (LexBFS) ordering be maintained under edge insertions and deletions? No efficient fully dynamic algorithm is known - this is an open problem.\"\n }\n]\n","metadata":{"output":"[\n {\n  \"name\": \"dynamic_bfs\",\n  \"tier\": \"calibration\",\n  \"title\": \"Dynamic BFS tree maintenance\",\n  \"directed\": true,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can a BFS tree from a fixed root be maintained incrementally under edge insertions and deletions, with work well below full recomputation?\"\n },\n {\n  \"name\": \"dynamic_dfs\",\n  \"tier\": \"calibration\",\n  \"title\": \"Dynamic DFS forest maintenance\",\n  \"directed\": true,\n  \"update_mode\": \"mixed\",\n  \"question\": \"how can a DFS forest from a fixed root be maintained under edge insertions and deletions without redoing the whole search?\"\n },\n {\n  \"name\": \"dynamic_mcs\",\n  \"tier\": \"core\",\n  \"title\": \"Dynamic maximal cardinality search ordering\",\n  \"directed\": false,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can a maximal cardinality search (MCS) ordering be maintained under edge insertions and deletions, with per-update work far below recomputing the ordering from scratch?\"\n },\n {\n  \"name\": \"dynamic_scc\",\n  \"tier\": \"core\",\n  \"title\": \"Dynamic strongly connected components\",\n  \"directed\": true,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can the SCC partition of a directed graph be maintained under edge insertions and deletions, with per-update work far below recomputing the whole decomposition?\"\n },\n {\n  \"name\": \"reachability\",\n  \"tier\": \"core\",\n  \"title\": \"Dynamic single-source reachability\",\n  \"directed\": true,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can the set of vertices reachable from a fixed source be maintained under edge insertions and deletions, cheaper than re-running the search after every update?\"\n },\n {\n  \"name\": \"dynamic_lbfs\",\n  \"tier\": \"open\",\n  \"title\": \"Dynamic lexicographic BFS ordering\",\n  \"directed\": false,\n  \"update_mode\": \"mixed\",\n  \"question\": \"can a lexicographic BFS (LexBFS) ordering be maintained under edge insertions and deletions? No efficient fully dynamic algorithm is known - this is an open problem.\"\n }\n]\n","exit":0,"truncated":false},"title":"evoalgo packs","time":{"start":1792503498798,"end":1792503498840}},"id":"prt_15988c5d2001tP7IWnl7hqgu5Y","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","messageID":"msg_15988bf24001anyhJRvt41Qwtx"}}
