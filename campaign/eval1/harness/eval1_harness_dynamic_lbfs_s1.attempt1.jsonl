{"type":"text","timestamp":1792505076071,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"id":"prt_159a0a2840015dav1U0vv0cZz1","messageID":"msg_159a033a9001OYcP0Gp4sdSokA","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","type":"text","text":"\n\nThe ratio went UP to 1.37, which is worse. The local check must be either more expensive than expected or triggering more recomputes than the full check did. Let me measure the recompute fraction and per-component cost for the local version to find out which.\n\n","time":{"start":1792505062020,"end":1792505076064}}}
{"type":"tool_use","timestamp":1792505076108,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a46afe9761779c05","state":{"status":"completed","input":{"content":"import sys, time\nimport numpy as np\nsys.path.insert(0, \"/home/ethomdt/thesis/src\")\nfrom evoalgo.graph_generator import generate_test_graphs, generate_operation_sequences\nfrom evoalgo.verifier import _exhaustive_flip_sequences\n\ngraphs = generate_test_graphs(4, 20, 1337, directed=False, universe=\"nauty\",\n                              rooted=False, relabels_per_class=2)\nseq_cache = {}\ndef get_seqs(n, g):\n    key = (n, g.tobytes())\n    if key not in seq_cache:\n        seqs = generate_operation_sequences(n, g, 20, 10, 1337 + n, directed=False)\n        if n <= 5:\n            seqs = seqs + _exhaustive_flip_sequences(n, g, False, include_twins=False)\n        seq_cache[key] = seqs\n    return seq_cache[key]\n\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"cand\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_lbfs_s1/candidate.py\")\ncand = importlib.util.module_from_spec(spec); spec.loader.exec_module(cand)\n\nOFFLINE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    start = 0\n    tiebreak = list(range(n))\n    cell = [start] + [v for v in tiebreak if v != start]\n    Pi = [cell]\n    order = []\n    while len(order) < n:\n        p = Pi[0][0]\n        order.append(p)\n        neigh = set()\n        for v in range(n):\n            if graph[p, v] == 1:\n                neigh.add(v)\n        newPi = []\n        for C in Pi:\n            C = [v for v in C if v != p]\n            if not C: continue\n            a = [v for v in C if v in neigh]\n            b = [v for v in C if v not in neigh]\n            if a: newPi.append(a)\n            if b: newPi.append(b)\n        Pi = newPi\n    return order\n'''\nns = {\"np\": np}\nexec(OFFLINE, ns)\noffline = ns[\"offline_compute\"]\n\ntotal_cand = 0; total_off = 0\nrecompute = 0; updates = 0\nlocal_valid_true = 0; local_valid_false = 0\nfor n, g in graphs:\n    g = np.array(g)\n    for seq in get_seqs(n, g):\n        cur = [row[:] for row in g.tolist()]\n        state = cand.init(cur)\n        t0 = time.perf_counter_ns()\n        for _ in range(20): cand.init(cur)\n        t1 = time.perf_counter_ns(); total_cand += (t1-t0)//20\n        t0 = time.perf_counter_ns()\n        for _ in range(20): offline(g, None)\n        t1 = time.perf_counter_ns(); total_off += (t1-t0)//20\n        for op in seq:\n            ot, edge = op\n            u, v = edge\n            if ot == \"insert\": cur[u][v]=1; cur[v][u]=1\n            else: cur[u][v]=0; cur[v][u]=0\n            fn = cand.insert_edge if ot==\"insert\" else cand.delete_edge\n            # measure local check alone\n            old_order = state[\"ordering\"]\n            adj = state[\"adj\"]\n            # apply flip to a copy to measure _lb_valid_after_flip\n            adj2 = adj[:]\n            if ot==\"insert\": adj2[u]|=1<<v; adj2[v]|=1<<u\n            else: adj2[u]&=~(1<<v); adj2[v]&=~(1<<u)\n            t0 = time.perf_counter_ns()\n            for _ in range(200): cand._lb_valid_after_flip(old_order, adj2, n, u, v)\n            t1 = time.perf_counter_ns(); lc = (t1-t0)//200\n            valid = cand._lb_valid_after_flip(old_order, adj2, n, u, v)\n            if valid: local_valid_true += 1\n            else: local_valid_false += 1\n            t0 = time.perf_counter_ns()\n            for _ in range(20): fn(cur,(u,v),state)\n            t1 = time.perf_counter_ns(); total_cand += (t1-t0)//20\n            t0 = time.perf_counter_ns()\n            for _ in range(20): offline(np.array(cur),None)\n            t1 = time.perf_counter_ns(); total_off += (t1-t0)//20\n            state = fn(cur,(u,v),state)\n            if state[\"ordering\"] != old_order:\n                recompute += 1\n            updates += 1\n\nprint(f\"ratio={total_cand/total_off:.4f} updates={updates} recompute={recompute} \"\n      f\"recompute_frac={recompute/updates:.3f} local_true={local_valid_true} local_false={local_valid_false}\")\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile5.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile5.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile5.py","time":{"start":1792505076052,"end":1792505076100}},"id":"prt_159a0a8e5001rS2x9A15f2R637","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","messageID":"msg_159a033a9001OYcP0Gp4sdSokA"}}
