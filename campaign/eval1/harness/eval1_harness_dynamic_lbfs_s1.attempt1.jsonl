{"type":"tool_use","timestamp":1792505495087,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8e91cfdf4722646e","state":{"status":"completed","input":{"content":"import sys, time\nimport numpy as np\nsys.path.insert(0, \"/home/ethomdt/thesis/src\")\nfrom evoalgo.graph_generator import generate_test_graphs, generate_operation_sequences\nfrom evoalgo.verifier import _exhaustive_flip_sequences\n\ngraphs = generate_test_graphs(4, 20, 1337, directed=False, universe=\"nauty\",\n                              rooted=False, relabels_per_class=2)\nseq_cache = {}\ndef get_seqs(n, g):\n    key = (n, g.tobytes())\n    if key not in seq_cache:\n        seqs = generate_operation_sequences(n, g, 20, 10, 1337 + n, directed=False)\n        if n <= 5:\n            seqs = seqs + _exhaustive_flip_sequences(n, g, False, include_twins=False)\n        seq_cache[key] = seqs\n    return seq_cache[key]\n\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"cand\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_lbfs_s1/candidate.py\")\ncand = importlib.util.module_from_spec(spec); spec.loader.exec_module(cand)\n\nOFFLINE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    start = 0\n    tiebreak = list(range(n))\n    cell = [start] + [v for v in tiebreak if v != start]\n    Pi = [cell]\n    order = []\n    while len(order) < n:\n        p = Pi[0][0]\n        order.append(p)\n        neigh = set()\n        for v in range(n):\n            if graph[p, v] == 1:\n                neigh.add(v)\n        newPi = []\n        for C in Pi:\n            C = [v for v in C if v != p]\n            if not C: continue\n            a = [v for v in C if v in neigh]\n            b = [v for v in C if v not in neigh]\n            if a: newPi.append(a)\n            if b: newPi.append(b)\n        Pi = newPi\n    return order\n'''\nns = {\"np\": np}\nexec(OFFLINE, ns)\noffline = ns[\"offline_compute\"]\n\ndef run(mode):\n    total_cand = 0; total_off = 0\n    for n, g in graphs:\n        g = np.array(g)\n        for seq in get_seqs(n, g):\n            cur = [row[:] for row in g.tolist()]\n            state = cand.init(cur)\n            t0 = time.perf_counter_ns()\n            for _ in range(20): cand.init(cur)\n            t1 = time.perf_counter_ns(); total_cand += (t1-t0)//20\n            t0 = time.perf_counter_ns()\n            for _ in range(20): offline(g, None)\n            t1 = time.perf_counter_ns(); total_off += (t1-t0)//20\n            for op in seq:\n                ot, edge = op\n                u, v = edge\n                if ot == \"insert\": cur[u][v]=1; cur[v][u]=1\n                else: cur[u][v]=0; cur[v][u]=0\n                if mode == \"validate\":\n                    fn = cand.insert_edge if ot==\"insert\" else cand.delete_edge\n                    f = fn\n                else:  # recompute-always\n                    def f(cur, edge, state, _ot=ot, _u=u, _v=v):\n                        adj = state[\"adj\"]\n                        if _ot==\"insert\": adj[_u]|=1<<_v; adj[_v]|=1<<_u\n                        else: adj[_u]&=~(1<<_v); adj[_v]&=~(1<<_u)\n                        return cand._build(len(adj), adj)\n                t0 = time.perf_counter_ns()\n                for _ in range(20): f(cur,(u,v),state)\n                t1 = time.perf_counter_ns(); total_cand += (t1-t0)//20\n                t0 = time.perf_counter_ns()\n                for _ in range(20): offline(np.array(cur),None)\n                t1 = time.perf_counter_ns(); total_off += (t1-t0)//20\n                state = f(cur,(u,v),state)\n    return total_cand/total_off\n\nprint(f\"validate-then-recompute ratio={run('validate'):.4f}\")\nprint(f\"recompute-always        ratio={run('recompute'):.4f}\")\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile7.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile7.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile7.py","time":{"start":1792505495036,"end":1792505495077}},"id":"prt_159a717f2001z3VIb8RkzH4FgD","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","messageID":"msg_159a51bdb001ABxQ7vZjBJNcy9"}}
