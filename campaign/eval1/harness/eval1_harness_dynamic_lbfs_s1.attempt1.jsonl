{"type":"tool_use","timestamp":1792504493259,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-96e3cf467a74006b","state":{"status":"completed","input":{"filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile2.py","content":"import sys, time\nimport numpy as np\nsys.path.insert(0, \"/home/ethomdt/thesis/src\")\nfrom evoalgo.graph_generator import generate_test_graphs, generate_operation_sequences\nfrom evoalgo.verifier import _exhaustive_flip_sequences\n\ngraphs = generate_test_graphs(4, 20, 1337, directed=False, universe=\"nauty\",\n                              rooted=False, relabels_per_class=2)\n\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"cand\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_lbfs_s1/candidate.py\")\ncand = importlib.util.module_from_spec(spec); spec.loader.exec_module(cand)\n\nOFFLINE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    start = 0\n    tiebreak = list(range(n))\n    cell = [start] + [v for v in tiebreak if v != start]\n    Pi = [cell]\n    order = []\n    while len(order) < n:\n        p = Pi[0][0]\n        order.append(p)\n        neigh = set()\n        for v in range(n):\n            if graph[p, v] == 1:\n                neigh.add(v)\n        newPi = []\n        for C in Pi:\n            C = [v for v in C if v != p]\n            if not C: continue\n            a = [v for v in C if v in neigh]\n            b = [v for v in C if v not in neigh]\n            if a: newPi.append(a)\n            if b: newPi.append(b)\n        Pi = newPi\n    return order\n'''\nns = {\"np\": np}\nexec(OFFLINE, ns)\noffline = ns[\"offline_compute\"]\n\ndef timeit(fn, reps=200):\n    t0 = time.perf_counter_ns()\n    for _ in range(reps): fn()\n    return (time.perf_counter_ns() - t0) // reps\n\n# Per-component ratios on a representative n=4 graph.\n# collect one graph per n\nrep = {}\nfor n, g in graphs:\n    rep.setdefault(n, np.array(g))\n\nfor n in sorted(rep):\n    g = rep[n]\n    off = timeit(lambda: offline(g, None))\n    # build adj\n    adj = [0]*n\n    for u in range(n):\n        for v in range(n):\n            if g[u,v]: adj[u] |= 1<<v\n    order = cand._lexbfs(n, adj)\n    lex = timeit(lambda: cand._lexbfs(n, adj))\n    valid = timeit(lambda: cand._lb_valid(order, adj, n))\n    # init cost\n    gl = g.tolist()\n    initc = timeit(lambda: cand.init(gl))\n    print(f\"n={n}: off={off}ns init={initc}ns({initc/off:.2f}) \"\n          f\"lexbfs={lex}ns({lex/off:.2f}) valid={valid}ns({valid/off:.3f})\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile2.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile2.py","time":{"start":1792504493141,"end":1792504493248}},"id":"prt_159979ae5001yxJCHeqBftPTB6","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","messageID":"msg_159957cc100116MeKuoY6Y1l2T"}}
