{"type":"tool_use","timestamp":1792504722664,"sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b20a0b0235dae006","state":{"status":"completed","input":{"content":"import sys, time\nimport numpy as np\nsys.path.insert(0, \"/home/ethomdt/thesis/src\")\nfrom evoalgo.graph_generator import generate_test_graphs, generate_operation_sequences\nfrom evoalgo.verifier import _exhaustive_flip_sequences\n\ngraphs = generate_test_graphs(4, 20, 1337, directed=False, universe=\"nauty\",\n                              rooted=False, relabels_per_class=2)\nseq_cache = {}\ndef get_seqs(n, g):\n    key = (n, g.tobytes())\n    if key not in seq_cache:\n        seqs = generate_operation_sequences(n, g, 20, 10, 1337 + n, directed=False)\n        if n <= 5:\n            seqs = seqs + _exhaustive_flip_sequences(n, g, False, include_twins=False)\n        seq_cache[key] = seqs\n    return seq_cache[key]\n\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"cand\",\n    \"/home/ethomdt/thesis/runs/eval1_harness_dynamic_lbfs_s1/candidate.py\")\ncand = importlib.util.module_from_spec(spec); spec.loader.exec_module(cand)\n\nOFFLINE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    start = 0\n    tiebreak = list(range(n))\n    cell = [start] + [v for v in tiebreak if v != start]\n    Pi = [cell]\n    order = []\n    while len(order) < n:\n        p = Pi[0][0]\n        order.append(p)\n        neigh = set()\n        for v in range(n):\n            if graph[p, v] == 1:\n                neigh.add(v)\n        newPi = []\n        for C in Pi:\n            C = [v for v in C if v != p]\n            if not C: continue\n            a = [v for v in C if v in neigh]\n            b = [v for v in C if v not in neigh]\n            if a: newPi.append(a)\n            if b: newPi.append(b)\n        Pi = newPi\n    return order\n'''\nns = {\"np\": np}\nexec(OFFLINE, ns)\noffline = ns[\"offline_compute\"]\n\nper_n = {}\nfor n, g in graphs:\n    g = np.array(g)\n    for seq in get_seqs(n, g):\n        cur = [row[:] for row in g.tolist()]\n        state = cand.init(cur)\n        t0 = time.perf_counter_ns()\n        for _ in range(20): cand.init(cur)\n        t1 = time.perf_counter_ns(); tc = (t1-t0)//20\n        t0 = time.perf_counter_ns()\n        for _ in range(20): offline(g, None)\n        t1 = time.perf_counter_ns(); to = (t1-t0)//20\n        per_n.setdefault(n, [0,0,0,0])\n        per_n[n][0] += tc; per_n[n][1] += to; per_n[n][2] += 1\n        for op in seq:\n            ot, edge = op\n            u, v = edge\n            if ot == \"insert\": cur[u][v]=1; cur[v][u]=1\n            else: cur[u][v]=0; cur[v][u]=0\n            fn = cand.insert_edge if ot==\"insert\" else cand.delete_edge\n            t0 = time.perf_counter_ns()\n            for _ in range(20): fn(cur,(u,v),state)\n            t1 = time.perf_counter_ns(); tc = (t1-t0)//20\n            t0 = time.perf_counter_ns()\n            for _ in range(20): offline(np.array(cur),None)\n            t1 = time.perf_counter_ns(); to = (t1-t0)//20\n            per_n[n][0] += tc; per_n[n][1] += to; per_n[n][3] += 1\n            state = fn(cur,(u,v),state)\n\ntot_c = sum(v[0] for v in per_n.values())\ntot_o = sum(v[1] for v in per_n.values())\nprint(f\"TOTAL ratio={tot_c/tot_o:.4f}\")\nfor n in sorted(per_n):\n    c,o,initc,upd = per_n[n]\n    print(f\"n={n}: cand={c} off={o} ratio={c/o:.4f} init_calls={initc} upd_calls={upd} \"\n          f\"init_share={initc/(initc+upd):.3f}\")\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile4.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile4.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s1/profile4.py","time":{"start":1792504722578,"end":1792504722656}},"id":"prt_1599a7be8001nypBJyWVzVW7cp","sessionID":"ses_ea67781bcffe0HPBy9O3ZA3rA8","messageID":"msg_159991ebf001f4cxp5O0ZCuAPu"}}
