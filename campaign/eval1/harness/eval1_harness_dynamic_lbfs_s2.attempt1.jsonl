{"type":"tool_use","timestamp":1792509132198,"sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b0ef44c837042a6b","state":{"status":"completed","input":{"filePath":"/home/ethomdt/thesis/src/evoalgo/problem_definitions.py"},"output":"<path>/home/ethomdt/thesis/src/evoalgo/problem_definitions.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Problem definitions: invariants, oracles, and offline algorithms.\n2: \n3: Each problem owns:\n4:   - check_invariant(state, graph, root_or_source) -> bool\n5:   - extract_result(state) -> the maintained result (tree, ordering, partition, set)\n6:   - offline_compute(graph, root_or_source) -> the reference result\n7:   - baseline_work(graph) -> int (work for offline recomputation)\n8: \n9: The candidate's state contains the maintained result. The verifier calls\n10: the candidate's init/insert_edge/delete_edge, then asks the problem definition\n11: to check the invariant on the current state.\n12: \"\"\"\n13: \n14: from __future__ import annotations\n15: \n16: from abc import ABC, abstractmethod\n17: from collections import deque\n18: from typing import Any\n19: \n20: import numpy as np\n21: \n22: \n23: class ProblemDefinition(ABC):\n24:     \"\"\"Base class for problem definitions.\"\"\"\n25: \n26:     name: str = \"abstract\"\n27:     directed: bool = True\n28:     needs_root: bool = True  # BFS, DFS, reachability need a root/source\n29:     # What the verifier reads from the returned state, shown to the agents.\n30:     # Must match check_invariant; a candidate that keeps other names fails.\n31:     STATE_CONTRACT: str = \"\"\n32: \n33:     @abstractmethod\n34:     def extract_result(self, state: Any) -> Any:\n35:         \"\"\"Extract the maintained result from candidate state.\"\"\"\n36:         ...\n37: \n38:     @abstractmethod\n39:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n40:         \"\"\"Check the problem's invariant on the current state and graph.\"\"\"\n41:         ...\n42: \n43:     @abstractmethod\n44:     def offline_compute(self, graph: np.ndarray, root: int | None) -> Any:\n45:         \"\"\"Compute the reference result from scratch.\"\"\"\n46:         ...\n47: \n48:     @abstractmethod\n49:     def baseline_work(self, graph: np.ndarray) -> int:\n50:         \"\"\"Estimate work for offline recomputation (vertices + edges scanned).\"\"\"\n51:         ...\n52: \n53:     @property\n54:     def offline_source(self) -> str:\n55:         \"\"\"Return standalone source code for the offline algorithm.\n56: \n57:         This is exec'd in the sandbox subprocess to time the offline\n58:         baseline alongside the candidate. Must be a self-contained\n59:         function named offline_compute(graph, root) with no `self` refs.\n60:         Subclasses override this to provide the source.\n61:         \"\"\"\n62:         return \"\"\n63: \n64:     def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n65:         \"\"\"Return a structured description of the failure for reflection.\"\"\"\n66:         result = self.extract_result(state)\n67:         expected = self.offline_compute(graph, root)\n68:         return {\n69:             \"problem\": self.name,\n70:             \"result\": str(result),\n71:             \"expected\": str(expected),\n72:             \"graph_shape\": list(graph.shape),\n73:         }\n74: \n75: \n76: class DynamicBFS(ProblemDefinition):\n77:     name = \"dynamic_bfs\"\n78:     directed = True\n79:     needs_root = True\n80:     STATE_CONTRACT = (\n81:         \"Return a dict with 'parent' and 'distances' (lists indexed by vertex, or dicts).\\n\"\n82:         \"parent[root] = None; parent[v] = None for unreachable v.\\n\"\n83:         \"distances[v] = BFS distance from the root; -1 or None for unreachable v.\\n\"\n84:         \"Other keys are allowed and ignored.\")\n85: \n86:     OFFLINE_SOURCE = '''\n87: def offline_compute(graph, root):\n88:     import collections\n89:     n = graph.shape[0]\n90:     parent = {root: None}\n91:     dist = {root: 0}\n92:     queue = collections.deque([root])\n93:     while queue:\n94:         u = queue.popleft()\n95:         for v in range(n):\n96:             if graph[u, v] == 1 and v not in dist:\n97:                 dist[v] = dist[u] + 1\n98:                 parent[v] = u\n99:                 queue.append(v)\n100:     return {\"parent\": parent, \"distances\": dist}\n101: '''\n102: \n103:     @property\n104:     def offline_source(self) -> str:\n105:         return self.OFFLINE_SOURCE\n106: \n107:     def extract_result(self, state: Any) -> Any:\n108:         # state should contain 'parent' dict or array\n109:         if isinstance(state, dict):\n110:             return state.get(\"parent\", state.get(\"tree\", state))\n111:         return state\n112: \n113:     def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n114:         ctx = super().failing_context(state, graph, root)\n115:         # Per-vertex diff in one shape, so the agent need not reconcile a\n116:         # list-shaped result with the dict-shaped oracle output.\n117:         try:\n118:             expected = self._bfs_tree(graph, root)\n119:             parent = self._extract_parent(state) or {}\n120:             dist = self._extract_distances(state) or {}\n121:             ctx[\"graph\"] = graph.tolist()\n122:             ctx[\"root\"] = root\n123:             ctx[\"wrong_vertices\"] = [\n124:                 {\"vertex\": v,\n125:                  \"expected_distance\": expected[\"distances\"].get(v, -1),\n126:                  \"your_distance\": dist.get(v, \"missing\"),\n127:                  \"your_parent\": parent.get(v)}\n128:                 for v in range(graph.shape[0])\n129:                 if dist.get(v, -1) != expected[\"distances\"].get(v, -1)\n130:                 or (v != root and parent.get(v) is not None\n131:                     and not graph[parent[v], v])\n132:             ]\n133:         except Exception:\n134:             pass\n135:         return ctx\n136: \n137:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n138:         if root is None:\n139:             return False\n140:         parent = self._extract_parent(state)\n141:         if parent is None:\n142:             return False\n143:         n = graph.shape[0]\n144: \n145:         # (1) Every non-root vertex has exactly one parent, root has none\n146:         for v in range(n):\n147:             if v == root:\n148:                 if parent.get(v) is not None:\n149:                     return False\n150:                 continue\n151:             p = parent.get(v)\n152:             if p is not None and p != v:\n153:                 # Parent must be a neighbor in the graph\n154:                 if graph[p, v] != 1:\n155:                     return False\n156: \n157:         # (2) Tree spans all vertices reachable from root\n158:         distances = self._bfs_distances(graph, root)\n159:         tree_reachable = self._tree_reachable(parent, root, n)\n160:         for v in range(n):\n161:             if distances.get(v, -1) != -1 and v not in tree_reachable:\n162:                 return False\n163:             # Reject spurious parents for unreachable vertices\n164:             if distances.get(v, -1) == -1 and parent.get(v) is not None:\n165:                 return False\n166: \n167:         # (3) Distance property: delta(parent) = delta(v) - 1\n168:         for v in range(n):\n169:             if v == root or v not in tree_reachable:\n170:                 continue\n171:             p = parent.get(v)\n172:             if p is None:\n173:                 return False\n174:             if distances.get(v, -1) != distances.get(p, -1) + 1:\n175:                 return False\n176: \n177:         # (4) The candidate's own reported distances must be the true BFS\n178:         #     distances. The documented candidate state is\n179:         #     {\"parent\": {...}, \"distances\": {...}} (see the offline oracle and\n180:         #     the skill's invariant spec), so a candidate that keeps a valid\n181:         #     parent tree but corrupts its distance field is still wrong and\n182:         #     must be rejected. Previously only `parent` was certified, so a\n183:         #     distances-only fault (e.g. dist[v] = dist[u] + 2) slipped through.\n184:         cand_dist = self._extract_distances(state)\n185:         if cand_dist is not None:\n186:             for v in range(n):\n187:                 if distances.get(v, -1) == -1:\n188:                     # Unreachable: candidate must not report a distance\n189:                     if cand_dist.get(v, -1) != -1:\n190:                         return False\n191:                 elif cand_dist.get(v, -1) != distances[v]:\n192:                     return False\n193: \n194:         return True\n195: \n196:     def _extract_distances(self, state: Any) -> dict[int, int] | None:\n197:         \"\"\"Extract the candidate's reported BFS distances, or None if absent.\n198: \n199:         Returns None when the state carries no distance field (so the check is\n200:         skipped, matching the parent-only fallback). Returns a dict when the\n201:         field is present, so it is validated against the oracle.\n202:         \"\"\"\n203:         if not isinstance(state, dict):\n204:             return None\n205:         d = state.get(\"distances\", state.get(\"dist\"))\n206:         if d is None:\n207:             return None\n208:         # None is an accepted spelling of \"unreachable\", same as -1.\n209:         if isinstance(d, dict):\n210:             return {int(k): -1 if v is None else int(v) for k, v in d.items()}\n211:         if isinstance(d, (list, tuple)):\n212:             return {i: -1 if x is None else int(x) for i, x in enumerate(d)}\n213:         if isinstance(d, np.ndarray):\n214:             return {i: int(d[i]) for i in range(len(d))}\n215:         return None\n216: \n217:     def offline_compute(self, graph: np.ndarray, root: int | None) -> dict:\n218:         return self._bfs_tree(graph, root)\n219: \n220:     def baseline_work(self, graph: np.ndarray) -> int:\n221:         n = graph.shape[0]\n222:         return n + int(graph.sum())\n223: \n224:     def _extract_parent(self, state: Any) -> dict[int, int | None] | None:\n225:         if isinstance(state, dict):\n226:             p = state.get(\"parent\")\n227:             if isinstance(p, dict):\n228:                 return {int(k): v for k, v in p.items()}\n229:             if isinstance(p, (list, tuple)):\n230:                 return {i: v for i, v in enumerate(p)}\n231:             if isinstance(p, np.ndarray):\n232:                 return {i: int(p[i]) for i in range(len(p))}\n233:         return None\n234: \n235:     def _bfs_distances(self, graph: np.ndarray, root: int) -> dict[int, int]:\n236:         n = graph.shape[0]\n237:         dist = {root: 0}\n238:         queue = deque([root])\n239:         while queue:\n240:             u = queue.popleft()\n241:             for v in range(n):\n242:                 if graph[u, v] == 1 and v not in dist:\n243:                     dist[v] = dist[u] + 1\n244:                     queue.append(v)\n245:         return dist\n246: \n247:     def _bfs_tree(self, graph: np.ndarray, root: int | None) -> dict:\n248:         n = graph.shape[0]\n249:         parent: dict[int, int | None] = {root: None}\n250:         dist = {root: 0}\n251:         queue = deque([root])\n252:         while queue:\n253:             u = queue.popleft()\n254:             for v in range(n):\n255:                 if graph[u, v] == 1 and v not in dist:\n256:                     dist[v] = dist[u] + 1\n257:                     parent[v] = u\n258:                     queue.append(v)\n259:         return {\"parent\": parent, \"distances\": dist}\n260: \n261:     def _tree_reachable(self, parent: dict, root: int, n: int) -> set[int]:\n262:         reachable = {root}\n263:         # Build children map\n264:         children: dict[int, list[int]] = {}\n265:         for v, p in parent.items():\n266:             if p is not None and p != v:\n267:                 children.setdefault(p, []).append(v)\n268:         queue = deque([root])\n269:         while queue:\n270:             u = queue.popleft()\n271:             for v in children.get(u, []):\n272:                 if v not in reachable:\n273:                     reachable.add(v)\n274:                     queue.append(v)\n275:         return reachable\n276: \n277: \n278: class DynamicDFS(ProblemDefinition):\n279:     name = \"dynamic_dfs\"\n280:     directed = True\n281:     needs_root = True\n282:     STATE_CONTRACT = (\n283:         \"Return a dict with 'parent', 'discover' and 'finish' (lists indexed by vertex, or dicts).\\n\"\n284:         \"parent[root] = None; for every vertex reachable from the root, parent[v] is a tree\\n\"\n285:         \"in-neighbor discovered before v. Unreachable vertices are not checked.\\n\"\n286:         \"discover/finish are DFS entry/exit times from one shared counter (e.g. root\\n\"\n287:         \"discover 0); for every edge u->v between reachable vertices with\\n\"\n288:         \"discover[u] < discover[v], v must be a descendant of u:\\n\"\n289:         \"discover[u] < discover[v] < finish[v] < finish[u]. Any valid DFS order is accepted.\\n\"\n290:         \"All three fields are required.\\n\"\n291:         \"Other keys are allowed and ignored.\")\n292: \n293:     OFFLINE_SOURCE = '''\n294: def offline_compute(graph, root):\n295:     n = graph.shape[0]\n296:     parent = {i: None for i in range(n)}\n297:     discover = {}\n298:     finish = {}\n299:     visited = set()\n300:     timer = [0]\n301: \n302:     def dfs(u):\n303:         visited.add(u)\n304:         discover[u] = timer[0]\n305:         timer[0] += 1\n306:         for v in range(n):\n307:             if graph[u, v] == 1 and v not in visited:\n308:                 parent[v] = u\n309:                 dfs(v)\n310:         finish[u] = timer[0]\n311:         timer[0] += 1\n312: \n313:     if root is not None:\n314:         dfs(root)\n315:     return {\"parent\": parent, \"discover\": discover, \"finish\": finish}\n316: '''\n317: \n318:     @property\n319:     def offline_source(self) -> str:\n320:         return self.OFFLINE_SOURCE\n321: \n322:     def extract_result(self, state: Any) -> Any:\n323:         if isinstance(state, dict):\n324:             return {\n325:                 \"parent\": state.get(\"parent\"),\n326:                 \"discover\": state.get(\"discover\", state.get(\"disc\")),\n327:                 \"finish\": state.get(\"finish\"),\n328:             }\n329:         return state\n330: \n331:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n332:         if root is None:\n333:             return False\n334:         if not isinstance(state, dict):\n335:             return False\n336:         parent = state.get(\"parent\")\n337:         discover = state.get(\"discover\", state.get(\"disc\"))\n338:         finish = state.get(\"finish\")\n339:         # finish is required: without it only the weaker _replay_dfs check\n340:         # could run, and that accepts trees with a forward-cross edge.\n341:         if parent is None or discover is None or finish is None:\n342:             return False\n343: \n344:         # Normalize to dicts\n345:         parent = self._normalize_dict(parent, graph.shape[0])\n346:         discover = self._normalize_dict(discover, graph.shape[0])\n347:         finish = self._normalize_dict(finish, graph.shape[0]) if finish else None\n348: \n349:         # Verify DFS forest certificate: parent pointers + discovery/finish times\n350:         # are consistent with a DFS of the current graph per Yang et al.\n351:         return self._verify_dfs_certificate(graph, root, parent, discover, finish)\n352: \n353:     def offline_compute(self, graph: np.ndarray, root: int | None) -> dict:\n354:         n = graph.shape[0]\n355:         parent: dict[int, int | None] = {i: None for i in range(n)}\n356:         discover: dict[int, int] = {}\n357:         finish: dict[int, int] = {}\n358:         visited = set()\n359:         timer = [0]\n360: \n361:         def dfs(u: int):\n362:             visited.add(u)\n363:             discover[u] = timer[0]\n364:             timer[0] += 1\n365:             for v in range(n):\n366:                 if graph[u, v] == 1 and v not in visited:\n367:                     parent[v] = u\n368:                     dfs(v)\n369:             finish[u] = timer[0]\n370:             timer[0] += 1\n371: \n372:         if root is not None:\n373:             dfs(root)\n374:         return {\"parent\": parent, \"discover\": discover, \"finish\": finish}\n375: \n376:     def baseline_work(self, graph: np.ndarray) -> int:\n377:         n = graph.shape[0]\n378:         return n + int(graph.sum())\n379: \n380:     def _normalize_dict(self, data: Any, n: int) -> dict[int, Any]:\n381:         if isinstance(data, dict):\n382:             return {int(k): v for k, v in data.items()}\n383:         if isinstance(data, (list, tuple)):\n384:             return {i: data[i] for i in range(len(data))}\n385:         if isinstance(data, np.ndarray):\n386:             return {i: int(data[i]) for i in range(len(data))}\n387:         return {}\n388: \n389:     def _verify_dfs_certificate(\n390:         self,\n391:         graph: np.ndarray,\n392:         root: int,\n393:         parent: dict[int, int | None],\n394:         discover: dict[int, int],\n395:         finish: dict[int, int] | None,\n396:     ) -> bool:\n397:         n = graph.shape[0]\n398: \n399:         # Root must have no parent and must be discovered\n400:         if parent.get(root) is not None:\n401:             return False\n402:         if root not in discover:\n403:             return False\n404: \n405:         # Every vertex reachable from root must be in the forest\n406:         reachable = self._reachable_vertices(graph, root)\n407:         for v in reachable:\n408:             if v not in discover:\n409:                 return False\n410: \n411:         # Parent pointers: for each non-root v in forest, parent[v] must be\n412:         # a neighbor (u -> v edge exists) and u must be discovered before v\n413:         for v in reachable:\n414:             if v == root:\n415:                 continue\n416:             p = parent.get(v)\n417:             if p is None:\n418:                 return False\n419:             if graph[p, v] != 1:\n420:                 return False\n421:             if discover.get(p, -1) >= discover.get(v, -1):\n422:                 return False\n423: \n424:         # If finish times provided, verify interval nesting:\n425:         # for edge u->v where both are in forest, either:\n426:         #   v is a descendant of u (discover[u] < discover[v] < finish[v] < finish[u])\n427:         #   or u is a descendant of v\n428:         #   or they are in separate branches (intervals don't nest)\n429:         # The key check: no forward-cross edge.\n430:         # For non-tree edge u->v where discover[u] < discover[v]:\n431:         #   v must be a descendant of u (i.e., finish[v] < finish[u] if finish exists)\n432:         if finish:\n433:             for u in reachable:\n434:                 for v in reachable:\n435:                     if u != v and graph[u, v] == 1:\n436:                         du, dv = discover.get(u, -1), discover.get(v, -1)\n437:                         fu, fv = finish.get(u, -1), finish.get(v, -1)\n438:                         if du < dv:\n439:                             # u discovered before v. If v is not a descendant of u,\n440:                             # this is a forward-cross edge -> invalid DFS forest.\n441:                             # v is a descendant of u iff discover[u] < discover[v] < finish[v] < finish[u]\n442:                             if not (du < dv < fv < fu):\n443:                                 return False\n444:         else:\n445:             # Without finish times, do a weaker check: verify the forest could\n446:             # be produced by some DFS by replaying with the same neighbor order\n447:             return self._replay_dfs(graph, root, parent, discover)\n448: \n449:         return True\n450: \n451:     def _reachable_vertices(self, graph: np.ndarray, root: int) -> set[int]:\n452:         n = graph.shape[0]\n453:         visited = set()\n454:         stack = [root]\n455:         while stack:\n456:             u = stack.pop()\n457:             if u in visited:\n458:                 continue\n459:             visited.add(u)\n460:             for v in range(n):\n461:                 if graph[u, v] == 1 and v not in visited:\n462:                     stack.append(v)\n463:         return visited\n464: \n465:     def _replay_dfs(\n466:         self,\n467:         graph: np.ndarray,\n468:         root: int,\n469:         parent: dict[int, int | None],\n470:         discover: dict[int, int],\n471:     ) -> bool:\n472:         \"\"\"Weak DFS certificate check without finish times:\n473:         verify that a DFS following the tree structure produces the same\n474:         discovery order.\"\"\"\n475:         n = graph.shape[0]\n476:         # Build children from parent\n477:         children: dict[int, list[int]] = {}\n478:         for v, p in parent.items():\n479:             if p is not None and p != v:\n480:                 children.setdefault(p, []).append(v)\n481:         # Sort children by discovery time\n482:         for u in children:\n483:             children[u].sort(key=lambda x: discover.get(x, 0))\n484: \n485:         visited = set()\n486:         order = []\n487:         timer = [0]\n488: \n489:         def dfs(u: int):\n490:             visited.add(u)\n491:             if discover.get(u) != timer[0]:\n492:                 return False\n493:             timer[0] += 1\n494:             order.append(u)\n495:             for v in children.get(u, []):\n496:                 if v not in visited:\n497:                     if not dfs(v):\n498:                         return False\n499:             return True\n500: \n501:         return dfs(root)\n502: \n503: \n504: class DynamicMCS(ProblemDefinition):\n505:     \"\"\"Maximal Cardinality Search ordering (undirected).\"\"\"\n506: \n507:     name = \"dynamic_mcs\"\n508:     directed = False\n509:     needs_root = False\n510:     STATE_CONTRACT = (\n511:         \"Return a dict with 'ordering': a list of all n vertices. Each vertex, when\\n\"\n512:         \"it is chosen, must have the maximum number of already-chosen neighbors among\\n\"\n513:         \"the unchosen vertices (any tie-break). Other keys are allowed and ignored.\")\n514: \n515:     OFFLINE_SOURCE = '''\n516: def offline_compute(graph, root):\n517:     n = graph.shape[0]\n518:     chosen = set()\n519:     cardinality = {v: 0 for v in range(n)}\n520:     ordering = []\n521: \n522:     for _ in range(n):\n523:         unchosen = [u for u in range(n) if u not in chosen]\n524:         if not unchosen:\n525:             break\n526:         max_card = max(cardinality[u] for u in unchosen)\n527:         candidates = [u for u in unchosen if cardinality[u] == max_card]\n528:         v = min(candidates)\n529:         ordering.append(v)\n530:         chosen.add(v)\n531:         for u in range(n):\n532:             if graph[v, u] == 1 and u not in chosen:\n533:                 cardinality[u] += 1\n534: \n535:     return ordering\n536: '''\n537: \n538:     @property\n539:     def offline_source(self) -> str:\n540:         return self.OFFLINE_SOURCE\n541: \n542:     def extract_result(self, state: Any) -> Any:\n543:         if isinstance(state, dict):\n544:             return state.get(\"ordering\", state.get(\"order\", state))\n545:         return state\n546: \n547:     def _adjacency_lists(self, graph: np.ndarray) -> list[list[int]]:\n548:         \"\"\"Adjacency lists for `graph`, cached per graph.\n549: \n550:         Building lists from the dense matrix is O(n^2), but the verifier\n551:         calls check_invariant repeatedly on the same graph with different\n552:         orderings, so caching makes each subsequent check O(n+m). The cache\n553:         is bounded by the test universe size; cleared if it grows past a cap\n554:         so a very large random sample cannot grow it without bound.\n555:         \"\"\"\n556:         cache = self.__dict__.setdefault(\"_adj_cache\", {})\n557:         key = graph.tobytes()\n558:         adj = cache.get(key)\n559:         if adj is None:\n560:             n = graph.shape[0]\n561:             adj = [[] for _ in range(n)]\n562:             for u in range(n):\n563:                 row = graph[u]\n564:                 for v in range(u + 1, n):\n565:                     if row[v]:\n566:                         adj[u].append(v)\n567:                         adj[v].append(u)\n568:             if len(cache) >= 5000:\n569:                 cache.clear()\n570:             # Freeze to tuples: check_invariant only reads the lists, but\n571:             # returning mutable shared lists would let a future caller poison\n572:             # the cache for all later checks on the same graph.\n573:             adj = [tuple(a) for a in adj]\n574:             cache[key] = adj\n575:         return adj\n576: \n577:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n578:         \"\"\"Check `ordering` is a valid MCS ordering of `graph` in O(n+m).\n579: \n580:         Replays the ordering and confirms each vertex, when chosen, has\n581:         cardinality (already-chosen neighbors) equal to the maximum over all\n582:         unchosen vertices. The running maximum is maintained with a\n583:         cardinality-bucket count array and a pointer that only moves up on\n584:         neighbor increments and down when a bucket empties, so total pointer\n585:         work is O(m) amortized and the whole check is O(n+m) once adjacency\n586:         lists are cached.\n587:         \"\"\"\n588:         ordering = self._extract_ordering(state)\n589:         if ordering is None:\n590:             return False\n591:         n = graph.shape[0]\n592:         if len(ordering) != n:\n593:             return False\n594:         if set(ordering) != set(range(n)):\n595:             return False\n596: \n597:         adj = self._adjacency_lists(graph)\n598:         cardinality = [0] * n          # per-vertex: # already-chosen neighbors\n599:         count = [0] * (n + 1)          # count[c] = # UNCHOSEN vertices with cardinality c\n600:         count[0] = n\n601:         max_card = 0                   # running max cardinality among unchosen\n602:         chosen = [False] * n\n603: \n604:         for v in ordering:\n605:             if cardinality[v] != max_card:\n606:                 return False\n607:             chosen[v] = True\n608:             count[cardinality[v]] -= 1\n609:             for u in adj[v]:\n610:                 if not chosen[u]:\n611:                     old = cardinality[u]\n612:                     new = old + 1\n613:                     cardinality[u] = new\n614:                     count[old] -= 1\n615:                     count[new] += 1\n616:                     if new > max_card:\n617:                         max_card = new\n618:             while max_card > 0 and count[max_card] == 0:\n619:                 max_card -= 1\n620: \n621:         return True\n622: \n623:     def offline_compute(self, graph: np.ndarray, root: int | None) -> list[int]:\n624:         n = graph.shape[0]\n625:         chosen = set()\n626:         cardinality = {v: 0 for v in range(n)}\n627:         ordering = []\n628: \n629:         for _ in range(n):\n630:             unchosen = [u for u in range(n) if u not in chosen]\n631:             if not unchosen:\n632:                 break\n633:             max_card = max(cardinality[u] for u in unchosen)\n634:             # Tie-break: lowest vertex id (deterministic)\n635:             candidates = [u for u in unchosen if cardinality[u] == max_card]\n636:             v = min(candidates)\n637:             ordering.append(v)\n638:             chosen.add(v)\n639:             for u in range(n):\n640:                 if graph[v, u] == 1 and u not in chosen:\n641:                     cardinality[u] += 1\n642: \n643:         return ordering\n644: \n645:     def baseline_work(self, graph: np.ndarray) -> int:\n646:         n = graph.shape[0]\n647:         return n * n  # O(n^2) for MCS\n648: \n649:     def _extract_ordering(self, state: Any) -> list[int] | None:\n650:         if isinstance(state, dict):\n651:             order = state.get(\"ordering\", state.get(\"order\"))\n652:             if order is not None:\n653:                 return [int(x) for x in order]\n654:         if isinstance(state, (list, tuple)):\n655:             return [int(x) for x in state]\n656:         return None\n657: \n658: \n659: class DynamicSCC(ProblemDefinition):\n660:     \"\"\"Strongly Connected Components partition (directed).\"\"\"\n661: \n662:     name = \"dynamic_scc\"\n663:     directed = True\n664:     needs_root = False\n665:     STATE_CONTRACT = (\n666:         \"Return a dict with 'components': a list of lists (or sets) of vertices, the\\n\"\n667:         \"strongly connected components, every vertex in exactly one. Order does not\\n\"\n668:         \"matter. Other keys are allowed and ignored.\")\n669: \n670:     OFFLINE_SOURCE = '''\n671: def offline_compute(graph, root):\n672:     n = graph.shape[0]\n673:     index_counter = [0]\n674:     stack = []\n675:     lowlink = [0] * n\n676:     index = [0] * n\n677:     on_stack = [False] * n\n678:     visited = [False] * n\n679:     result = []\n680: \n681:     def strongconnect(v):\n682:         index[v] = index_counter[0]\n683:         lowlink[v] = index_counter[0]\n684:         index_counter[0] += 1\n685:         stack.append(v)\n686:         on_stack[v] = True\n687:         visited[v] = True\n688: \n689:         for w in range(n):\n690:             if graph[v, w] == 1:\n691:                 if not visited[w]:\n692:                     strongconnect(w)\n693:                     lowlink[v] = min(lowlink[v], lowlink[w])\n694:                 elif on_stack[w]:\n695:                     lowlink[v] = min(lowlink[v], index[w])\n696: \n697:         if lowlink[v] == index[v]:\n698:             comp = []\n699:             while True:\n700:                 w = stack.pop()\n701:                 on_stack[w] = False\n702:                 comp.append(w)\n703:                 if w == v:\n704:                     break\n705:             result.append(comp)\n706: \n707:     for v in range(n):\n708:         if not visited[v]:\n709:             strongconnect(v)\n710: \n711:     return result\n712: '''\n713: \n714:     @property\n715:     def offline_source(self) -> str:\n716:         return self.OFFLINE_SOURCE\n717: \n718:     def extract_result(self, state: Any) -> Any:\n719:         if isinstance(state, dict):\n720:             return state.get(\"components\", state.get(\"sccs\", state))\n721:         return state\n722: \n723:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n724:         components = self._extract_components(state)\n725:         if components is None:\n726:             return False\n727:         n = graph.shape[0]\n728: \n729:         # (2) Disjoint and (3) cover all vertices\n730:         all_vertices: set[int] = set()\n731:         for comp in components:\n732:             for v in comp:\n733:                 if v in all_vertices:\n734:                     return False  # not disjoint\n735:                 all_vertices.add(v)\n736:         if all_vertices != set(range(n)):\n737:             return False\n738: \n739:         # (1) Within each Ci, every vertex reaches every other via edges inside Ci\n740:         for comp in components:\n741:             comp_set = set(comp)\n742:             for u in comp:\n743:                 for v in comp:\n744:                     if u != v and not self._reachable_within(graph, u, v, comp_set):\n745:                         return False\n746: \n747:         # (4) Maximality: no proper superset of Ci is internally mutually reachable\n748:         # Check that merging any two components is impossible\n749:         for i, ci in enumerate(components):\n750:             for j, cj in enumerate(components):\n751:                 if i >= j:\n752:                     continue\n753:                 merged = set(ci) | set(cj)\n754:                 all_reach = True\n755:                 for u in merged:\n756:                     for v in merged:\n757:                         if u != v and not self._reachable_within(graph, u, v, merged):\n758:                             all_reach = False\n759:                             break\n760:                     if not all_reach:\n761:                         break\n762:                 if all_reach:\n763:                     return False  # should have been one component\n764: \n765:         return True\n766: \n767:     def offline_compute(self, graph: np.ndarray, root: int | None) -> list[list[int]]:\n768:         return self._tarjan_scc(graph)\n769: \n770:     def baseline_work(self, graph: np.ndarray) -> int:\n771:         n = graph.shape[0]\n772:         return n + int(graph.sum())\n773: \n774:     def _extract_components(self, state: Any) -> list[set[int]] | None:\n775:         if isinstance(state, dict):\n776:             comps = state.get(\"components\", state.get(\"sccs\"))\n777:             if comps is None:\n778:                 return None\n779:             state = comps\n780:         if isinstance(state, (list, tuple)):\n781:             result = []\n782:             for comp in state:\n783:                 if isinstance(comp, (set, frozenset)):\n784:                     result.append(set(int(x) for x in comp))\n785:                 elif isinstance(comp, (list, tuple)):\n786:                     result.append(set(int(x) for x in comp))\n787:                 else:\n788:                     result.append({int(comp)})\n789:             return result\n790:         return None\n791: \n792:     def _reachable_within(self, graph: np.ndarray, u: int, v: int, allowed: set[int]) -> bool:\n793:         n = graph.shape[0]\n794:         visited = {u}\n795:         stack = [u]\n796:         while stack:\n797:             x = stack.pop()\n798:             if x == v:\n799:                 return True\n800:             for y in range(n):\n801:                 if graph[x, y] == 1 and y in allowed and y not in visited:\n802:                     visited.add(y)\n803:                     stack.append(y)\n804:         return v in visited\n805: \n806:     def _tarjan_scc(self, graph: np.ndarray) -> list[list[int]]:\n807:         n = graph.shape[0]\n808:         index_counter = [0]\n809:         stack: list[int] = []\n810:         lowlink = [0] * n\n811:         index = [0] * n\n812:         on_stack = [False] * n\n813:         visited = [False] * n\n814:         result: list[list[int]] = []\n815: \n816:         def strongconnect(v: int):\n817:             index[v] = index_counter[0]\n818:             lowlink[v] = index_counter[0]\n819:             index_counter[0] += 1\n820:             stack.append(v)\n821:             on_stack[v] = True\n822:             visited[v] = True\n823: \n824:             for w in range(n):\n825:                 if graph[v, w] == 1:\n826:                     if not visited[w]:\n827:                         strongconnect(w)\n828:                         lowlink[v] = min(lowlink[v], lowlink[w])\n829:                     elif on_stack[w]:\n830:                         lowlink[v] = min(lowlink[v], index[w])\n831: \n832:             if lowlink[v] == index[v]:\n833:                 comp = []\n834:                 while True:\n835:                     w = stack.pop()\n836:                     on_stack[w] = False\n837:                     comp.append(w)\n838:                     if w == v:\n839:                         break\n840:                 result.append(comp)\n841: \n842:         for v in range(n):\n843:             if not visited[v]:\n844:                 strongconnect(v)\n845: \n846:         return result\n847: \n848: \n849: class Reachability(ProblemDefinition):\n850:     \"\"\"Reachability set from a fixed source (directed).\"\"\"\n851: \n852:     name = \"reachability\"\n853:     directed = True\n854:     needs_root = True\n855:     STATE_CONTRACT = (\n856:         \"Return a dict with 'reachable': a set or list of the vertices reachable from\\n\"\n857:         \"the root, including the root. Other keys are allowed and ignored.\")\n858: \n859:     OFFLINE_SOURCE = '''\n860: def offline_compute(graph, root):\n861:     import collections\n862:     n = graph.shape[0]\n863:     visited = {root}\n864:     queue = collections.deque([root])\n865:     while queue:\n866:         u = queue.popleft()\n867:         for v in range(n):\n868:             if graph[u, v] == 1 and v not in visited:\n869:                 visited.add(v)\n870:                 queue.append(v)\n871:     return visited\n872: '''\n873: \n874:     @property\n875:     def offline_source(self) -> str:\n876:         return self.OFFLINE_SOURCE\n877: \n878:     def extract_result(self, state: Any) -> Any:\n879:         if isinstance(state, dict):\n880:             return state.get(\"reachable\", state.get(\"set\", state))\n881:         return state\n882: \n883:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n884:         if root is None:\n885:             return False\n886:         maintained = self._extract_set(state)\n887:         if maintained is None:\n888:             return False\n889:         true_reachable = self._bfs_reachable(graph, root)\n890:         return maintained == true_reachable\n891: \n892:     def offline_compute(self, graph: np.ndarray, root: int | None) -> set[int]:\n893:         return self._bfs_reachable(graph, root)\n894: \n895:     def baseline_work(self, graph: np.ndarray) -> int:\n896:         n = graph.shape[0]\n897:         return n + int(graph.sum())\n898: \n899:     def _extract_set(self, state: Any) -> set[int] | None:\n900:         if isinstance(state, dict):\n901:             s = state.get(\"reachable\", state.get(\"set\"))\n902:             if s is None:\n903:                 return None\n904:             state = s\n905:         if isinstance(state, (set, frozenset)):\n906:             return set(int(x) for x in state)\n907:         if isinstance(state, (list, tuple)):\n908:             return set(int(x) for x in state)\n909:         if isinstance(state, np.ndarray):\n910:             return set(int(x) for x in state)\n911:         return None\n912: \n913:     def _bfs_reachable(self, graph: np.ndarray, root: int) -> set[int]:\n914:         n = graph.shape[0]\n915:         visited = {root}\n916:         queue = deque([root])\n917:         while queue:\n918:             u = queue.popleft()\n919:             for v in range(n):\n920:                 if graph[u, v] == 1 and v not in visited:\n921:                     visited.add(v)\n922:                     queue.append(v)\n923:         return visited\n924: \n925: \n926: class DynamicLBFS(ProblemDefinition):\n927:     \"\"\"Lexicographic BFS ordering (undirected) - open-problem tier.\n928: \n929:     Maintaining a LexBFS ordering under arbitrary edge flips has no known\n930:     efficient algorithm, so this is an open tier: the candidate must keep some\n931:     valid LexBFS ordering of the current graph, and the verifier accepts ANY\n932:     valid LexBFS ordering (no tie-break, any start). Correctness is certified\n933:     by the (LB) 4-point property of Corneil & Krueger (2008, \"Lexicographic\n934:     Breadth First Search, Local Modules and the Expansion of Chordal Graph\n935:     Classes\", SIAM J. Discrete Math., doi 10.1137/050623498): for all\n936:     positions a<b<c with ac in E and ab not in E, there exists d<a with db in\n937:     E and dc not in E. The offline oracle is the partition-refinement LexBFS\n938:     of Habib, McConnell, Paul & Viennot (2000, \"Lexicographic Breadth-First\n939:     Search and Constant-Time Recognition of Chordal Graphs\", SIAM J.\n940:     Comput.), started at vertex 0 with the minimum-id tie-break.\n941:     \"\"\"\n942: \n943:     name = \"dynamic_lbfs\"\n944:     directed = False\n945:     needs_root = False\n946:     STATE_CONTRACT = (\n947:         \"Return a dict with 'ordering': a list of all n vertices forming a valid LexBFS\\n\"\n948:         \"ordering (any start vertex, any tie-break). Other keys are allowed and ignored.\")\n949: \n950:     OFFLINE_SOURCE = '''\n951: def offline_compute(graph, root):\n952:     n = graph.shape[0]\n953:     start = 0\n954:     tiebreak = list(range(n))\n955:     cell = [start] + [v for v in tiebreak if v != start]\n956:     Pi = [cell]\n957:     order = []\n958:     while len(order) < n:\n959:         p = Pi[0][0]\n960:         order.append(p)\n961:         neigh = set()\n962:         for v in range(n):\n963:             if graph[p, v] == 1:\n964:                 neigh.add(v)\n965:         newPi = []\n966:         for C in Pi:\n967:             C = [v for v in C if v != p]\n968:             if not C:\n969:                 continue\n970:             a = [v for v in C if v in neigh]\n971:             b = [v for v in C if v not in neigh]\n972:             if a:\n973:                 newPi.append(a)\n974:             if b:\n975:                 newPi.append(b)\n976:         Pi = newPi\n977:     return order\n978: '''\n979: \n980:     @property\n981:     def offline_source(self) -> str:\n982:         return self.OFFLINE_SOURCE\n983: \n984:     def extract_result(self, state: Any) -> Any:\n985:         if isinstance(state, dict):\n986:             return state.get(\"ordering\", state.get(\"order\", state))\n987:         return state\n988: \n989:     def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n990:         \"\"\"Check `ordering` is a valid LexBFS ordering of `graph`.\n991: \n992:         Accepts ANY valid LexBFS ordering (no tie-break, any start). The\n993:         certificate is the (LB) 4-point property, checked in O(n^3) after an\n994:         O(n^3) precompute of the earliest separating vertex per pair.\n995:         \"\"\"\n996:         ordering = self._extract_ordering(state)\n997:         if ordering is None:\n998:             return False\n999:         n = graph.shape[0]\n1000:         if len(ordering) != n:\n1001:             return False\n1002:         if set(ordering) != set(range(n)):\n1003:             return False\n1004:         return self._lb_violation(ordering, graph, n) is None\n1005: \n1006:     def offline_compute(self, graph: np.ndarray, root: int | None) -> list[int]:\n1007:         n = graph.shape[0]\n1008:         start = 0\n1009:         tiebreak = list(range(n))\n1010:         cell = [start] + [v for v in tiebreak if v != start]\n1011:         Pi = [cell]\n1012:         order = []\n1013:         while len(order) < n:\n1014:             p = Pi[0][0]\n1015:             order.append(p)\n1016:             neigh = set()\n1017:             for v in range(n):\n1018:                 if graph[p, v] == 1:\n1019:                     neigh.add(v)\n1020:             newPi = []\n1021:             for C in Pi:\n1022:                 C = [v for v in C if v != p]\n1023:                 if not C:\n1024:                     continue\n1025:                 a = [v for v in C if v in neigh]\n1026:                 b = [v for v in C if v not in neigh]\n1027:                 if a:\n1028:                     newPi.append(a)\n1029:                 if b:\n1030:                     newPi.append(b)\n1031:             Pi = newPi\n1032:         return order\n1033: \n1034:     def baseline_work(self, graph: np.ndarray) -> int:\n1035:         n = graph.shape[0]\n1036:         return n * n  # O(n^2) partition-refinement LexBFS\n1037: \n1038:     def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n1039:         ordering = self._extract_ordering(state)\n1040:         expected = self.offline_compute(graph, root)\n1041:         ctx = {\n1042:             \"problem\": self.name,\n1043:             \"result\": str(ordering),\n1044:             \"expected\": str(expected),\n1045:             \"graph_shape\": list(graph.shape),\n1046:         }\n1047:         n = graph.shape[0]\n1048:         if (\n1049:             ordering is not None\n1050:             and len(ordering) == n\n1051:             and set(ordering) == set(range(n))\n1052:         ):\n1053:             violation = self._lb_violation(ordering, graph, n)\n1054:             if violation is not None:\n1055:                 ctx[\"violation\"] = violation\n1056:         return ctx\n1057: \n1058:     def _extract_ordering(self, state: Any) -> list[int] | None:\n1059:         if isinstance(state, dict):\n1060:             order = state.get(\"ordering\", state.get(\"order\"))\n1061:             if order is not None:\n1062:                 return [int(x) for x in order]\n1063:         if isinstance(state, (list, tuple)):\n1064:             return [int(x) for x in state]\n1065:         return None\n1066: \n1067:     def _lb_violation(self, ordering: list[int], graph: np.ndarray, n: int):\n1068:         \"\"\"Return None if `ordering` satisfies (LB), else the first violation.\n1069: \n1070:         (LB): for all positions a<b<c with ac in E and ab not in E, there is\n1071:         d<a with db in E and dc not in E. minD[b][c] precomputes the earliest\n1072:         (in the ordering) such d, so the witness exists before a iff\n1073:         minD[b][c] < pos[a].\n1074:         \"\"\"\n1075:         pos = {v: i for i, v in enumerate(ordering)}\n1076:         INF = 10**9\n1077:         minD = [[INF] * n for _ in range(n)]\n1078:         for b in range(n):\n1079:             for c in range(n):\n1080:                 if b == c:\n1081:                     continue\n1082:                 best = INF\n1083:                 for d in range(n):\n1084:                     if d != b and d != c and graph[b, d] == 1 and graph[c, d] == 0:\n1085:                         if pos[d] < best:\n1086:                             best = pos[d]\n1087:                 minD[b][c] = best\n1088:         for a in range(n):\n1089:             pa = pos[a]\n1090:             for b in range(n):\n1091:                 pb = pos[b]\n1092:                 if pb <= pa:\n1093:                     continue\n1094:                 for c in range(n):\n1095:                     pc = pos[c]\n1096:                     if pc <= pb:\n1097:                         continue\n1098:                     if graph[a, c] == 1 and graph[a, b] == 0:\n1099:                         if minD[b][c] >= pa:\n1100:                             return {\n1101:                                 \"a\": a, \"b\": b, \"c\": c,\n1102:                                 \"pos_a\": pa, \"minD\": minD[b][c],\n1103:                             }\n1104:         return None\n1105: \n1106: \n1107: # Registry\n1108: PROBLEMS: dict[str, type[ProblemDefinition]] = {\n1109:     \"dynamic_bfs\": DynamicBFS,\n1110:     \"dynamic_dfs\": DynamicDFS,\n1111:     \"dynamic_mcs\": DynamicMCS,\n1112:     \"dynamic_lbfs\": DynamicLBFS,\n1113:     \"dynamic_scc\": DynamicSCC,\n1114:     \"reachability\": Reachability,\n1115: }\n1116: \n1117: \n1118: def get_problem(name: str) -> ProblemDefinition:\n1119:     cls = PROBLEMS.get(name)\n1120:     if cls is None:\n1121:         raise ValueError(f\"Unknown problem: {name}. Available: {list(PROBLEMS.keys())}\")\n1122:     return cls()\n\n(End of file - total 1122 lines)\n</content>","metadata":{"preview":"\"\"\"Problem definitions: invariants, oracles, and offline algorithms.\n\nEach problem owns:\n  - check_invariant(state, graph, root_or_source) -> bool\n  - extract_result(state) -> the maintained result (tree, ordering, partition, set)\n  - offline_compute(graph, root_or_source) -> the reference result\n  - baseline_work(graph) -> int (work for offline recomputation)\n\nThe candidate's state contains the maintained result. The verifier calls\nthe candidate's init/insert_edge/delete_edge, then asks the problem definition\nto check the invariant on the current state.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nimport numpy as np","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/ethomdt/thesis/src/evoalgo/problem_definitions.py","text":"\"\"\"Problem definitions: invariants, oracles, and offline algorithms.\n\nEach problem owns:\n  - check_invariant(state, graph, root_or_source) -> bool\n  - extract_result(state) -> the maintained result (tree, ordering, partition, set)\n  - offline_compute(graph, root_or_source) -> the reference result\n  - baseline_work(graph) -> int (work for offline recomputation)\n\nThe candidate's state contains the maintained result. The verifier calls\nthe candidate's init/insert_edge/delete_edge, then asks the problem definition\nto check the invariant on the current state.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nimport numpy as np\n\n\nclass ProblemDefinition(ABC):\n    \"\"\"Base class for problem definitions.\"\"\"\n\n    name: str = \"abstract\"\n    directed: bool = True\n    needs_root: bool = True  # BFS, DFS, reachability need a root/source\n    # What the verifier reads from the returned state, shown to the agents.\n    # Must match check_invariant; a candidate that keeps other names fails.\n    STATE_CONTRACT: str = \"\"\n\n    @abstractmethod\n    def extract_result(self, state: Any) -> Any:\n        \"\"\"Extract the maintained result from candidate state.\"\"\"\n        ...\n\n    @abstractmethod\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        \"\"\"Check the problem's invariant on the current state and graph.\"\"\"\n        ...\n\n    @abstractmethod\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> Any:\n        \"\"\"Compute the reference result from scratch.\"\"\"\n        ...\n\n    @abstractmethod\n    def baseline_work(self, graph: np.ndarray) -> int:\n        \"\"\"Estimate work for offline recomputation (vertices + edges scanned).\"\"\"\n        ...\n\n    @property\n    def offline_source(self) -> str:\n        \"\"\"Return standalone source code for the offline algorithm.\n\n        This is exec'd in the sandbox subprocess to time the offline\n        baseline alongside the candidate. Must be a self-contained\n        function named offline_compute(graph, root) with no `self` refs.\n        Subclasses override this to provide the source.\n        \"\"\"\n        return \"\"\n\n    def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n        \"\"\"Return a structured description of the failure for reflection.\"\"\"\n        result = self.extract_result(state)\n        expected = self.offline_compute(graph, root)\n        return {\n            \"problem\": self.name,\n            \"result\": str(result),\n            \"expected\": str(expected),\n            \"graph_shape\": list(graph.shape),\n        }\n\n\nclass DynamicBFS(ProblemDefinition):\n    name = \"dynamic_bfs\"\n    directed = True\n    needs_root = True\n    STATE_CONTRACT = (\n        \"Return a dict with 'parent' and 'distances' (lists indexed by vertex, or dicts).\\n\"\n        \"parent[root] = None; parent[v] = None for unreachable v.\\n\"\n        \"distances[v] = BFS distance from the root; -1 or None for unreachable v.\\n\"\n        \"Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    import collections\n    n = graph.shape[0]\n    parent = {root: None}\n    dist = {root: 0}\n    queue = collections.deque([root])\n    while queue:\n        u = queue.popleft()\n        for v in range(n):\n            if graph[u, v] == 1 and v not in dist:\n                dist[v] = dist[u] + 1\n                parent[v] = u\n                queue.append(v)\n    return {\"parent\": parent, \"distances\": dist}\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        # state should contain 'parent' dict or array\n        if isinstance(state, dict):\n            return state.get(\"parent\", state.get(\"tree\", state))\n        return state\n\n    def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n        ctx = super().failing_context(state, graph, root)\n        # Per-vertex diff in one shape, so the agent need not reconcile a\n        # list-shaped result with the dict-shaped oracle output.\n        try:\n            expected = self._bfs_tree(graph, root)\n            parent = self._extract_parent(state) or {}\n            dist = self._extract_distances(state) or {}\n            ctx[\"graph\"] = graph.tolist()\n            ctx[\"root\"] = root\n            ctx[\"wrong_vertices\"] = [\n                {\"vertex\": v,\n                 \"expected_distance\": expected[\"distances\"].get(v, -1),\n                 \"your_distance\": dist.get(v, \"missing\"),\n                 \"your_parent\": parent.get(v)}\n                for v in range(graph.shape[0])\n                if dist.get(v, -1) != expected[\"distances\"].get(v, -1)\n                or (v != root and parent.get(v) is not None\n                    and not graph[parent[v], v])\n            ]\n        except Exception:\n            pass\n        return ctx\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        if root is None:\n            return False\n        parent = self._extract_parent(state)\n        if parent is None:\n            return False\n        n = graph.shape[0]\n\n        # (1) Every non-root vertex has exactly one parent, root has none\n        for v in range(n):\n            if v == root:\n                if parent.get(v) is not None:\n                    return False\n                continue\n            p = parent.get(v)\n            if p is not None and p != v:\n                # Parent must be a neighbor in the graph\n                if graph[p, v] != 1:\n                    return False\n\n        # (2) Tree spans all vertices reachable from root\n        distances = self._bfs_distances(graph, root)\n        tree_reachable = self._tree_reachable(parent, root, n)\n        for v in range(n):\n            if distances.get(v, -1) != -1 and v not in tree_reachable:\n                return False\n            # Reject spurious parents for unreachable vertices\n            if distances.get(v, -1) == -1 and parent.get(v) is not None:\n                return False\n\n        # (3) Distance property: delta(parent) = delta(v) - 1\n        for v in range(n):\n            if v == root or v not in tree_reachable:\n                continue\n            p = parent.get(v)\n            if p is None:\n                return False\n            if distances.get(v, -1) != distances.get(p, -1) + 1:\n                return False\n\n        # (4) The candidate's own reported distances must be the true BFS\n        #     distances. The documented candidate state is\n        #     {\"parent\": {...}, \"distances\": {...}} (see the offline oracle and\n        #     the skill's invariant spec), so a candidate that keeps a valid\n        #     parent tree but corrupts its distance field is still wrong and\n        #     must be rejected. Previously only `parent` was certified, so a\n        #     distances-only fault (e.g. dist[v] = dist[u] + 2) slipped through.\n        cand_dist = self._extract_distances(state)\n        if cand_dist is not None:\n            for v in range(n):\n                if distances.get(v, -1) == -1:\n                    # Unreachable: candidate must not report a distance\n                    if cand_dist.get(v, -1) != -1:\n                        return False\n                elif cand_dist.get(v, -1) != distances[v]:\n                    return False\n\n        return True\n\n    def _extract_distances(self, state: Any) -> dict[int, int] | None:\n        \"\"\"Extract the candidate's reported BFS distances, or None if absent.\n\n        Returns None when the state carries no distance field (so the check is\n        skipped, matching the parent-only fallback). Returns a dict when the\n        field is present, so it is validated against the oracle.\n        \"\"\"\n        if not isinstance(state, dict):\n            return None\n        d = state.get(\"distances\", state.get(\"dist\"))\n        if d is None:\n            return None\n        # None is an accepted spelling of \"unreachable\", same as -1.\n        if isinstance(d, dict):\n            return {int(k): -1 if v is None else int(v) for k, v in d.items()}\n        if isinstance(d, (list, tuple)):\n            return {i: -1 if x is None else int(x) for i, x in enumerate(d)}\n        if isinstance(d, np.ndarray):\n            return {i: int(d[i]) for i in range(len(d))}\n        return None\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> dict:\n        return self._bfs_tree(graph, root)\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n + int(graph.sum())\n\n    def _extract_parent(self, state: Any) -> dict[int, int | None] | None:\n        if isinstance(state, dict):\n            p = state.get(\"parent\")\n            if isinstance(p, dict):\n                return {int(k): v for k, v in p.items()}\n            if isinstance(p, (list, tuple)):\n                return {i: v for i, v in enumerate(p)}\n            if isinstance(p, np.ndarray):\n                return {i: int(p[i]) for i in range(len(p))}\n        return None\n\n    def _bfs_distances(self, graph: np.ndarray, root: int) -> dict[int, int]:\n        n = graph.shape[0]\n        dist = {root: 0}\n        queue = deque([root])\n        while queue:\n            u = queue.popleft()\n            for v in range(n):\n                if graph[u, v] == 1 and v not in dist:\n                    dist[v] = dist[u] + 1\n                    queue.append(v)\n        return dist\n\n    def _bfs_tree(self, graph: np.ndarray, root: int | None) -> dict:\n        n = graph.shape[0]\n        parent: dict[int, int | None] = {root: None}\n        dist = {root: 0}\n        queue = deque([root])\n        while queue:\n            u = queue.popleft()\n            for v in range(n):\n                if graph[u, v] == 1 and v not in dist:\n                    dist[v] = dist[u] + 1\n                    parent[v] = u\n                    queue.append(v)\n        return {\"parent\": parent, \"distances\": dist}\n\n    def _tree_reachable(self, parent: dict, root: int, n: int) -> set[int]:\n        reachable = {root}\n        # Build children map\n        children: dict[int, list[int]] = {}\n        for v, p in parent.items():\n            if p is not None and p != v:\n                children.setdefault(p, []).append(v)\n        queue = deque([root])\n        while queue:\n            u = queue.popleft()\n            for v in children.get(u, []):\n                if v not in reachable:\n                    reachable.add(v)\n                    queue.append(v)\n        return reachable\n\n\nclass DynamicDFS(ProblemDefinition):\n    name = \"dynamic_dfs\"\n    directed = True\n    needs_root = True\n    STATE_CONTRACT = (\n        \"Return a dict with 'parent', 'discover' and 'finish' (lists indexed by vertex, or dicts).\\n\"\n        \"parent[root] = None; for every vertex reachable from the root, parent[v] is a tree\\n\"\n        \"in-neighbor discovered before v. Unreachable vertices are not checked.\\n\"\n        \"discover/finish are DFS entry/exit times from one shared counter (e.g. root\\n\"\n        \"discover 0); for every edge u->v between reachable vertices with\\n\"\n        \"discover[u] < discover[v], v must be a descendant of u:\\n\"\n        \"discover[u] < discover[v] < finish[v] < finish[u]. Any valid DFS order is accepted.\\n\"\n        \"All three fields are required.\\n\"\n        \"Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    parent = {i: None for i in range(n)}\n    discover = {}\n    finish = {}\n    visited = set()\n    timer = [0]\n\n    def dfs(u):\n        visited.add(u)\n        discover[u] = timer[0]\n        timer[0] += 1\n        for v in range(n):\n            if graph[u, v] == 1 and v not in visited:\n                parent[v] = u\n                dfs(v)\n        finish[u] = timer[0]\n        timer[0] += 1\n\n    if root is not None:\n        dfs(root)\n    return {\"parent\": parent, \"discover\": discover, \"finish\": finish}\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        if isinstance(state, dict):\n            return {\n                \"parent\": state.get(\"parent\"),\n                \"discover\": state.get(\"discover\", state.get(\"disc\")),\n                \"finish\": state.get(\"finish\"),\n            }\n        return state\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        if root is None:\n            return False\n        if not isinstance(state, dict):\n            return False\n        parent = state.get(\"parent\")\n        discover = state.get(\"discover\", state.get(\"disc\"))\n        finish = state.get(\"finish\")\n        # finish is required: without it only the weaker _replay_dfs check\n        # could run, and that accepts trees with a forward-cross edge.\n        if parent is None or discover is None or finish is None:\n            return False\n\n        # Normalize to dicts\n        parent = self._normalize_dict(parent, graph.shape[0])\n        discover = self._normalize_dict(discover, graph.shape[0])\n        finish = self._normalize_dict(finish, graph.shape[0]) if finish else None\n\n        # Verify DFS forest certificate: parent pointers + discovery/finish times\n        # are consistent with a DFS of the current graph per Yang et al.\n        return self._verify_dfs_certificate(graph, root, parent, discover, finish)\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> dict:\n        n = graph.shape[0]\n        parent: dict[int, int | None] = {i: None for i in range(n)}\n        discover: dict[int, int] = {}\n        finish: dict[int, int] = {}\n        visited = set()\n        timer = [0]\n\n        def dfs(u: int):\n            visited.add(u)\n            discover[u] = timer[0]\n            timer[0] += 1\n            for v in range(n):\n                if graph[u, v] == 1 and v not in visited:\n                    parent[v] = u\n                    dfs(v)\n            finish[u] = timer[0]\n            timer[0] += 1\n\n        if root is not None:\n            dfs(root)\n        return {\"parent\": parent, \"discover\": discover, \"finish\": finish}\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n + int(graph.sum())\n\n    def _normalize_dict(self, data: Any, n: int) -> dict[int, Any]:\n        if isinstance(data, dict):\n            return {int(k): v for k, v in data.items()}\n        if isinstance(data, (list, tuple)):\n            return {i: data[i] for i in range(len(data))}\n        if isinstance(data, np.ndarray):\n            return {i: int(data[i]) for i in range(len(data))}\n        return {}\n\n    def _verify_dfs_certificate(\n        self,\n        graph: np.ndarray,\n        root: int,\n        parent: dict[int, int | None],\n        discover: dict[int, int],\n        finish: dict[int, int] | None,\n    ) -> bool:\n        n = graph.shape[0]\n\n        # Root must have no parent and must be discovered\n        if parent.get(root) is not None:\n            return False\n        if root not in discover:\n            return False\n\n        # Every vertex reachable from root must be in the forest\n        reachable = self._reachable_vertices(graph, root)\n        for v in reachable:\n            if v not in discover:\n                return False\n\n        # Parent pointers: for each non-root v in forest, parent[v] must be\n        # a neighbor (u -> v edge exists) and u must be discovered before v\n        for v in reachable:\n            if v == root:\n                continue\n            p = parent.get(v)\n            if p is None:\n                return False\n            if graph[p, v] != 1:\n                return False\n            if discover.get(p, -1) >= discover.get(v, -1):\n                return False\n\n        # If finish times provided, verify interval nesting:\n        # for edge u->v where both are in forest, either:\n        #   v is a descendant of u (discover[u] < discover[v] < finish[v] < finish[u])\n        #   or u is a descendant of v\n        #   or they are in separate branches (intervals don't nest)\n        # The key check: no forward-cross edge.\n        # For non-tree edge u->v where discover[u] < discover[v]:\n        #   v must be a descendant of u (i.e., finish[v] < finish[u] if finish exists)\n        if finish:\n            for u in reachable:\n                for v in reachable:\n                    if u != v and graph[u, v] == 1:\n                        du, dv = discover.get(u, -1), discover.get(v, -1)\n                        fu, fv = finish.get(u, -1), finish.get(v, -1)\n                        if du < dv:\n                            # u discovered before v. If v is not a descendant of u,\n                            # this is a forward-cross edge -> invalid DFS forest.\n                            # v is a descendant of u iff discover[u] < discover[v] < finish[v] < finish[u]\n                            if not (du < dv < fv < fu):\n                                return False\n        else:\n            # Without finish times, do a weaker check: verify the forest could\n            # be produced by some DFS by replaying with the same neighbor order\n            return self._replay_dfs(graph, root, parent, discover)\n\n        return True\n\n    def _reachable_vertices(self, graph: np.ndarray, root: int) -> set[int]:\n        n = graph.shape[0]\n        visited = set()\n        stack = [root]\n        while stack:\n            u = stack.pop()\n            if u in visited:\n                continue\n            visited.add(u)\n            for v in range(n):\n                if graph[u, v] == 1 and v not in visited:\n                    stack.append(v)\n        return visited\n\n    def _replay_dfs(\n        self,\n        graph: np.ndarray,\n        root: int,\n        parent: dict[int, int | None],\n        discover: dict[int, int],\n    ) -> bool:\n        \"\"\"Weak DFS certificate check without finish times:\n        verify that a DFS following the tree structure produces the same\n        discovery order.\"\"\"\n        n = graph.shape[0]\n        # Build children from parent\n        children: dict[int, list[int]] = {}\n        for v, p in parent.items():\n            if p is not None and p != v:\n                children.setdefault(p, []).append(v)\n        # Sort children by discovery time\n        for u in children:\n            children[u].sort(key=lambda x: discover.get(x, 0))\n\n        visited = set()\n        order = []\n        timer = [0]\n\n        def dfs(u: int):\n            visited.add(u)\n            if discover.get(u) != timer[0]:\n                return False\n            timer[0] += 1\n            order.append(u)\n            for v in children.get(u, []):\n                if v not in visited:\n                    if not dfs(v):\n                        return False\n            return True\n\n        return dfs(root)\n\n\nclass DynamicMCS(ProblemDefinition):\n    \"\"\"Maximal Cardinality Search ordering (undirected).\"\"\"\n\n    name = \"dynamic_mcs\"\n    directed = False\n    needs_root = False\n    STATE_CONTRACT = (\n        \"Return a dict with 'ordering': a list of all n vertices. Each vertex, when\\n\"\n        \"it is chosen, must have the maximum number of already-chosen neighbors among\\n\"\n        \"the unchosen vertices (any tie-break). Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    chosen = set()\n    cardinality = {v: 0 for v in range(n)}\n    ordering = []\n\n    for _ in range(n):\n        unchosen = [u for u in range(n) if u not in chosen]\n        if not unchosen:\n            break\n        max_card = max(cardinality[u] for u in unchosen)\n        candidates = [u for u in unchosen if cardinality[u] == max_card]\n        v = min(candidates)\n        ordering.append(v)\n        chosen.add(v)\n        for u in range(n):\n            if graph[v, u] == 1 and u not in chosen:\n                cardinality[u] += 1\n\n    return ordering\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        if isinstance(state, dict):\n            return state.get(\"ordering\", state.get(\"order\", state))\n        return state\n\n    def _adjacency_lists(self, graph: np.ndarray) -> list[list[int]]:\n        \"\"\"Adjacency lists for `graph`, cached per graph.\n\n        Building lists from the dense matrix is O(n^2), but the verifier\n        calls check_invariant repeatedly on the same graph with different\n        orderings, so caching makes each subsequent check O(n+m). The cache\n        is bounded by the test universe size; cleared if it grows past a cap\n        so a very large random sample cannot grow it without bound.\n        \"\"\"\n        cache = self.__dict__.setdefault(\"_adj_cache\", {})\n        key = graph.tobytes()\n        adj = cache.get(key)\n        if adj is None:\n            n = graph.shape[0]\n            adj = [[] for _ in range(n)]\n            for u in range(n):\n                row = graph[u]\n                for v in range(u + 1, n):\n                    if row[v]:\n                        adj[u].append(v)\n                        adj[v].append(u)\n            if len(cache) >= 5000:\n                cache.clear()\n            # Freeze to tuples: check_invariant only reads the lists, but\n            # returning mutable shared lists would let a future caller poison\n            # the cache for all later checks on the same graph.\n            adj = [tuple(a) for a in adj]\n            cache[key] = adj\n        return adj\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        \"\"\"Check `ordering` is a valid MCS ordering of `graph` in O(n+m).\n\n        Replays the ordering and confirms each vertex, when chosen, has\n        cardinality (already-chosen neighbors) equal to the maximum over all\n        unchosen vertices. The running maximum is maintained with a\n        cardinality-bucket count array and a pointer that only moves up on\n        neighbor increments and down when a bucket empties, so total pointer\n        work is O(m) amortized and the whole check is O(n+m) once adjacency\n        lists are cached.\n        \"\"\"\n        ordering = self._extract_ordering(state)\n        if ordering is None:\n            return False\n        n = graph.shape[0]\n        if len(ordering) != n:\n            return False\n        if set(ordering) != set(range(n)):\n            return False\n\n        adj = self._adjacency_lists(graph)\n        cardinality = [0] * n          # per-vertex: # already-chosen neighbors\n        count = [0] * (n + 1)          # count[c] = # UNCHOSEN vertices with cardinality c\n        count[0] = n\n        max_card = 0                   # running max cardinality among unchosen\n        chosen = [False] * n\n\n        for v in ordering:\n            if cardinality[v] != max_card:\n                return False\n            chosen[v] = True\n            count[cardinality[v]] -= 1\n            for u in adj[v]:\n                if not chosen[u]:\n                    old = cardinality[u]\n                    new = old + 1\n                    cardinality[u] = new\n                    count[old] -= 1\n                    count[new] += 1\n                    if new > max_card:\n                        max_card = new\n            while max_card > 0 and count[max_card] == 0:\n                max_card -= 1\n\n        return True\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> list[int]:\n        n = graph.shape[0]\n        chosen = set()\n        cardinality = {v: 0 for v in range(n)}\n        ordering = []\n\n        for _ in range(n):\n            unchosen = [u for u in range(n) if u not in chosen]\n            if not unchosen:\n                break\n            max_card = max(cardinality[u] for u in unchosen)\n            # Tie-break: lowest vertex id (deterministic)\n            candidates = [u for u in unchosen if cardinality[u] == max_card]\n            v = min(candidates)\n            ordering.append(v)\n            chosen.add(v)\n            for u in range(n):\n                if graph[v, u] == 1 and u not in chosen:\n                    cardinality[u] += 1\n\n        return ordering\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n * n  # O(n^2) for MCS\n\n    def _extract_ordering(self, state: Any) -> list[int] | None:\n        if isinstance(state, dict):\n            order = state.get(\"ordering\", state.get(\"order\"))\n            if order is not None:\n                return [int(x) for x in order]\n        if isinstance(state, (list, tuple)):\n            return [int(x) for x in state]\n        return None\n\n\nclass DynamicSCC(ProblemDefinition):\n    \"\"\"Strongly Connected Components partition (directed).\"\"\"\n\n    name = \"dynamic_scc\"\n    directed = True\n    needs_root = False\n    STATE_CONTRACT = (\n        \"Return a dict with 'components': a list of lists (or sets) of vertices, the\\n\"\n        \"strongly connected components, every vertex in exactly one. Order does not\\n\"\n        \"matter. Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    index_counter = [0]\n    stack = []\n    lowlink = [0] * n\n    index = [0] * n\n    on_stack = [False] * n\n    visited = [False] * n\n    result = []\n\n    def strongconnect(v):\n        index[v] = index_counter[0]\n        lowlink[v] = index_counter[0]\n        index_counter[0] += 1\n        stack.append(v)\n        on_stack[v] = True\n        visited[v] = True\n\n        for w in range(n):\n            if graph[v, w] == 1:\n                if not visited[w]:\n                    strongconnect(w)\n                    lowlink[v] = min(lowlink[v], lowlink[w])\n                elif on_stack[w]:\n                    lowlink[v] = min(lowlink[v], index[w])\n\n        if lowlink[v] == index[v]:\n            comp = []\n            while True:\n                w = stack.pop()\n                on_stack[w] = False\n                comp.append(w)\n                if w == v:\n                    break\n            result.append(comp)\n\n    for v in range(n):\n        if not visited[v]:\n            strongconnect(v)\n\n    return result\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        if isinstance(state, dict):\n            return state.get(\"components\", state.get(\"sccs\", state))\n        return state\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        components = self._extract_components(state)\n        if components is None:\n            return False\n        n = graph.shape[0]\n\n        # (2) Disjoint and (3) cover all vertices\n        all_vertices: set[int] = set()\n        for comp in components:\n            for v in comp:\n                if v in all_vertices:\n                    return False  # not disjoint\n                all_vertices.add(v)\n        if all_vertices != set(range(n)):\n            return False\n\n        # (1) Within each Ci, every vertex reaches every other via edges inside Ci\n        for comp in components:\n            comp_set = set(comp)\n            for u in comp:\n                for v in comp:\n                    if u != v and not self._reachable_within(graph, u, v, comp_set):\n                        return False\n\n        # (4) Maximality: no proper superset of Ci is internally mutually reachable\n        # Check that merging any two components is impossible\n        for i, ci in enumerate(components):\n            for j, cj in enumerate(components):\n                if i >= j:\n                    continue\n                merged = set(ci) | set(cj)\n                all_reach = True\n                for u in merged:\n                    for v in merged:\n                        if u != v and not self._reachable_within(graph, u, v, merged):\n                            all_reach = False\n                            break\n                    if not all_reach:\n                        break\n                if all_reach:\n                    return False  # should have been one component\n\n        return True\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> list[list[int]]:\n        return self._tarjan_scc(graph)\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n + int(graph.sum())\n\n    def _extract_components(self, state: Any) -> list[set[int]] | None:\n        if isinstance(state, dict):\n            comps = state.get(\"components\", state.get(\"sccs\"))\n            if comps is None:\n                return None\n            state = comps\n        if isinstance(state, (list, tuple)):\n            result = []\n            for comp in state:\n                if isinstance(comp, (set, frozenset)):\n                    result.append(set(int(x) for x in comp))\n                elif isinstance(comp, (list, tuple)):\n                    result.append(set(int(x) for x in comp))\n                else:\n                    result.append({int(comp)})\n            return result\n        return None\n\n    def _reachable_within(self, graph: np.ndarray, u: int, v: int, allowed: set[int]) -> bool:\n        n = graph.shape[0]\n        visited = {u}\n        stack = [u]\n        while stack:\n            x = stack.pop()\n            if x == v:\n                return True\n            for y in range(n):\n                if graph[x, y] == 1 and y in allowed and y not in visited:\n                    visited.add(y)\n                    stack.append(y)\n        return v in visited\n\n    def _tarjan_scc(self, graph: np.ndarray) -> list[list[int]]:\n        n = graph.shape[0]\n        index_counter = [0]\n        stack: list[int] = []\n        lowlink = [0] * n\n        index = [0] * n\n        on_stack = [False] * n\n        visited = [False] * n\n        result: list[list[int]] = []\n\n        def strongconnect(v: int):\n            index[v] = index_counter[0]\n            lowlink[v] = index_counter[0]\n            index_counter[0] += 1\n            stack.append(v)\n            on_stack[v] = True\n            visited[v] = True\n\n            for w in range(n):\n                if graph[v, w] == 1:\n                    if not visited[w]:\n                        strongconnect(w)\n                        lowlink[v] = min(lowlink[v], lowlink[w])\n                    elif on_stack[w]:\n                        lowlink[v] = min(lowlink[v], index[w])\n\n            if lowlink[v] == index[v]:\n                comp = []\n                while True:\n                    w = stack.pop()\n                    on_stack[w] = False\n                    comp.append(w)\n                    if w == v:\n                        break\n                result.append(comp)\n\n        for v in range(n):\n            if not visited[v]:\n                strongconnect(v)\n\n        return result\n\n\nclass Reachability(ProblemDefinition):\n    \"\"\"Reachability set from a fixed source (directed).\"\"\"\n\n    name = \"reachability\"\n    directed = True\n    needs_root = True\n    STATE_CONTRACT = (\n        \"Return a dict with 'reachable': a set or list of the vertices reachable from\\n\"\n        \"the root, including the root. Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    import collections\n    n = graph.shape[0]\n    visited = {root}\n    queue = collections.deque([root])\n    while queue:\n        u = queue.popleft()\n        for v in range(n):\n            if graph[u, v] == 1 and v not in visited:\n                visited.add(v)\n                queue.append(v)\n    return visited\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        if isinstance(state, dict):\n            return state.get(\"reachable\", state.get(\"set\", state))\n        return state\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        if root is None:\n            return False\n        maintained = self._extract_set(state)\n        if maintained is None:\n            return False\n        true_reachable = self._bfs_reachable(graph, root)\n        return maintained == true_reachable\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> set[int]:\n        return self._bfs_reachable(graph, root)\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n + int(graph.sum())\n\n    def _extract_set(self, state: Any) -> set[int] | None:\n        if isinstance(state, dict):\n            s = state.get(\"reachable\", state.get(\"set\"))\n            if s is None:\n                return None\n            state = s\n        if isinstance(state, (set, frozenset)):\n            return set(int(x) for x in state)\n        if isinstance(state, (list, tuple)):\n            return set(int(x) for x in state)\n        if isinstance(state, np.ndarray):\n            return set(int(x) for x in state)\n        return None\n\n    def _bfs_reachable(self, graph: np.ndarray, root: int) -> set[int]:\n        n = graph.shape[0]\n        visited = {root}\n        queue = deque([root])\n        while queue:\n            u = queue.popleft()\n            for v in range(n):\n                if graph[u, v] == 1 and v not in visited:\n                    visited.add(v)\n                    queue.append(v)\n        return visited\n\n\nclass DynamicLBFS(ProblemDefinition):\n    \"\"\"Lexicographic BFS ordering (undirected) - open-problem tier.\n\n    Maintaining a LexBFS ordering under arbitrary edge flips has no known\n    efficient algorithm, so this is an open tier: the candidate must keep some\n    valid LexBFS ordering of the current graph, and the verifier accepts ANY\n    valid LexBFS ordering (no tie-break, any start). Correctness is certified\n    by the (LB) 4-point property of Corneil & Krueger (2008, \"Lexicographic\n    Breadth First Search, Local Modules and the Expansion of Chordal Graph\n    Classes\", SIAM J. Discrete Math., doi 10.1137/050623498): for all\n    positions a<b<c with ac in E and ab not in E, there exists d<a with db in\n    E and dc not in E. The offline oracle is the partition-refinement LexBFS\n    of Habib, McConnell, Paul & Viennot (2000, \"Lexicographic Breadth-First\n    Search and Constant-Time Recognition of Chordal Graphs\", SIAM J.\n    Comput.), started at vertex 0 with the minimum-id tie-break.\n    \"\"\"\n\n    name = \"dynamic_lbfs\"\n    directed = False\n    needs_root = False\n    STATE_CONTRACT = (\n        \"Return a dict with 'ordering': a list of all n vertices forming a valid LexBFS\\n\"\n        \"ordering (any start vertex, any tie-break). Other keys are allowed and ignored.\")\n\n    OFFLINE_SOURCE = '''\ndef offline_compute(graph, root):\n    n = graph.shape[0]\n    start = 0\n    tiebreak = list(range(n))\n    cell = [start] + [v for v in tiebreak if v != start]\n    Pi = [cell]\n    order = []\n    while len(order) < n:\n        p = Pi[0][0]\n        order.append(p)\n        neigh = set()\n        for v in range(n):\n            if graph[p, v] == 1:\n                neigh.add(v)\n        newPi = []\n        for C in Pi:\n            C = [v for v in C if v != p]\n            if not C:\n                continue\n            a = [v for v in C if v in neigh]\n            b = [v for v in C if v not in neigh]\n            if a:\n                newPi.append(a)\n            if b:\n                newPi.append(b)\n        Pi = newPi\n    return order\n'''\n\n    @property\n    def offline_source(self) -> str:\n        return self.OFFLINE_SOURCE\n\n    def extract_result(self, state: Any) -> Any:\n        if isinstance(state, dict):\n            return state.get(\"ordering\", state.get(\"order\", state))\n        return state\n\n    def check_invariant(self, state: Any, graph: np.ndarray, root: int | None) -> bool:\n        \"\"\"Check `ordering` is a valid LexBFS ordering of `graph`.\n\n        Accepts ANY valid LexBFS ordering (no tie-break, any start). The\n        certificate is the (LB) 4-point property, checked in O(n^3) after an\n        O(n^3) precompute of the earliest separating vertex per pair.\n        \"\"\"\n        ordering = self._extract_ordering(state)\n        if ordering is None:\n            return False\n        n = graph.shape[0]\n        if len(ordering) != n:\n            return False\n        if set(ordering) != set(range(n)):\n            return False\n        return self._lb_violation(ordering, graph, n) is None\n\n    def offline_compute(self, graph: np.ndarray, root: int | None) -> list[int]:\n        n = graph.shape[0]\n        start = 0\n        tiebreak = list(range(n))\n        cell = [start] + [v for v in tiebreak if v != start]\n        Pi = [cell]\n        order = []\n        while len(order) < n:\n            p = Pi[0][0]\n            order.append(p)\n            neigh = set()\n            for v in range(n):\n                if graph[p, v] == 1:\n                    neigh.add(v)\n            newPi = []\n            for C in Pi:\n                C = [v for v in C if v != p]\n                if not C:\n                    continue\n                a = [v for v in C if v in neigh]\n                b = [v for v in C if v not in neigh]\n                if a:\n                    newPi.append(a)\n                if b:\n                    newPi.append(b)\n            Pi = newPi\n        return order\n\n    def baseline_work(self, graph: np.ndarray) -> int:\n        n = graph.shape[0]\n        return n * n  # O(n^2) partition-refinement LexBFS\n\n    def failing_context(self, state: Any, graph: np.ndarray, root: int | None) -> dict:\n        ordering = self._extract_ordering(state)\n        expected = self.offline_compute(graph, root)\n        ctx = {\n            \"problem\": self.name,\n            \"result\": str(ordering),\n            \"expected\": str(expected),\n            \"graph_shape\": list(graph.shape),\n        }\n        n = graph.shape[0]\n        if (\n            ordering is not None\n            and len(ordering) == n\n            and set(ordering) == set(range(n))\n        ):\n            violation = self._lb_violation(ordering, graph, n)\n            if violation is not None:\n                ctx[\"violation\"] = violation\n        return ctx\n\n    def _extract_ordering(self, state: Any) -> list[int] | None:\n        if isinstance(state, dict):\n            order = state.get(\"ordering\", state.get(\"order\"))\n            if order is not None:\n                return [int(x) for x in order]\n        if isinstance(state, (list, tuple)):\n            return [int(x) for x in state]\n        return None\n\n    def _lb_violation(self, ordering: list[int], graph: np.ndarray, n: int):\n        \"\"\"Return None if `ordering` satisfies (LB), else the first violation.\n\n        (LB): for all positions a<b<c with ac in E and ab not in E, there is\n        d<a with db in E and dc not in E. minD[b][c] precomputes the earliest\n        (in the ordering) such d, so the witness exists before a iff\n        minD[b][c] < pos[a].\n        \"\"\"\n        pos = {v: i for i, v in enumerate(ordering)}\n        INF = 10**9\n        minD = [[INF] * n for _ in range(n)]\n        for b in range(n):\n            for c in range(n):\n                if b == c:\n                    continue\n                best = INF\n                for d in range(n):\n                    if d != b and d != c and graph[b, d] == 1 and graph[c, d] == 0:\n                        if pos[d] < best:\n                            best = pos[d]\n                minD[b][c] = best\n        for a in range(n):\n            pa = pos[a]\n            for b in range(n):\n                pb = pos[b]\n                if pb <= pa:\n                    continue\n                for c in range(n):\n                    pc = pos[c]\n                    if pc <= pb:\n                        continue\n                    if graph[a, c] == 1 and graph[a, b] == 0:\n                        if minD[b][c] >= pa:\n                            return {\n                                \"a\": a, \"b\": b, \"c\": c,\n                                \"pos_a\": pa, \"minD\": minD[b][c],\n                            }\n        return None\n\n\n# Registry\nPROBLEMS: dict[str, type[ProblemDefinition]] = {\n    \"dynamic_bfs\": DynamicBFS,\n    \"dynamic_dfs\": DynamicDFS,\n    \"dynamic_mcs\": DynamicMCS,\n    \"dynamic_lbfs\": DynamicLBFS,\n    \"dynamic_scc\": DynamicSCC,\n    \"reachability\": Reachability,\n}\n\n\ndef get_problem(name: str) -> ProblemDefinition:\n    cls = PROBLEMS.get(name)\n    if cls is None:\n        raise ValueError(f\"Unknown problem: {name}. Available: {list(PROBLEMS.keys())}\")\n    return cls()","lineStart":1,"lineEnd":1122,"totalLines":1122,"truncated":false}},"title":"src/evoalgo/problem_definitions.py","time":{"start":1792509132140,"end":1792509132188}},"id":"prt_159debcdf001URg5x7rSFyLZrC","sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","messageID":"msg_159deb607001160PoAVCPCYdgS"}}
