{"type":"text","timestamp":1792509453296,"sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","part":{"id":"prt_159e38f07001n9vVJvLMRJgr3U","messageID":"msg_159e377720012HNrobqmBFd0RM","sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","type":"text","text":"\n\nLet me measure how often a LexBFS ordering survives a single edge flip, to decide if a \"keep-if-valid\" strategy is worth it.\n\n","time":{"start":1792509447943,"end":1792509453288}}}
{"type":"tool_use","timestamp":1792509453330,"sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a73ab234aee2fb52","state":{"status":"completed","input":{"content":"\"\"\"Measure: how often is the old LexBFS ordering still valid after one flip?\n\nUses the offline oracle (partition-refinement LexBFS) to generate orderings,\nflips one edge, and checks whether the OLD ordering is still a valid LexBFS of\nthe NEW graph (via the (LB) 4-point property). Reports survival rate and the\ncost of the (LB) check relative to a recompute.\n\"\"\"\nimport random\nimport time\n\n\ndef lexbfs(graph):\n    n = len(graph)\n    Pi = [list(range(n))]\n    order = []\n    for _ in range(n):\n        p = Pi[0][0]\n        order.append(p)\n        if len(Pi[0]) == 1:\n            Pi = Pi[1:]\n        else:\n            Pi[0] = Pi[0][1:]\n        row = graph[p]\n        newPi = []\n        for C in Pi:\n            a = [v for v in C if row[v]]\n            b = [v for v in C if not row[v]]\n            if a:\n                newPi.append(a)\n            if b:\n                newPi.append(b)\n        Pi = newPi\n    return order\n\n\ndef lb_valid(ordering, graph, n):\n    \"\"\"(LB) 4-point property: for all pos a<b<c with ac in E and ab not in E,\n    there exists d<a with db in E and dc not in E.\"\"\"\n    pos = {v: i for i, v in enumerate(ordering)}\n    INF = 10**9\n    minD = [[INF] * n for _ in range(n)]\n    for b in range(n):\n        for c in range(n):\n            if b == c:\n                continue\n            best = INF\n            for d in range(n):\n                if d != b and d != c and graph[b][d] == 1 and graph[c][d] == 0:\n                    if pos[d] < best:\n                        best = pos[d]\n            minD[b][c] = best\n    for a in range(n):\n        pa = pos[a]\n        for b in range(n):\n            pb = pos[b]\n            if pb <= pa:\n                continue\n            for c in range(n):\n                pc = pos[c]\n                if pc <= pb:\n                    continue\n                if graph[a][c] == 1 and graph[a][b] == 0:\n                    if minD[b][c] >= pa:\n                        return False\n    return True\n\n\ndef random_undirected(n, p):\n    g = [[0] * n for _ in range(n)]\n    for u in range(n):\n        for v in range(u + 1, n):\n            if random.random() < p:\n                g[u][v] = g[v][u] = 1\n    return g\n\n\ndef main():\n    random.seed(1337)\n    total = 0\n    survived = 0\n    check_ns = 0\n    recompute_ns = 0\n    N = 20000\n    for _ in range(N):\n        n = random.randint(2, 5)\n        p = random.choice([0.2, 0.4, 0.6, 0.8])\n        g = random_undirected(n, p)\n        order = lexbfs(g)\n        # pick a random edge to flip\n        pairs = [(u, v) for u in range(n) for v in range(u + 1, n)]\n        u, v = random.choice(pairs)\n        g2 = [row[:] for row in g]\n        g2[u][v] = g2[v][u] = 1 - g2[u][v]\n        total += 1\n        # does the OLD ordering remain valid on the NEW graph?\n        t0 = time.perf_counter_ns()\n        ok = lb_valid(order, g2, n)\n        t1 = time.perf_counter_ns()\n        check_ns += t1 - t0\n        if ok:\n            survived += 1\n        t0 = time.perf_counter_ns()\n        lexbfs(g2)\n        t1 = time.perf_counter_ns()\n        recompute_ns += t1 - t0\n    print(f\"flips={total} survived={survived} rate={survived/total:.3f}\")\n    print(f\"avg check_ns={check_ns/total:.0f}  avg recompute_ns={recompute_ns/total:.0f}\")\n    print(f\"check/recompute = {(check_ns/total)/(recompute_ns/total):.3f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s2/survival.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s2/survival.py","exists":false,"truncated":false},"title":"../../../proj/MPS/MPS_DEV_REPO/ethomdt/evoalgo-scratch/eval1_harness_dynamic_lbfs_s2/survival.py","time":{"start":1792509453274,"end":1792509453321}},"id":"prt_159e38f9c001XReqfCVIBnFMjJ","sessionID":"ses_ea621cf06ffe2FU6k00Dt9ASTr","messageID":"msg_159e377720012HNrobqmBFd0RM"}}
