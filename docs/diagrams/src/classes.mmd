classDiagram
    class Orchestrator {
        +init()
        +run()
        +step_generation()
        +stop()
        +resume()
    }
    class Population {
        +candidates
        +add(candidate)
        +select_parents()
        +cull()
    }
    class Candidate {
        +code_path: str
        +fitness: float
        +work_ratio: float
        +state: State
        +parent_ids
        +transition()
        +to_json()
        +from_json()
    }
    class LLMProvider {
        +generate(prompt)
        +repair(prompt)
        +reflect(prompt)
    }
    class Verifier {
        +verify(candidate) result
    }
    class Reflector {
        +reflect(candidate, failing_case)
    }
    class Evaluator {
        +score(result)
    }
    class ProblemDefinition {
        +invariant
        +oracle
        +graph_mode
        +check_invariant(output, graph)
        +baseline_work(graph)
    }
    class GraphGenerator {
        +enumerate(n) graphSet
        +sample(n, k, seed) graphSet
    }
    class Sandbox {
        +execute(candidate, inputs) result
    }
    class Checkpoint {
        +commit(generation)
        +load_latest() state
        +checksum()
    }
    class Dashboard {
        +render(generation) html
    }

    Orchestrator *-- Population
    Orchestrator *-- Verifier
    Orchestrator *-- Reflector
    Orchestrator *-- Evaluator
    Orchestrator *-- GraphGenerator
    Orchestrator *-- Sandbox
    Orchestrator *-- Checkpoint
    Orchestrator --> LLMProvider
    Orchestrator --> ProblemDefinition
    Orchestrator --> Dashboard
    Population o-- Candidate : "1..*"
    Verifier --> GraphGenerator
    Verifier --> Sandbox
    Reflector --> LLMProvider
    Candidate --> ProblemDefinition