flowchart TB
    subgraph Host["Build / research host"]
        subgraph OrchProc["Orchestrator process (user permissions)"]
            ORCH["Orchestrator<br/>evolutionary loop"]
            VER["Trusted Verifier<br/>(verifier source NOT mounted into sandbox)"]
            CHK["Checkpoint (disk)"]
        end
        subgraph SB["Sandbox: candidate execution (isolated)"]
            direction TB
            subgraph CR["Container / namespace"]
                CAND["Candidate code (Python)"]
                SCRATCH["Writable scratch mount<br/>outputs only"]
            end
            NETX["No network namespace"]
            ROX["Read-only root filesystem"]
            LIM["CPU / memory / process / output / time limits"]
        end
        DISK["results/ + run state on disk"]
    end
    LLMAPI["LLM provider API<br/>(external, networked, TLS)"] 

    ORCH -. agent prompt (HTTP, TLS) .-> LLMAPI
    LLMAPI -. candidate code back .-> SB
    ORCH -->|"spawns isolated subprocess"| SB
    VER -. "reads outputs from scratch" .-> ORCH
    ORCH -. "writes JSON + dashboards" .-> DISK

    style CAND fill:#f7e7a8,stroke:#b8860b
    style SCRATCH fill:#fff2cc,stroke:#b8860b
    style VER fill:#cfe8d6,stroke:#2e6e5e
    style NETX fill:#f3d4d4,stroke:#b03030
    style ROX fill:#f3d4d4,stroke:#b03030
    style LIM fill:#f3d4d4,stroke:#b03030
