flowchart TD
    A["For each candidate:"] --> B["Enumerate base graphs<br/>geng + directg, n <= 5"]
    B --> C["For n > 5: seeded random samples<br/>(distribution fixed, seed fixed)"]
    C --> D["For each base graph:"]
    D --> E["Generate operation sequences<br/>insertions / deletions, bounded length"]
    E --> F["Apply one edge operation"]
    F --> G["Run candidate dynamic update"]
    G --> H["Run offline recomputation"]
    H --> I["Compare via invariant checker"]
    I --> J{"Invariant holds?"}
    J -- No --> K["Record failure: graph + sequence + op<br/>state = FAIL or CRASH"]
    J -- Yes --> L["Count work (vertices, edges)<br/>vs offline; work_ratio"]
    L --> M{"More operations?"}
    M -- Yes --> F
    M -- No --> N{"More graphs?"}
    N -- Yes --> C
    N -- No --> O["Candidate verdict + efficiency<br/>fitness = pass fraction"]
    K --> N
